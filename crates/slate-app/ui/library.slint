import { Theme } from "theme.slint";
import { TrackRow, PlaylistEntry } from "types.slint";
import { ListView } from "std-widgets.slint";
import { Button, Segmented, QualityBadges, TextField, IconButton } from "widgets.slint";
import { Dnd } from "dnd.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> active;
    callback clicked();
    height: 36px;
    border-radius: 6px;
    background: root.active ? Theme.surface-raised : (ta.has-hover ? Theme.surface : transparent);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.text-muted;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.text-muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

component CoverTile inherits Rectangle {
    in property <image> source;
    in property <bool> loved;
    // Shown instead of the cover (folders).
    in property <image> icon;
    in property <length> side: 40px;
    in property <length> radius: 4px;
    width: root.side;
    height: root.side;
    border-radius: root.radius;
    clip: true;
    background: root.loved ? Theme.accent : Theme.surface-raised;
    if root.loved: Image {
        source: @image-url("icons/heart-filled.svg");
        colorize: Theme.on-accent;
        width: root.side * 0.5;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if !root.loved && root.icon.width > 0: Image {
        source: root.icon;
        colorize: Theme.text-muted;
        width: root.side * 0.5;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if !root.loved && root.icon.width == 0: Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: ImageFit.cover;
    }
}

component SmartItem inherits Rectangle {
    in property <PlaylistEntry> entry;
    in property <bool> collapsed: false;
    in property <bool> active;
    callback clicked();
    callback action(string);
    height: 36px;
    border-radius: 6px;
    background: root.active ? Theme.surface-raised : (st.has-hover ? Theme.background : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        Text { text: "✦"; color: Theme.accent; vertical-alignment: center; }
        if !root.collapsed: Text {
            text: root.entry.title;
            color: Theme.text;
            font-weight: root.active ? 700 : 500;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    st := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    ContextMenuArea {
        Menu {
            MenuItem { title: "Edit…"; activated => { root.action("edit"); } }
            MenuItem { title: "Delete"; activated => { root.action("delete"); } }
        }
    }
}

component PlaylistItem inherits Rectangle {
    in property <PlaylistEntry> entry;
    in property <bool> collapsed: false;
    in property <bool> active;
    callback clicked();
    callback action(string);
    height: 52px;
    border-radius: 6px;
    background: root.active ? Theme.surface-raised : (pt.has-hover ? Theme.background : transparent);
    HorizontalLayout {
        padding: 6px;
        spacing: 10px;
        CoverTile { source: root.entry.cover; icon: root.entry.folder ? @image-url("icons/folder.svg") : @image-url(""); }
        if !root.collapsed: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.entry.title;
                color: root.active ? Theme.text : Theme.text;
                font-weight: root.active ? 700 : 500;
                overflow: elide;
            }
            Text {
                text: root.entry.subtitle;
                color: Theme.text-muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
    DragArea {
        data: Dnd.make("pl:" + root.entry.uuid);
        allow-move: !root.entry.folder;
        enabled: !root.entry.folder;
        changed dragging => { if (self.dragging) { Dnd.cancelled = false; } }
        pt := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    }
    da := DropArea {
        can-drop(e) => {
            if (Dnd.cancelled) { return DragAction.none; }
            if (root.entry.folder) { return Dnd.kind(e.data) == "pl" ? DragAction.move : DragAction.none; }
            (Dnd.kind(e.data) == "row" || Dnd.kind(e.data) == "sugg") ? DragAction.copy : DragAction.none
        }
        dropped(e) => { Dnd.dropped(e.data, root.entry.uuid); DragAction.copy }
        Rectangle { border-width: 2px; border-color: Theme.accent; border-radius: 6px; visible: parent.has-drag; }
    }
    ContextMenuArea {
        Menu {
            MenuItem { title: "Rename…"; activated => { root.action("rename"); } }
            MenuItem { title: "Move to folder…"; enabled: !root.entry.folder; activated => { root.action("move"); } }
            MenuItem { title: "Compare with…"; enabled: !root.entry.folder; activated => { root.action("compare"); } }
            MenuItem { title: "Hide from / show on Discord"; enabled: !root.entry.folder; activated => { root.action("discord-toggle"); } }
            MenuItem { title: "Delete…"; activated => { root.action("delete"); } }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[PlaylistEntry]> playlists;
    in property <string> selected;
    in property <bool> playlists-loading;
    in property <bool> collapsed: false;
    callback go(string);
    callback open-playlist(string);
    callback new-playlist();
    in property <[PlaylistEntry]> smart-lists;
    callback new-smart();
    callback smart-action(string, string);
    callback entry-action(string, string);
    callback logout();

    background: Theme.surface;
    width: root.collapsed ? 64px : 248px;
    animate width { duration: 120ms; }

    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text {
            text: root.collapsed ? "S" : "Slate";
            font-size: 22px;
            font-weight: 800;
            color: Theme.accent;
            height: 44px;
            vertical-alignment: center;
            horizontal-alignment: root.collapsed ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
        }
        for item in [
            { id: "home", glyph: "⌂", label: "Home" },
            { id: "albums", glyph: "◉", label: "Albums" },
            { id: "artists", glyph: "♫", label: "Artists" },
            { id: "mixes", glyph: "✦", label: "Mixes" },
            { id: "explore", glyph: "◈", label: "Explore" },
            { id: "profile", glyph: "☺", label: "Profile" },
        ]: NavItem {
            label: root.collapsed ? item.glyph : item.glyph + "   " + item.label;
            active: root.selected == item.id;
            clicked => { root.go(item.id); }
        }
        HorizontalLayout {
            height: 28px;
            DropArea {
                can-drop(e) => { (Dnd.kind(e.data) == "pl" && !Dnd.cancelled) ? DragAction.move : DragAction.none }
                dropped(e) => { Dnd.dropped(e.data, "root"); DragAction.move }
            }
            if !root.collapsed: Text {
                text: "PLAYLISTS";
                font-size: 11px;
                color: Theme.text-muted;
                vertical-alignment: bottom;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 24px;
                Text { text: "＋"; color: np.has-hover ? Theme.accent : Theme.text-muted; horizontal-alignment: center; vertical-alignment: bottom; }
                np := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.new-playlist(); } }
            }
        }
        Rectangle {
            height: 52px;
            border-radius: 6px;
            background: root.selected == "loved" ? Theme.surface-raised : (lt.has-hover ? Theme.background : transparent);
            HorizontalLayout {
                padding: 6px;
                spacing: 10px;
                CoverTile { loved: true; }
                if !root.collapsed: Text {
                    text: "Loved Tracks";
                    color: Theme.text;
                    font-weight: root.selected == "loved" ? 700 : 500;
                    vertical-alignment: center;
                }
            }
            lt := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.go("loved"); } }
        }
        HorizontalLayout {
            height: 28px;
            if !root.collapsed: Text { text: "SMART"; font-size: 11px; color: Theme.text-muted; vertical-alignment: bottom; horizontal-stretch: 1; }
            Rectangle {
                width: 24px;
                Text { text: "＋"; color: ns.has-hover ? Theme.accent : Theme.text-muted; horizontal-alignment: center; vertical-alignment: bottom; }
                ns := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.new-smart(); } }
            }
        }
        for s in root.smart-lists: SmartItem {
            entry: s;
            collapsed: root.collapsed;
            active: root.selected == s.uuid;
            clicked => { root.open-playlist(s.uuid); }
            action(a) => { root.smart-action(s.uuid, a); }
        }
        if root.playlists-loading && !root.collapsed: Text { text: "Loading…"; color: Theme.text-muted; height: 28px; }
        ListView {
            vertical-stretch: 1;
            for p in root.playlists: PlaylistItem {
                entry: p;
                collapsed: root.collapsed;
                active: root.selected == p.uuid;
                clicked => { root.open-playlist(p.uuid); }
                action(a) => { root.entry-action(p.uuid, a); }
            }
        }
        NavItem {
            label: root.collapsed ? "⚙" : "⚙   Settings";
            active: root.selected == "settings";
            clicked => { root.go("settings"); }
        }
        NavItem {
            label: root.collapsed ? "⏻" : "⏻   Sign out";
            clicked => { root.logout(); }
        }
    }
}

component Row inherits Rectangle {
    in property <TrackRow> item;
    in property <int> index;
    in property <bool> playing;
    in property <bool> show-album: true;
    in property <bool> show-artist: true;
    in property <bool> show-quality: true;
    /// A suggested track: no playlist edits, and a + button.
    in property <bool> suggestion: false;
    /// Rows of an owned playlist in its own order accept other rows dropped on them.
    in property <bool> reorder-target: false;
    callback add();
    in property <length> quality-w;
    in property <length> title-w;
    in property <length> artist-w;
    in property <length> album-w;
    callback play();
    callback action(string);
    height: 48px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.surface : transparent;

    DragArea {
        data: Dnd.make((root.suggestion ? "sugg:" : "row:") + root.index);
        allow-copy: true;
        allow-move: !root.suggestion;
        changed dragging => { if (self.dragging) { Dnd.cancelled = false; } }
        ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            // One click plays, as people expect from a track list.
            clicked => { root.play(); }
        }
    }
    DropArea {
        enabled: root.reorder-target && !root.suggestion;
        can-drop(e) => { (Dnd.kind(e.data) == "row" && !Dnd.cancelled) ? DragAction.move : DragAction.none }
        dropped(e) => { Dnd.dropped(e.data, "row:" + root.index); DragAction.move }
        Rectangle { y: 0; height: 2px; background: Theme.accent; visible: parent.has-drag; }
    }
    ContextMenuArea {
        Menu {
            MenuItem { title: "Play"; activated => { root.play(); } }
            MenuItem { title: root.item.favorite ? "Remove from Loved Tracks" : "Add to Loved Tracks"; activated => { root.action("favorite"); } }
            MenuItem { title: "Add to playlist…"; enabled: !root.suggestion; activated => { root.action("add-to-playlist"); } }
            MenuItem { title: "Remove from this playlist"; enabled: !root.suggestion; activated => { root.action("remove-from-playlist"); } }
            MenuItem { title: "Play next"; activated => { root.action("play-next"); } }
            MenuItem { title: "Add to queue"; activated => { root.action("queue"); } }
            MenuItem { title: "Go to album"; activated => { root.action("album"); } }
            MenuItem { title: "Go to artist"; activated => { root.action("artist"); } }
            MenuItem { title: "Other versions…"; activated => { root.action("versions"); } }
            MenuItem { title: "Credits"; activated => { root.action("credits"); } }
            MenuItem { title: "Copy TIDAL link"; activated => { root.action("copy-link"); } }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        // index, or a play button on hover
        Rectangle {
            width: 28px;
            Text {
                visible: !ta.has-hover;
                text: root.playing ? "▶" : (root.index + 1);
                color: root.playing ? Theme.accent : Theme.text-muted;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
            Text {
                visible: ta.has-hover;
                text: "▶";
                color: Theme.text;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
        HorizontalLayout {
            width: root.title-w;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                CoverTile { source: root.item.cover; side: 34px; radius: 3px; }
            }
            Text {
                text: root.item.title;
                color: root.playing ? Theme.accent : Theme.text;
                vertical-alignment: center;
                overflow: elide;
                // Only as wide as the title (the spacer takes the rest), so
                // the "E" sits right after it; still elides when too narrow.
                max-width: self.preferred-width;
                min-width: 0px;
            }
            if root.item.explicit: Text {
                text: "E";
                font-size: 10px;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.show-quality: Rectangle {
            // Its own fixed-width column, so the badges line up from row to
            // row and never overlap the title or the artist.
            width: root.quality-w;
            if root.item.quality > 0 || root.item.atmos: QualityBadges {
                x: 0;
                y: (parent.height - 16px) / 2;
                height: 16px;
                tier: root.item.quality;
                atmos: root.item.atmos;
                long-atmos: false;
            }
        }
        if root.show-artist: Rectangle {
            // Fixed width from the page: stretch factors add to each cell's own
            // text width, so columns would drift from row to row.
            width: root.artist-w;
            Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.item.artist;
                color: Theme.text-muted;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.show-album: Rectangle {
            // Fixed width from the page: stretch factors add to each cell's own
            // text width, so columns would drift from row to row.
            width: root.album-w;
            Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.item.album;
                color: Theme.text-muted;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Rectangle {
            width: 24px;
            Text {
                text: root.item.favorite ? "♥" : "♡";
                color: root.item.favorite ? Theme.accent : Theme.text-muted;
                visible: root.item.favorite || ta.has-hover;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.action("favorite"); } }
        }
        Text {
            width: 52px;
            text: root.item.duration;
            color: Theme.text-muted;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        if root.suggestion: Rectangle {
            width: 28px;
            Text { text: "＋"; color: sa.has-hover ? Theme.accent : Theme.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
            sa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.add(); } }
        }
    }
}

export component TrackPage inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> loading;
    in property <[TrackRow]> tracks;
    in property <string> playing-id;
    in property <bool> has-page;
    in property <image> cover;
    in property <bool> loved;
    in property <string> kind-label: "PLAYLIST";
    in property <bool> can-favorite: false;
    in property <bool> can-export: false;
    /// Album quality badges: 0 none, 1 Lossless, 2 Hi-Res.
    in property <int> quality;
    in property <bool> atmos;
    callback export-list(string);
    in property <int> filter-request: 0;
    in-out property <bool> filter-open: false;
    in-out property <string> filter-text;
    in-out property <int> filter-quality: 0;
    in property <string> filter-status;
    callback filter-changed(string, int);
    property <int> filter-focus: 0;
    changed filter-request => {
        if (root.has-page) { root.filter-open = true; root.filter-focus += 1; }
    }
    function close-filter() {
        root.filter-open = false;
        root.filter-text = "";
        root.filter-changed("", root.filter-quality);
    }
    in property <bool> can-reorder: false;
    in property <bool> can-dedupe: false;
    callback remove-duplicates();
    callback show-album-versions();
    in property <[TrackRow]> suggestions;
    in property <bool> suggest-visible: false;
    in property <string> suggest-status;
    callback suggest-load(string);
    callback suggest-add(int);
    callback suggest-play(int);
    callback suggest-action(int, string);
    in property <bool> can-save-smart: false;
    callback save-smart-snapshot();
    in property <bool> page-favorite: false;
    callback toggle-page-favorite();
    in property <bool> sort-visible;
    in property <string> sort-label;
    in property <bool> sort-desc;
    callback cycle-sort();
    callback flip-sort();
    in property <bool> loved-tabs;
    in property <int> loved-tab;
    callback loved-tab-picked(int);
    property <bool> show-artist: root.width > 520px;
    property <bool> show-album: root.width > 760px;
    property <bool> show-quality: root.width > 640px;
    // Hi-Res/Lossless plus Atmos side by side.
    property <length> quality-w: 110px;
    // Column layout shared by the header and every row (padding 12, spacing 12,
    // index 28 + heart 24 + time 52 + quality fixed; title:artist:album = 3:2:2).
    property <int> cols: 4 + (root.show-artist ? 1 : 0) + (root.show-album ? 1 : 0) + (root.show-quality ? 1 : 0);
    property <length> flex: max(0px, root.width - (root.compact ? 24px : 48px) - 24px - 104px - (root.show-quality ? root.quality-w : 0px) - 12px * (root.cols - 1) - 14px);
    property <length> share: root.flex / (3 + (root.show-artist ? 2 : 0) + (root.show-album ? 2 : 0));
    in property <bool> compact: false;
    callback row-action(int, string);
    callback play-row(int);
    callback play-all();
    callback shuffle-all();

    background: Theme.background;

    if !root.has-page: Text {
        text: "Pick Loved Tracks or a playlist from the sidebar";
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.has-page: VerticalLayout {
        padding: root.compact ? 12px : 24px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 20px;
            CoverTile { source: root.cover; loved: root.loved; side: root.compact ? 96px : 160px; radius: 8px; }
            VerticalLayout {
                alignment: end;
                spacing: 4px;
                Text { text: root.kind-label; font-size: 11px; color: Theme.text-muted; }
                Text { text: root.title; font-size: 36px; font-weight: 800; color: Theme.text; overflow: elide; }
                Text { text: root.loading ? "Loading…" : root.subtitle; color: Theme.text-muted; }
                if root.quality > 0 || root.atmos: QualityBadges { tier: root.quality; atmos: root.atmos; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button { label: "▶  Play"; primary: true; clicked => { root.play-all(); } }
            Button { label: "🔀  Shuffle"; clicked => { root.shuffle-all(); } }
            if root.can-favorite: Button { label: root.page-favorite ? "♥  Saved" : "♡  Save"; clicked => { root.toggle-page-favorite(); } }
            if root.can-export: export-button := Button {
                label: "Export…";
                clicked => { export-menu.show({ x: export-button.absolute-position.x, y: export-button.absolute-position.y + export-button.height }); }
                export-menu := ContextMenuArea {
                    Menu {
                        MenuItem { title: "Export as CSV…"; activated => { root.export-list("csv"); } }
                        MenuItem { title: "Export as M3U playlist…"; activated => { root.export-list("m3u"); } }
                    }
                }
            }
            if root.kind-label == "ALBUM": Button { label: "Other versions"; clicked => { root.show-album-versions(); } }
            if root.can-save-smart: Button { label: "Save as TIDAL playlist"; clicked => { root.save-smart-snapshot(); } }
            if root.can-dedupe: Button { label: "Remove duplicates…"; clicked => { root.remove-duplicates(); } }
            if root.sort-visible: Button { label: "⇅  " + root.sort-label; clicked => { root.cycle-sort(); } }
            if root.sort-visible: Button { label: root.sort-desc ? "↓" : "↑"; clicked => { root.flip-sort(); } }
            if root.loved-tabs: Segmented { options: ["Tracks", "Videos"]; index: root.loved-tab; picked(i) => { root.loved-tab-picked(i); } }
        }
        FocusScope {
            height: 34px;
            key-pressed(e) => {
                if (e.text == Key.Escape && root.filter-open) { root.close-filter(); return accept; }
                reject
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.filter-open: TextField {
                    text <=> root.filter-text;
                    placeholder: "Filter this list…";
                    field-width: 240px;
                    focus-request: root.filter-focus;
                    edited(t) => { root.filter-changed(t, root.filter-quality); }
                }
                Segmented {
                    options: ["All", "Lossless", "Hi-Res", "Atmos"];
                    index: root.filter-quality;
                    picked(i) => { root.filter-quality = i; root.filter-changed(root.filter-text, i); }
                }
                if root.filter-status != "": Text { text: root.filter-status; color: Theme.text-muted; vertical-alignment: center; }
                if root.filter-open: IconButton { icon: @image-url("icons/close.svg"); side: 28px; clicked => { root.close-filter(); } }
            }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            height: 24px;
            Text { width: 28px; text: "#"; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
            HorizontalLayout {
                width: 3 * root.share;
                spacing: 10px;
                // same offset as the cover thumbnail in each row
                Rectangle { width: 34px; }
                Text { text: "TITLE"; color: Theme.text-muted; font-size: 11px; horizontal-alignment: left; vertical-alignment: center; }
            }
            if root.show-quality: Rectangle {
                width: root.quality-w;
                Text { x: 0; width: parent.width; height: parent.height; text: "QUALITY"; color: Theme.text-muted; font-size: 11px; horizontal-alignment: left; vertical-alignment: center; }
            }
            if root.show-artist: Rectangle {
                width: 2 * root.share;
                Text { x: 0; width: parent.width; height: parent.height; text: "ARTIST"; color: Theme.text-muted; font-size: 11px; horizontal-alignment: left; vertical-alignment: center; }
            }
            if root.show-album: Rectangle {
                width: 2 * root.share;
                Text { x: 0; width: parent.width; height: parent.height; text: "ALBUM"; color: Theme.text-muted; font-size: 11px; horizontal-alignment: left; vertical-alignment: center; }
            }
            Rectangle { width: 24px; }
            Text { width: 52px; text: "TIME"; color: Theme.text-muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
        }
        lv := ListView {
            vertical-stretch: 1;
            property <bool> user-scrolled: false;
            property <bool> at-bottom: self.content-y <= -(self.content-height - self.visible-height - 24px);
            changed content-y => {
                if (self.content-y < -4px) { self.user-scrolled = true; }
            }
            changed at-bottom => {
                // Only after the user has scrolled: opening a page never asks for suggestions.
                if (self.at-bottom && self.user-scrolled && root.suggest-visible) { root.suggest-load("first"); }
            }
            for r[i] in root.tracks: Row {
                item: r;
                index: i;
                playing: r.id != "" && r.id == root.playing-id;
                show-artist: root.show-artist;
                show-album: root.show-album;
                show-quality: root.show-quality;
                quality-w: root.quality-w;
                title-w: 3 * root.share;
                artist-w: 2 * root.share;
                album-w: 2 * root.share;
                reorder-target: root.can-reorder;
                play => { root.play-row(i); }
                action(a) => { root.row-action(i, a); }
            }
        }
        if root.suggest-visible: Rectangle {
            height: root.suggestions.length > 0 ? 292px : 48px;
            VerticalLayout {
                HorizontalLayout {
                    height: 48px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    Text { text: "Suggested tracks"; font-size: 16px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                    Text { text: root.suggest-status; color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            if root.suggestions.length == 0: Button { label: "Show suggestions"; clicked => { root.suggest-load("first"); } }
                            if root.suggestions.length > 0: Button { label: "Refresh"; clicked => { root.suggest-load("refresh"); } }
                            if root.suggestions.length > 0: Button { label: "Show more"; clicked => { root.suggest-load("more"); } }
                        }
                    }
                }
                if root.suggestions.length > 0: ListView {
                    height: 244px;
                    for s[j] in root.suggestions: Row {
                        item: s;
                        index: j;
                        suggestion: true;
                        playing: s.id != "" && s.id == root.playing-id;
                        show-artist: root.show-artist;
                        show-album: root.show-album;
                        show-quality: root.show-quality;
                        quality-w: root.quality-w;
                        title-w: 3 * root.share;
                        artist-w: 2 * root.share;
                        album-w: 2 * root.share;
                        play => { root.suggest-play(j); }
                        add => { root.suggest-add(j); }
                        action(a) => { root.suggest-action(j, a); }
                    }
                }
            }
        }
    }
}
