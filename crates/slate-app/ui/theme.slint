// Global theme. Rust derives every colour from the chosen accent and background
// (`slate-core::theme::derive`) and writes them here; the defaults below are
// the Violet Night preset so the first frame is already correct.
export global Theme {
    in-out property <bool> dark: true;
    in-out property <color> accent: #A855F7;
    in-out property <color> accent-hover: #9333EA;
    in-out property <color> on-accent: #000000;
    in-out property <color> background: #130F1A;
    in-out property <color> surface: #1D1727;
    in-out property <color> surface-raised: #2E2440;
    in-out property <color> text: #ffffff;
    in-out property <color> text-muted: #a6a6a6;
    in-out property <color> danger: #ff6666;
}

/// Design scale shared by the components: spacing, radii and text sizes (one place to change).
export global Metrics {
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 24px;
    out property <length> space-6: 32px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> text-display: 36px;
    out property <length> text-title: 20px;
    out property <length> text-subtitle: 15px;
    out property <length> text-body: 13px;
    out property <length> text-caption: 11px;
}
