import { Theme } from "theme.slint";
import { LoginScreen } from "login.slint";
import { PlayerBar } from "player_bar.slint";
import { Sidebar, TrackPage } from "library.slint";
import { CardsPage, QueuePanel, LyricsPanel } from "pages.slint";
import { FullscreenPlayer } from "fullscreen.slint";
import { MiniPlayerWindow } from "mini.slint";
import { VideoView } from "video.slint";
import { SettingsPage, SettingsState } from "settings.slint";
import { ProfilePage, ProfileState } from "profile.slint";
import { IconButton, TextField, Button } from "widgets.slint";
import { ListView } from "std-widgets.slint";
import { TrackRow, PlaylistEntry, CardItem, CardSection, QueueRow, LyricLine, PresetTile, KeyValue } from "types.slint";
export { MiniPlayerWindow, TrackRow, PlaylistEntry, CardItem, CardSection, QueueRow, LyricLine, PresetTile, KeyValue, SettingsState, ProfileState, Theme }

export enum Screen { loading, login, main }

export component AppWindow inherits Window {
    title: "Slate";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 360px;
    min-height: 420px;
    background: Theme.background;
    full-screen: root.fullscreen;

    in property <Screen> screen: Screen.loading;

    // Breakpoints: below 900px the sidebar collapses to icons, below 600px the
    // player bar stacks its controls.
    property <bool> narrow: self.width < 900px;
    property <bool> compact: self.width < 600px;
    property <int> focus-tick: 0;
    // Playlist picker: -1 = just create, -2 = current track, >=0 = list row.
    in-out property <bool> fullscreen: false;
    in-out property <bool> video-open: false;
    in property <image> video-frame;
    in property <string> video-title;
    in property <bool> video-playing;
    in property <float> video-progress;
    in property <string> video-position-text: "0:00";
    in property <string> video-duration-text: "0:00";
    in property <string> video-status;
    callback video-toggle();
    callback video-seek(float);
    callback video-close();
    in-out property <bool> sp-open: false;
    in property <bool> sp-pristine;
    in property <string> sp-headline;
    in property <[KeyValue]> sp-rows;
    callback open-signal-path();
    callback open-miniplayer();
    // Generic dialog: kind = rename | delete | move; target = playlist uuid or "folder:ID".
    in-out property <bool> dialog-open: false;
    in-out property <string> dialog-kind;
    in-out property <string> dialog-target;
    in-out property <string> dialog-text;
    in-out property <bool> picker-open: false;
    in-out property <int> picker-target: -1;
    in-out property <string> picker-name;
    in-out property <string> folder-name;

    // ---- login ----
    in property <string> login-code;
    in property <string> login-url;
    in property <image> login-qr;
    in property <string> login-status;
    in property <bool> login-busy;
    in property <bool> login-has-code;
    callback start-login();
    callback open-login-url();

    // ---- navigation ----
    in property <string> view: "tracks";   // tracks | cards | settings
    in property <string> selected-source;
    in property <bool> can-back;
    in property <bool> can-forward;
    in-out property <string> search-text;
    callback back();
    callback forward();
    callback go(string);
    callback open-playlist(string);
    callback open-card(string, string);
    callback play-card(string, string);
    callback search(string);
    callback logout();

    // ---- sidebar ----
    in property <[PlaylistEntry]> playlists;
    in property <bool> playlists-loading;

    // ---- track pages ----
    in property <bool> has-page;
    in property <string> page-kind: "PLAYLIST";
    in property <string> page-title;
    in property <string> page-subtitle;
    in property <image> page-cover;
    in property <bool> page-loved;
    in property <bool> page-loading;
    in property <[TrackRow]> tracks;
    in property <string> playing-id;
    in property <bool> can-favorite;
    in property <bool> page-favorite;
    in property <bool> hero-favorite;
    in property <bool> track-favorite;
    callback toggle-page-favorite();
    callback toggle-hero-favorite();
    callback toggle-favorite();
    callback dialog-accepted(string, string, string);
    callback add-to-playlist(int, string);
    callback create-playlist(int, string);
    callback create-folder(string);
    callback play-row(int);
    callback row-action(int, string);
    callback play-all();
    callback shuffle-all();

    // ---- card pages ----
    in property <string> cards-title;
    in property <string> cards-subtitle;
    in property <bool> cards-loading;
    in property <[CardSection]> sections;
    in property <bool> has-hero;
    in property <image> hero-image;
    in property <string> hero-label;
    callback hero-play();
    callback hero-shuffle();

    // ---- right-hand panels ----
    in-out property <string> panel;  // "" | queue | lyrics
    in property <[QueueRow]> queue-rows;
    in property <[LyricLine]> lyric-lines;
    in property <string> lyrics-status;
    in property <bool> lyrics-synced;
    in property <int> lyric-current: -1;
    callback queue-play(int);
    callback queue-remove(int);
    callback queue-clear();
    callback lyric-seek(int);

    // ---- playback ----
    in property <string> track-title;
    in property <string> track-artist;
    in property <image> track-cover;
    in property <bool> playing;
    in property <bool> has-track;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress;
    in property <float> volume: 1;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <string> error;
    in property <string> notice;
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-play();
    callback toggle-mute();
    callback seek(float);
    callback set-volume(float);
    callback seek-relative(float);

    // Global shortcuts (ignored while a text field has focus, since fields consume keys).
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == " ") { root.toggle-play(); return accept; }
            if (e.modifiers.control && e.text == Key.RightArrow) { root.next(); return accept; }
            if (e.modifiers.control && e.text == Key.LeftArrow) { root.previous(); return accept; }
            if (e.text == Key.RightArrow) { root.seek-relative(5); return accept; }
            if (e.text == Key.LeftArrow) { root.seek-relative(-5); return accept; }
            if (e.text == Key.Escape && root.fullscreen) { root.fullscreen = false; return accept; }
            if (e.text == "f") { root.fullscreen = !root.fullscreen; return accept; }
            if (e.text == "m") { root.toggle-mute(); return accept; }
            if (e.text == "s") { root.toggle-shuffle(); return accept; }
            if (e.text == "r") { root.cycle-repeat(); return accept; }
            if (e.text == "q") { root.panel = root.panel == "queue" ? "" : "queue"; return accept; }
            if (e.text == "l") { root.panel = root.panel == "lyrics" ? "" : "lyrics"; return accept; }
            if (e.text == "/") { root.focus-tick += 1; return accept; }
            reject
        }

        if root.screen == Screen.loading: Text {
            text: "Starting…";
            color: Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.screen == Screen.login: LoginScreen {
            user-code: root.login-code;
            verification-url: root.login-url;
            qr: root.login-qr;
            status: root.login-status;
            busy: root.login-busy;
            has-code: root.login-has-code;
            start => { root.start-login(); }
            open-url => { root.open-login-url(); }
        }

        if root.screen == Screen.main: VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;
                Sidebar {
                    playlists: root.playlists;
                    playlists-loading: root.playlists-loading;
                    selected: root.selected-source;
                    collapsed: root.narrow;
                    go(id) => { root.go(id); }
                    open-playlist(id) => { root.open-playlist(id); }
                    entry-action(id, a) => {
                        if (a == "delete") { root.dialog-kind = "delete"; root.dialog-target = id; root.dialog-open = true; }
                        else if (a == "rename") { root.dialog-kind = "rename"; root.dialog-target = id; root.dialog-text = ""; root.dialog-open = true; }
                        else if (a == "move") { root.dialog-kind = "move"; root.dialog-target = id; root.dialog-open = true; }
                    }
                    new-playlist => { root.picker-target = -1; root.picker-open = true; }
                    logout => { root.logout(); }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    // top bar: history + search
                    Rectangle {
                        height: 52px;
                        background: Theme.background;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                IconButton { glyph: "‹"; enabled: root.can-back; clicked => { root.back(); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton { glyph: "›"; enabled: root.can-forward; clicked => { root.forward(); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextField {
                                    focus-request: root.focus-tick;
                                    text <=> root.search-text;
                                    placeholder: "Search tracks, albums, artists…   ( / )";
                                    field-width: min(420px, root.width * 0.5);
                                    accepted(t) => { root.search(t); }
                                }
                            }
                        }
                    }
                    if root.notice != "": Rectangle {
                        height: 28px;
                        background: Theme.accent;
                        Text { text: root.notice; color: Theme.on-accent; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.error != "": Rectangle {
                        height: 32px;
                        background: Theme.danger;
                        Text { text: root.error; color: Theme.on-accent; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.view == "tracks": TrackPage {
                        vertical-stretch: 1;
                        compact: root.compact;
                        has-page: root.has-page;
                        kind-label: root.page-kind;
                        title: root.page-title;
                        subtitle: root.page-subtitle;
                        cover: root.page-cover;
                        loved: root.page-loved;
                        loading: root.page-loading;
                        tracks: root.tracks;
                        playing-id: root.playing-id;
                        play-row(i) => { root.play-row(i); }
                        can-favorite: root.can-favorite;
                        page-favorite: root.page-favorite;
                        toggle-page-favorite => { root.toggle-page-favorite(); }
                        row-action(i, a) => {
                            if (a == "add-to-playlist") { root.picker-target = i; root.picker-open = true; }
                            else { root.row-action(i, a); }
                        }
                        play-all => { root.play-all(); }
                        shuffle-all => { root.shuffle-all(); }
                    }
                    if root.view == "cards": CardsPage {
                        vertical-stretch: 1;
                        compact: root.compact;
                        title: root.cards-title;
                        subtitle: root.cards-subtitle;
                        loading: root.cards-loading;
                        sections: root.sections;
                        has-hero: root.has-hero;
                        hero-image: root.hero-image;
                        hero-label: root.hero-label;
                        open(k, id) => { root.open-card(k, id); }
                        play(k, id) => { root.play-card(k, id); }
                        hero-favorite: root.hero-favorite;
                        toggle-hero-favorite => { root.toggle-hero-favorite(); }
                        hero-play => { root.hero-play(); }
                        hero-shuffle => { root.hero-shuffle(); }
                    }
                    if root.view == "profile": ProfilePage {
                        vertical-stretch: 1;
                        compact: root.compact;
                    }
                    if root.view == "settings": SettingsPage {
                        vertical-stretch: 1;
                        compact: root.compact;
                    }
                }
                if root.panel == "queue" && !root.compact: QueuePanel {
                    width: 320px;
                    rows: root.queue-rows;
                    now-title: root.track-title;
                    now-artist: root.track-artist;
                    play(i) => { root.queue-play(i); }
                    remove(i) => { root.queue-remove(i); }
                    clear => { root.queue-clear(); }
                    close => { root.panel = ""; }
                }
                if root.panel == "lyrics" && !root.compact: LyricsPanel {
                    width: 360px;
                    lines: root.lyric-lines;
                    status: root.lyrics-status;
                    synced: root.lyrics-synced;
                    current: root.lyric-current;
                    seek(i) => { root.lyric-seek(i); }
                    close => { root.panel = ""; }
                }
            }
            PlayerBar {
                // The three-column bar needs ~1250px; below that the stacked layout is used.
                compact: root.width < 1250px;
                title: root.track-title;
                artist: root.track-artist;
                cover: root.track-cover;
                playing: root.playing;
                has-track: root.has-track;
                position-text: root.position-text;
                duration-text: root.duration-text;
                progress: root.progress;
                volume: root.volume;
                shuffle: root.shuffle;
                repeat: root.repeat;
                favorite: root.track-favorite;
                queue-open: root.panel == "queue";
                toggle-favorite => { root.toggle-favorite(); }
                add-to-playlist => { root.picker-target = -2; root.picker-open = true; }
                lyrics-open: root.panel == "lyrics";
                next => { root.next(); }
                previous => { root.previous(); }
                toggle-shuffle => { root.toggle-shuffle(); }
                cycle-repeat => { root.cycle-repeat(); }
                toggle-play => { root.toggle-play(); }
                toggle-mute => { root.toggle-mute(); }
                seek(f) => { root.seek(f); }
                set-volume(v) => { root.set-volume(v); }
                open-signal-path => { root.open-signal-path(); }
                open-miniplayer => { root.open-miniplayer(); }
                toggle-fullscreen => { root.fullscreen = true; }
                toggle-queue => { root.panel = root.panel == "queue" ? "" : "queue"; }
                toggle-lyrics => { root.panel = root.panel == "lyrics" ? "" : "lyrics"; }
            }
        }

        if root.fullscreen && root.screen == Screen.main: FullscreenPlayer {
            compact: root.compact;
            title: root.track-title;
            artist: root.track-artist;
            cover: root.track-cover;
            playing: root.playing;
            has-track: root.has-track;
            position-text: root.position-text;
            duration-text: root.duration-text;
            progress: root.progress;
            shuffle: root.shuffle;
            repeat: root.repeat;
            favorite: root.track-favorite;
            lyric-lines: root.lyric-lines;
            lyrics-synced: root.lyrics-synced;
            lyric-current: root.lyric-current;
            lyrics-status: root.lyrics-status;
            close => { root.fullscreen = false; }
            toggle-play => { root.toggle-play(); }
            next => { root.next(); }
            previous => { root.previous(); }
            toggle-shuffle => { root.toggle-shuffle(); }
            cycle-repeat => { root.cycle-repeat(); }
            toggle-favorite => { root.toggle-favorite(); }
            seek(f) => { root.seek(f); }
            lyric-seek(i) => { root.lyric-seek(i); }
        }

        if root.picker-open: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.picker-open = false; } }
            Rectangle {
                width: min(420px, parent.width - 32px);
                height: min(520px, parent.height - 48px);
                border-radius: 12px;
                background: Theme.surface;
                TouchArea { }
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: root.picker-target == -1 ? "New playlist or folder" : "Add to playlist"; font-size: 18px; font-weight: 700; color: Theme.text; horizontal-stretch: 1; }
                        IconButton { glyph: "✕"; side: 28px; clicked => { root.picker-open = false; } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        TextField {
                            text <=> root.picker-name;
                            placeholder: "New playlist name";
                            field-width: 260px;
                            accepted(t) => { root.create-playlist(root.picker-target, t); root.picker-name = ""; root.picker-open = false; }
                        }
                        Button {
                            label: "Create";
                            primary: true;
                            enabled: root.picker-name != "";
                            clicked => { root.create-playlist(root.picker-target, root.picker-name); root.picker-name = ""; root.picker-open = false; }
                        }
                    }
                    if root.picker-target == -1: HorizontalLayout {
                        spacing: 8px;
                        TextField {
                            text <=> root.folder-name;
                            placeholder: "New folder name";
                            field-width: 260px;
                        }
                        Button {
                            label: "Create";
                            enabled: root.folder-name != "";
                            clicked => { root.create-folder(root.folder-name); root.folder-name = ""; root.picker-open = false; }
                        }
                    }
                    if root.picker-target != -1: Text { text: "OR PICK ONE"; font-size: 11px; color: Theme.text-muted; }
                    if root.picker-target != -1: ListView {
                        vertical-stretch: 1;
                        for p in root.playlists: Rectangle {
                            height: 40px;
                            visible: !p.folder;
                            border-radius: 6px;
                            background: pk.has-hover ? Theme.surface-raised : transparent;
                            Text { x: 10px; text: p.title; color: Theme.text; vertical-alignment: center; overflow: elide; width: parent.width - 20px; }
                            pk := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.add-to-playlist(root.picker-target, p.uuid); root.picker-open = false; }
                            }
                        }
                    }
                }
            }
        }

        if root.dialog-open: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.dialog-open = false; } }
            Rectangle {
                width: min(400px, parent.width - 32px);
                height: root.dialog-kind == "move" ? min(420px, parent.height - 48px) : 190px;
                border-radius: 12px;
                background: Theme.surface;
                TouchArea { }
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: root.dialog-kind == "rename" ? "Rename" : root.dialog-kind == "delete" ? "Delete this?" : "Move to folder";
                        font-size: 18px; font-weight: 700; color: Theme.text;
                    }
                    if root.dialog-kind == "delete": Text {
                        text: "This cannot be undone.";
                        color: Theme.text-muted;
                    }
                    if root.dialog-kind == "rename": TextField {
                        text <=> root.dialog-text;
                        placeholder: "New name";
                        field-width: 340px;
                        accepted(t) => { root.dialog-accepted("rename", root.dialog-target, t); root.dialog-open = false; }
                    }
                    if root.dialog-kind == "move": Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                        Rectangle {
                            height: 40px;
                            border-radius: 6px;
                            background: mr.has-hover ? Theme.surface-raised : transparent;
                            Text { x: 10px; text: "Top level (no folder)"; color: Theme.text; vertical-alignment: center; }
                            mr := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.dialog-accepted("move", root.dialog-target, "root"); root.dialog-open = false; } }
                        }
                        for p in root.playlists: Rectangle {
                            height: p.folder ? 40px : 0px;
                            visible: p.folder;
                            border-radius: 6px;
                            background: mf.has-hover ? Theme.surface-raised : transparent;
                            Text { x: 10px; text: "📁  " + p.title; color: Theme.text; vertical-alignment: center; }
                            mf := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.dialog-accepted("move", root.dialog-target, p.uuid); root.dialog-open = false; } }
                        }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button { label: "Cancel"; clicked => { root.dialog-open = false; } }
                        if root.dialog-kind == "rename": Button { label: "Rename"; primary: true; enabled: root.dialog-text != ""; clicked => { root.dialog-accepted("rename", root.dialog-target, root.dialog-text); root.dialog-open = false; } }
                        if root.dialog-kind == "delete": Button { label: "Delete"; danger: true; clicked => { root.dialog-accepted("delete", root.dialog-target, ""); root.dialog-open = false; } }
                    }
                }
            }
        }


        if root.video-open: VideoView {
            frame: root.video-frame;
            title: root.video-title;
            playing: root.video-playing;
            progress: root.video-progress;
            position-text: root.video-position-text;
            duration-text: root.video-duration-text;
            status: root.video-status;
            toggle => { root.video-toggle(); }
            seek(f) => { root.video-seek(f); }
            close => { root.video-open = false; root.video-close(); }
        }

        if root.sp-open: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.sp-open = false; } }
            Rectangle {
                width: min(520px, parent.width - 32px);
                height: min(560px, parent.height - 48px);
                border-radius: 12px;
                background: Theme.surface;
                border-width: 2px;
                border-color: root.sp-pristine ? #4ade80 : #fbbf24;
                TouchArea { }
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text { text: "Signal path"; font-size: 18px; font-weight: 700; color: Theme.text; horizontal-stretch: 1; }
                        IconButton { glyph: "✕"; side: 28px; clicked => { root.sp-open = false; } }
                    }
                    Text {
                        text: root.sp-pristine ? "PRISTINE" : "MODIFIED";
                        font-size: 32px;
                        font-weight: 800;
                        color: root.sp-pristine ? #4ade80 : #fbbf24;
                    }
                    Text { text: root.sp-headline; color: Theme.text; wrap: word-wrap; }
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for r in root.sp-rows: HorizontalLayout {
                                spacing: 12px;
                                height: 28px;
                                Text { text: r.key; color: Theme.text-muted; width: 120px; vertical-alignment: center; }
                                Text { text: r.value; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }
}
