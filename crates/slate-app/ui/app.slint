import { Theme } from "theme.slint";
import { LoginScreen } from "login.slint";
import { PlayerBar } from "player_bar.slint";
import { Sidebar, TrackPage } from "library.slint";
import { CardsPage, QueuePanel, LyricsPanel } from "pages.slint";
import { FullscreenPlayer } from "fullscreen.slint";
import { MiniPlayerWindow } from "mini.slint";
import { VideoView } from "video.slint";
import { SettingsPage, SettingsState } from "settings.slint";
import { ProfilePage, ProfileState } from "profile.slint";
import { IconButton, TextField, Button, Segmented } from "widgets.slint";
import { ShortcutOverlay, Shortcut, Shortcuts } from "shortcuts.slint";
import { ListView } from "std-widgets.slint";
import { TrackRow, PlaylistEntry, CardItem, CardRow, QueueRow, LyricLine, PresetTile, KeyValue, Choice, ShortcutRow, RoleRow, SmartRuleRow, VersionRow } from "types.slint";
export { MiniPlayerWindow, TrackRow, PlaylistEntry, CardItem, CardRow, QueueRow, LyricLine, PresetTile, KeyValue, Choice, ShortcutRow, RoleRow, SmartRuleRow, VersionRow, Shortcut, Shortcuts, SettingsState, ProfileState, Theme }

export enum Screen { loading, login, main }

export component AppWindow inherits Window {
    title: "Slate";
    icon: @image-url("../../../assets/icons/128x128.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 360px;
    min-height: 420px;
    background: Theme.background;
    full-screen: root.fullscreen;

    in property <Screen> screen: Screen.loading;

    // Breakpoints: below 900px the sidebar collapses to icons, below 600px the
    // player bar stacks its controls.
    property <bool> narrow: self.width < 900px;
    property <bool> compact: self.width < 600px;
    property <int> focus-tick: 0;
    in-out property <int> filter-tick: 0;
    in-out property <[TrackRow]> suggestions;
    in-out property <bool> suggest-visible: false;
    in-out property <string> suggest-status;
    callback suggest-load(string);
    callback suggest-add(int);
    callback suggest-play(int);
    callback suggest-action(int, string);
    in property <[PlaylistEntry]> smart-lists;
    in property <bool> can-save-smart;
    callback new-smart();
    callback toggle-discord-hidden(string);
    callback smart-action(string, string);
    callback save-smart-snapshot();
    in-out property <bool> smart-open: false;
    in-out property <string> smart-name;
    in-out property <bool> smart-all: true;
    in-out property <[SmartRuleRow]> smart-rules;
    in-out property <string> smart-sort;
    in-out property <bool> smart-desc: true;
    in-out property <string> smart-limit;
    in-out property <string> smart-error;
    callback smart-edit(string, int, string);
    in-out property <bool> versions-open: false;
    in-out property <string> versions-title;
    in-out property <[VersionRow]> versions-rows;
    in-out property <bool> versions-album: false;
    in-out property <bool> versions-replace-playlist: false;
    in-out property <bool> versions-replace-queue: false;
    callback version-action(int, string);
    callback versions-close();
    callback show-album-versions();
    in-out property <bool> approval-open: false;
    in-out property <int> approval-id: 0;
    in-out property <string> approval-text;
    callback approval-answer(int, bool);
    in-out property <bool> cmp-open: false;
    in-out property <string> cmp-title;
    in-out property <int> cmp-tab: 0;
    in-out property <[string]> cmp-labels;
    in-out property <[string]> cmp-lines;
    in-out property <bool> cmp-can-add-a: false;
    in-out property <bool> cmp-can-add-b: false;
    callback compare-tab(int);
    callback compare-action(string);
    callback compare-close();
    in-out property <bool> filter-open: false;
    in-out property <string> filter-text;
    in-out property <int> filter-quality: 0;
    in-out property <string> filter-status;
    callback filter-changed(string, int);
    pure callback resolve-key(string, bool, bool, bool, bool) -> string;
    callback capture-key(string, bool, bool, bool, bool);
    // Playlist picker: -1 = just create, -2 = current track, >=0 = list row.
    in-out property <bool> fullscreen: false;
    in-out property <bool> video-open: false;
    in property <image> video-frame;
    in property <string> video-title;
    in property <bool> video-favorite;
    in-out property <bool> video-minimized;
    callback video-toggle-favorite(bool);
    // Tracks / Videos tabs on the Loved pages.
    in property <bool> loved-tabs;
    in property <int> loved-tab;
    callback loved-tab-picked(int);
    in property <bool> video-playing;
    in property <float> video-progress;
    in property <string> video-position-text: "0:00";
    in property <string> video-duration-text: "0:00";
    in property <string> video-status;
    callback video-toggle();
    callback video-seek(float);
    callback video-close();
    in-out property <bool> sp-open: false;
    in property <bool> sp-pristine;
    in property <string> sp-headline;
    in property <[KeyValue]> sp-rows;
    callback open-signal-path();
    callback open-miniplayer();
    // Generic dialog: kind = rename | delete | move; target = playlist uuid or "folder:ID".
    in-out property <bool> dialog-open: false;
    in-out property <string> dialog-kind;
    in-out property <string> dialog-target;
    in-out property <string> dialog-text;
    in-out property <bool> picker-open: false;
    // Track credits panel.
    in-out property <bool> credits-open: false;
    in property <string> credits-title;
    in property <string> credits-status;
    in property <[KeyValue]> credits-rows;
    in-out property <int> picker-target: -1;
    in-out property <string> picker-name;
    in-out property <string> folder-name;

    // ---- login ----
    in property <string> login-code;
    in property <string> login-url;
    in property <image> login-qr;
    in property <string> login-status;
    in property <bool> login-busy;
    in property <bool> login-has-code;
    callback start-login();
    callback open-update();
    callback dismiss-update();
    callback open-login-url();

    // ---- navigation ----
    in property <string> view: "tracks";   // tracks | cards | settings
    in property <string> selected-source;
    in property <bool> can-back;
    in property <bool> can-forward;
    in-out property <string> search-text;
    callback back();
    callback forward();
    callback go(string);
    callback open-playlist(string);
    callback open-card(string, string);
    callback play-card(string, string);
    callback search(string);
    callback logout();

    // ---- sidebar ----
    in property <[PlaylistEntry]> playlists;
    in property <bool> playlists-loading;

    // ---- track pages ----
    in property <bool> has-page;
    in property <string> page-kind: "PLAYLIST";
    in property <string> page-title;
    in property <string> page-subtitle;
    in property <int> page-quality;
    in property <bool> page-atmos;
    in property <image> page-cover;
    in property <bool> page-loved;
    in property <bool> page-loading;
    in property <[TrackRow]> tracks;
    in property <string> playing-id;
    in property <bool> can-favorite;
    in property <bool> can-export;
    in property <bool> can-dedupe;
    callback remove-duplicates();
    callback export-list(string);
    in property <bool> page-favorite;
    in property <bool> hero-favorite;
    in property <bool> track-favorite;
    callback toggle-page-favorite();
    callback toggle-hero-favorite();
    callback toggle-favorite();
    callback dialog-accepted(string, string, string);
    callback add-to-playlist(int, string);
    callback create-playlist(int, string);
    callback import-playlist();
    callback create-folder(string);
    callback play-row(int);
    callback row-action(int, string);
    callback play-all();
    callback shuffle-all();

    // ---- card pages ----
    in property <string> cards-title;
    in property <string> cards-subtitle;
    in property <bool> cards-loading;
    in property <[CardRow]> card-rows;
    // Grid columns the card page fits; the model regroups its rows when it changes.
    in-out property <int> card-cols: 1;
    callback card-cols-changed(int);
    // Window scale factor (logical / physical pixel); changes when the window moves
    // to a monitor with another scale, so thumbnails are decoded again at that size.
    property <float> scale-factor: 1px / 1phx;
    callback scale-factor-changed(float);
    changed scale-factor => { root.scale-factor-changed(self.scale-factor); }
    in property <bool> has-hero;
    in property <image> hero-image;
    in property <string> hero-label;
    callback hero-play();
    callback hero-shuffle();

    // ---- right-hand panels ----
    in-out property <string> panel;  // "" | queue | lyrics
    in property <[QueueRow]> queue-rows;
    in property <[LyricLine]> lyric-lines;
    in property <string> lyrics-status;
    in property <bool> lyrics-synced;
    in property <int> lyric-current: -1;
    callback queue-play(int);
    callback queue-go(int, string);
    callback go-current(string);
    in property <[Choice]> dialog-choices;
    callback queue-remove(int);
    callback queue-clear();
    callback lyric-seek(int);

    // ---- playback ----
    in property <string> track-title;
    in property <string> track-artist;
    // Colours from album art: a background both theme text colours read on.
    in property <bool> tint-on;
    in property <color> tint;
    in property <string> quality-text;
    in property <int> track-badge;
    in property <bool> track-atmos;
    in property <image> track-cover;
    in property <bool> playing;
    in property <bool> has-track;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress;
    in property <float> volume: 1;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <string> error;
    in property <string> notice;
    in property <string> update-notice;
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-play();
    callback toggle-mute();
    callback seek(float);
    callback set-volume(float);
    callback seek-relative(float);
    in-out property <bool> shortcuts-open;
    // Settings → General: player bar and lyrics size.
    in property <float> bar-scale: 1.0;
    in property <float> lyrics-scale: 1.0;
    // Sort controls for the library list on screen (hidden elsewhere).
    in property <bool> sort-visible;
    in property <string> sort-label;
    in property <bool> sort-desc;
    callback cycle-sort();
    callback flip-sort();

    // Global shortcuts (ignored while a text field has focus, since fields consume keys).
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape && root.shortcuts-open) { root.shortcuts-open = false; return accept; }
            if (e.text == Key.Escape && root.fullscreen) { root.fullscreen = false; return accept; }
            if (SettingsState.capturing != "") { return reject; }
            let a = root.resolve-key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
            if (a == "play-pause") { root.toggle-play(); return accept; }
            if (a == "next") { root.next(); return accept; }
            if (a == "previous") { root.previous(); return accept; }
            if (a == "seek-forward") { root.seek-relative(5); return accept; }
            if (a == "seek-back") { root.seek-relative(-5); return accept; }
            if (a == "shortcuts") { root.shortcuts-open = !root.shortcuts-open; return accept; }
            if (a == "fullscreen") { root.fullscreen = !root.fullscreen; return accept; }
            if (a == "mute") { root.toggle-mute(); return accept; }
            if (a == "shuffle") { root.toggle-shuffle(); return accept; }
            if (a == "repeat") { root.cycle-repeat(); return accept; }
            if (a == "queue") { root.panel = root.panel == "queue" ? "" : "queue"; return accept; }
            if (a == "lyrics") { root.panel = root.panel == "lyrics" ? "" : "lyrics"; return accept; }
            if (a == "search") { root.focus-tick += 1; return accept; }
            if (a == "filter") { root.filter-tick += 1; return accept; }
            reject
        }

        if root.screen == Screen.loading: Text {
            text: "Starting…";
            color: Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.screen == Screen.login: LoginScreen {
            user-code: root.login-code;
            verification-url: root.login-url;
            qr: root.login-qr;
            status: root.login-status;
            busy: root.login-busy;
            has-code: root.login-has-code;
            start => { root.start-login(); }
            open-url => { root.open-login-url(); }
        }

        if root.screen == Screen.main: VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;
                Sidebar {
                    playlists: root.playlists;
                    playlists-loading: root.playlists-loading;
                    smart-lists: root.smart-lists;
                    new-smart => { root.new-smart(); }
                    smart-action(id, a) => { root.smart-action(id, a); }
                    selected: root.selected-source;
                    collapsed: root.narrow;
                    go(id) => { root.go(id); }
                    open-playlist(id) => { root.open-playlist(id); }
                    entry-action(id, a) => {
                        if (a == "delete") { root.dialog-kind = "delete"; root.dialog-target = id; root.dialog-open = true; }
                        else if (a == "rename") { root.dialog-kind = "rename"; root.dialog-target = id; root.dialog-text = ""; root.dialog-open = true; }
                        else if (a == "discord-toggle") { root.toggle-discord-hidden(id); }
                        else if (a == "compare") { root.dialog-kind = "compare"; root.dialog-target = id; root.dialog-open = true; }
                        else if (a == "move") { root.dialog-kind = "move"; root.dialog-target = id; root.dialog-open = true; }
                    }
                    new-playlist => { root.picker-target = -1; root.picker-open = true; }
                    logout => { root.logout(); }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    // top bar: history + search
                    Rectangle {
                        height: 52px;
                        background: Theme.background;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                IconButton { icon: @image-url("icons/chevron-left.svg"); enabled: root.can-back; clicked => { root.back(); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton { icon: @image-url("icons/chevron-right.svg"); enabled: root.can-forward; clicked => { root.forward(); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextField {
                                    focus-request: root.focus-tick;
                                    text <=> root.search-text;
                                    placeholder: "Search tracks, albums, artists…   ( / )";
                                    field-width: min(420px, root.width * 0.5);
                                    accepted(t) => { root.search(t); }
                                }
                            }
                        }
                    }
                    if root.update-notice != "": Rectangle {
                        height: 40px;
                        background: Theme.accent;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 8px;
                            spacing: 12px;
                            alignment: center;
                            Text { text: root.update-notice; color: Theme.on-accent; font-weight: 600; vertical-alignment: center; overflow: elide; }
                            Button { label: "View release"; height: 28px; y: (parent.height - self.height) / 2; clicked => { root.open-update(); } }
                            Button { label: "Dismiss"; height: 28px; y: (parent.height - self.height) / 2; clicked => { root.dismiss-update(); } }
                        }
                    }
                    if root.notice != "": Rectangle {
                        height: 28px;
                        background: Theme.accent;
                        Text { text: root.notice; color: Theme.on-accent; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.error != "": Rectangle {
                        height: 32px;
                        background: Theme.danger;
                        Text { text: root.error; color: Theme.on-accent; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.view == "tracks": TrackPage {
                        vertical-stretch: 1;
                        compact: root.compact;
                        has-page: root.has-page;
                        kind-label: root.page-kind;
                        title: root.page-title;
                        subtitle: root.page-subtitle;
                        quality: root.page-quality;
                        atmos: root.page-atmos;
                        cover: root.page-cover;
                        loved: root.page-loved;
                        loading: root.page-loading;
                        tracks: root.tracks;
                        playing-id: root.playing-id;
                        play-row(i) => { root.play-row(i); }
                        can-favorite: root.can-favorite;
                        can-export: root.can-export;
                        export-list(f) => { root.export-list(f); }
                        can-dedupe: root.can-dedupe;
                        show-album-versions => { root.show-album-versions(); }
                        can-save-smart: root.can-save-smart;
                        suggestions: root.suggestions;
                        suggest-visible: root.suggest-visible;
                        suggest-status: root.suggest-status;
                        suggest-load(m) => { root.suggest-load(m); }
                        suggest-add(i) => { root.suggest-add(i); }
                        suggest-play(i) => { root.suggest-play(i); }
                        suggest-action(i, a) => { root.suggest-action(i, a); }
                        save-smart-snapshot => { root.save-smart-snapshot(); }
                        filter-request: root.filter-tick;
                        filter-open <=> root.filter-open;
                        filter-text <=> root.filter-text;
                        filter-quality <=> root.filter-quality;
                        filter-status: root.filter-status;
                        filter-changed(t, q) => { root.filter-changed(t, q); }
                        remove-duplicates => { root.remove-duplicates(); }
                        page-favorite: root.page-favorite;
                        toggle-page-favorite => { root.toggle-page-favorite(); }
                        row-action(i, a) => {
                            if (a == "add-to-playlist") { root.picker-target = i; root.picker-open = true; }
                            else { root.row-action(i, a); }
                        }
                        play-all => { root.play-all(); }
                        shuffle-all => { root.shuffle-all(); }
                        loved-tabs: root.loved-tabs;
                        loved-tab: root.loved-tab;
                        loved-tab-picked(i) => { root.loved-tab-picked(i); }
                        sort-visible: root.sort-visible;
                        sort-label: root.sort-label;
                        sort-desc: root.sort-desc;
                        cycle-sort => { root.cycle-sort(); }
                        flip-sort => { root.flip-sort(); }
                    }
                    if root.view == "cards": CardsPage {
                        vertical-stretch: 1;
                        compact: root.compact;
                        title: root.cards-title;
                        subtitle: root.cards-subtitle;
                        loading: root.cards-loading;
                        rows: root.card-rows;
                        cols-changed(n) => { root.card-cols = n; root.card-cols-changed(n); }
                        has-hero: root.has-hero;
                        hero-image: root.hero-image;
                        hero-label: root.hero-label;
                        open(k, id) => { root.open-card(k, id); }
                        play(k, id) => { root.play-card(k, id); }
                        hero-favorite: root.hero-favorite;
                        toggle-hero-favorite => { root.toggle-hero-favorite(); }
                        hero-play => { root.hero-play(); }
                        hero-shuffle => { root.hero-shuffle(); }
                        loved-tabs: root.loved-tabs;
                        loved-tab: root.loved-tab;
                        loved-tab-picked(i) => { root.loved-tab-picked(i); }
                        sort-visible: root.sort-visible;
                        sort-label: root.sort-label;
                        sort-desc: root.sort-desc;
                        cycle-sort => { root.cycle-sort(); }
                        flip-sort => { root.flip-sort(); }
                    }
                    if root.view == "profile": ProfilePage {
                        vertical-stretch: 1;
                        compact: root.compact;
                    }
                    if root.view == "settings": SettingsPage {
                        vertical-stretch: 1;
                        compact: root.compact;
                    }
                }
                if root.panel == "queue" && !root.compact: QueuePanel {
                    width: 320px;
                    rows: root.queue-rows;
                    now-title: root.track-title;
                    now-artist: root.track-artist;
                    play(i) => { root.queue-play(i); }
                    remove(i) => { root.queue-remove(i); }
                    go(i, k) => { root.queue-go(i, k); }
                    clear => { root.queue-clear(); }
                    close => { root.panel = ""; }
                }
                if root.panel == "lyrics" && !root.compact: LyricsPanel {
                    width: 360px * max(1.0, root.lyrics-scale);
                    scale: root.lyrics-scale;
                    lines: root.lyric-lines;
                    status: root.lyrics-status;
                    synced: root.lyrics-synced;
                    current: root.lyric-current;
                    seek(i) => { root.lyric-seek(i); }
                    close => { root.panel = ""; }
                }
            }
            PlayerBar {
                // The three-column bar needs ~1250px (more when enlarged); below that
                // the stacked layout is used.
                compact: root.width < 1250px * root.bar-scale;
                scale: root.bar-scale;
                title: root.track-title;
                artist: root.track-artist;
                tint-on: root.tint-on;
                tint: root.tint;
                quality: root.quality-text;
                badge: root.track-badge;
                atmos: root.track-atmos;
                cover: root.track-cover;
                video-mini: root.video-open && root.video-minimized;
                video-frame: root.video-frame;
                video-title: root.video-title;
                restore-video => { root.video-minimized = false; }
                playing: root.playing;
                has-track: root.has-track;
                position-text: root.position-text;
                duration-text: root.duration-text;
                progress: root.progress;
                volume: root.volume;
                shuffle: root.shuffle;
                repeat: root.repeat;
                favorite: root.track-favorite;
                queue-open: root.panel == "queue";
                toggle-favorite => { root.toggle-favorite(); }
                add-to-playlist => { root.picker-target = -2; root.picker-open = true; }
                lyrics-open: root.panel == "lyrics";
                next => { root.next(); }
                previous => { root.previous(); }
                toggle-shuffle => { root.toggle-shuffle(); }
                cycle-repeat => { root.cycle-repeat(); }
                toggle-play => { root.toggle-play(); }
                toggle-mute => { root.toggle-mute(); }
                seek(f) => { root.seek(f); }
                set-volume(v) => { root.set-volume(v); }
                open-signal-path => { root.open-signal-path(); }
                open-miniplayer => { root.open-miniplayer(); }
                go-album => { root.go-current("album"); }
                go-artist => { root.go-current("artist"); }
                toggle-fullscreen => { root.fullscreen = true; }
                toggle-queue => { root.panel = root.panel == "queue" ? "" : "queue"; }
                toggle-lyrics => { root.panel = root.panel == "lyrics" ? "" : "lyrics"; }
            }
        }

        if root.fullscreen && root.screen == Screen.main: FullscreenPlayer {
            compact: root.compact;
            lyrics-scale: root.lyrics-scale;
            title: root.track-title;
            artist: root.track-artist;
            cover: root.track-cover;
            tint-on: root.tint-on;
            tint: root.tint;
            playing: root.playing;
            has-track: root.has-track;
            position-text: root.position-text;
            duration-text: root.duration-text;
            progress: root.progress;
            shuffle: root.shuffle;
            repeat: root.repeat;
            favorite: root.track-favorite;
            lyric-lines: root.lyric-lines;
            lyrics-synced: root.lyrics-synced;
            lyric-current: root.lyric-current;
            lyrics-status: root.lyrics-status;
            close => { root.fullscreen = false; }
            go-album => { root.fullscreen = false; root.go-current("album"); }
            go-artist => { root.fullscreen = false; root.go-current("artist"); }
            toggle-play => { root.toggle-play(); }
            next => { root.next(); }
            previous => { root.previous(); }
            toggle-shuffle => { root.toggle-shuffle(); }
            cycle-repeat => { root.cycle-repeat(); }
            toggle-favorite => { root.toggle-favorite(); }
            seek(f) => { root.seek(f); }
            lyric-seek(i) => { root.lyric-seek(i); }
        }

        if root.picker-open: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.picker-open = false; } }
            Rectangle {
                width: min(420px, parent.width - 32px);
                height: min(520px, parent.height - 48px);
                border-radius: 12px;
                background: Theme.surface;
                TouchArea { }
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: root.picker-target == -1 ? "New playlist or folder" : "Add to playlist"; font-size: 18px; font-weight: 700; color: Theme.text; horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/close.svg"); side: 28px; clicked => { root.picker-open = false; } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        TextField {
                            text <=> root.picker-name;
                            placeholder: "New playlist name";
                            field-width: 260px;
                            accepted(t) => { root.create-playlist(root.picker-target, t); root.picker-name = ""; root.picker-open = false; }
                        }
                        Button {
                            label: "Create";
                            primary: true;
                            enabled: root.picker-name != "";
                            clicked => { root.create-playlist(root.picker-target, root.picker-name); root.picker-name = ""; root.picker-open = false; }
                        }
                    }
                    if root.picker-target == -1: HorizontalLayout {
                        spacing: 8px;
                        TextField {
                            text <=> root.folder-name;
                            placeholder: "New folder name";
                            field-width: 260px;
                        }
                        Button {
                            label: "Create";
                            enabled: root.folder-name != "";
                            clicked => { root.create-folder(root.folder-name); root.folder-name = ""; root.picker-open = false; }
                        }
                    }
                    if root.picker-target == -1: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button {
                            label: "Import from file…";
                            clicked => { root.picker-open = false; root.import-playlist(); }
                        }
                        Text { text: "CSV or M3U, e.g. a Slate or Spotify export"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    }
                    if root.picker-target != -1: Text { text: "OR PICK ONE"; font-size: 11px; color: Theme.text-muted; }
                    if root.picker-target != -1: ListView {
                        vertical-stretch: 1;
                        for p in root.playlists: Rectangle {
                            height: 40px;
                            visible: !p.folder;
                            border-radius: 6px;
                            background: pk.has-hover ? Theme.surface-raised : transparent;
                            Text { x: 10px; text: p.title; color: Theme.text; vertical-alignment: center; overflow: elide; width: parent.width - 20px; }
                            pk := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.add-to-playlist(root.picker-target, p.uuid); root.picker-open = false; }
                            }
                        }
                    }
                }
            }
        }

        if root.credits-open: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.credits-open = false; } }
            Rectangle {
                width: min(440px, parent.width - 32px);
                height: min(520px, parent.height - 48px);
                border-radius: 12px;
                background: Theme.surface;
                TouchArea { }
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: root.credits-title; font-size: 18px; font-weight: 700; color: Theme.text; horizontal-stretch: 1; overflow: elide; }
                        IconButton { icon: @image-url("icons/close.svg"); side: 28px; clicked => { root.credits-open = false; } }
                    }
                    if root.credits-status != "": Text {
                        text: root.credits-status;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for c in root.credits-rows: Rectangle {
                            height: c.value == "" ? 32px : 28px;
                            if c.value == "": Text {
                                text: c.key;
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.text-muted;
                                vertical-alignment: bottom;
                            }
                            if c.value != "": HorizontalLayout {
                                spacing: 12px;
                                Text { width: 150px; text: c.key; color: Theme.text-muted; vertical-alignment: center; overflow: elide; }
                                Text { text: c.value; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }

        if root.versions-open: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.versions-open = false; root.versions-close(); } }
            Rectangle {
                width: min(680px, parent.width - 32px);
                height: min(520px, parent.height - 48px);
                border-radius: 12px;
                background: Theme.surface;
                TouchArea { }
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: root.versions-title; font-size: 18px; font-weight: 700; color: Theme.text; overflow: elide; }
                    ListView {
                        vertical-stretch: 1;
                        for v[i] in root.versions-rows: Rectangle {
                            height: 52px;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text { text: v.title; color: Theme.text; overflow: elide; }
                                    Text { text: v.label + (v.detail != "" ? "  ·  " + v.detail : ""); color: Theme.text-muted; font-size: 11px; overflow: elide; }
                                }
                                if root.versions-album: Button { label: "Open"; clicked => { root.version-action(i, "open"); } }
                                if !root.versions-album: Button { label: "Play"; clicked => { root.version-action(i, "play"); } }
                                if !root.versions-album: Button { label: "Queue"; clicked => { root.version-action(i, "queue"); } }
                                if !root.versions-album && root.versions-replace-playlist: Button { label: "Replace"; clicked => { root.version-action(i, "replace-playlist"); } }
                                if !root.versions-album && root.versions-replace-queue: Button { label: "Replace"; clicked => { root.version-action(i, "replace-queue"); } }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Button { label: "Close"; clicked => { root.versions-open = false; root.versions-close(); } }
                    }
                }
            }
        }

        if root.approval-open: Rectangle {
            background: #000000c0;
            TouchArea { }
            Rectangle {
                width: min(440px, parent.width - 32px);
                height: 170px;
                border-radius: 12px;
                background: Theme.surface;
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    Text { text: "An AI agent is asking"; font-size: 14px; color: Theme.text-muted; }
                    Text { text: root.approval-text; font-size: 17px; font-weight: 700; color: Theme.text; wrap: word-wrap; vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Text { text: "No answer in 60 s = Deny"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                        Button { label: "Deny"; clicked => { root.approval-answer(root.approval-id, false); } }
                        Button { label: "Allow"; primary: true; clicked => { root.approval-answer(root.approval-id, true); } }
                    }
                }
            }
        }

        if root.smart-open: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.smart-edit("cancel", 0, ""); } }
            Rectangle {
                width: min(640px, parent.width - 32px);
                height: min(600px, parent.height - 48px);
                border-radius: 12px;
                background: Theme.surface;
                TouchArea { }
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "Smart playlist"; font-size: 18px; font-weight: 700; color: Theme.text; }
                    TextField {
                        text: root.smart-name;
                        placeholder: "Name";
                        field-width: 280px;
                        edited(t) => { root.smart-edit("name", 0, t); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "Include tracks that match"; color: Theme.text-muted; vertical-alignment: center; }
                        Button { label: root.smart-all ? "all rules" : "any rule"; clicked => { root.smart-edit("match", 0, ""); } }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for r[i] in root.smart-rules: HorizontalLayout {
                                spacing: 6px;
                                height: 34px;
                                Button { label: r.field; min-width: 170px; clicked => { root.smart-edit("field", i, ""); } }
                                Button { label: r.op; min-width: 100px; clicked => { root.smart-edit("op", i, ""); } }
                                TextField { text: r.value; placeholder: r.hint; field-width: 170px; edited(t) => { root.smart-edit("value", i, t); } }
                                IconButton { icon: @image-url("icons/close.svg"); side: 28px; clicked => { root.smart-edit("remove", i, ""); } }
                            }
                            Button { label: "＋ Add rule"; clicked => { root.smart-edit("add", 0, ""); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "Sort by"; color: Theme.text-muted; vertical-alignment: center; }
                        Button { label: root.smart-sort; clicked => { root.smart-edit("sort", 0, ""); } }
                        Button { label: root.smart-desc ? "↓ newest / largest first" : "↑ oldest / smallest first"; clicked => { root.smart-edit("desc", 0, ""); } }
                        TextField { text: root.smart-limit; placeholder: "Limit (none)"; field-width: 120px; edited(t) => { root.smart-edit("limit", 0, t); } }
                    }
                    if root.smart-error != "": Text { text: root.smart-error; color: Theme.danger; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button { label: "Cancel"; clicked => { root.smart-edit("cancel", 0, ""); } }
                        Button { label: "Save"; primary: true; clicked => { root.smart-edit("save", 0, ""); } }
                    }
                }
            }
        }

        if root.cmp-open: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.cmp-open = false; root.compare-close(); } }
            Rectangle {
                width: min(640px, parent.width - 32px);
                height: min(560px, parent.height - 48px);
                border-radius: 12px;
                background: Theme.surface;
                TouchArea { }
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "Compare playlists"; font-size: 18px; font-weight: 700; color: Theme.text; }
                    Text { text: root.cmp-title; color: Theme.text-muted; overflow: elide; }
                    Segmented { options: root.cmp-labels; index: root.cmp-tab; picked(i) => { root.cmp-tab = i; root.compare-tab(i); } }
                    ListView {
                        vertical-stretch: 1;
                        for l in root.cmp-lines: Text { text: l; color: Theme.text; height: 24px; overflow: elide; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        if root.cmp-tab == 1: Button { label: "Add missing to A"; enabled: root.cmp-can-add-a; clicked => { root.compare-action("add-to-a"); } }
                        if root.cmp-tab == 0: Button { label: "Add missing to B"; enabled: root.cmp-can-add-b; clicked => { root.compare-action("add-to-b"); } }
                        Button { label: "New playlist from this tab"; clicked => { root.compare-action("tab-new"); } }
                        Button { label: "Merge A + B…"; clicked => { root.compare-action("merge-new"); } }
                        Button { label: "Close"; clicked => { root.cmp-open = false; root.compare-close(); } }
                    }
                }
            }
        }

        if SettingsState.capturing != "": Rectangle {
            background: #000000c0;
            capture-scope := FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if (e.text == Key.Escape) { SettingsState.capturing = ""; SettingsState.capture-warning = ""; return accept; }
                    root.capture-key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
                    accept
                }
            }
            TouchArea { clicked => { SettingsState.capturing = ""; SettingsState.capture-warning = ""; } }
            Rectangle {
                width: min(380px, parent.width - 32px);
                height: 120px;
                border-radius: 12px;
                background: Theme.surface;
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    padding: 16px;
                    Text { text: "Press the new shortcut"; font-size: 18px; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
                    Text { text: SettingsState.capture-warning != "" ? SettingsState.capture-warning : "Esc cancels"; color: SettingsState.capture-warning != "" ? Theme.danger : Theme.text-muted; wrap: word-wrap; horizontal-alignment: center; }
                }
            }
        }

        if root.dialog-open: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.dialog-open = false; } }
            Rectangle {
                width: min(400px, parent.width - 32px);
                height: root.dialog-kind == "move" ? min(420px, parent.height - 48px) : root.dialog-kind == "dedupe" || root.dialog-kind == "artists" || root.dialog-kind == "compare" ? min(420px, parent.height - 48px) : 190px;
                border-radius: 12px;
                background: Theme.surface;
                TouchArea { }
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: root.dialog-kind == "rename" ? "Rename" : root.dialog-kind == "delete" ? "Delete this?" : root.dialog-kind == "dedupe" ? "Remove duplicates" : root.dialog-kind == "artists" ? "Go to artist" : root.dialog-kind == "compare" ? "Compare with…" : "Move to folder";
                        font-size: 18px; font-weight: 700; color: Theme.text;
                    }
                    if root.dialog-kind == "delete": Text {
                        text: "This cannot be undone.";
                        color: Theme.text-muted;
                    }
                    if root.dialog-kind == "compare": Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            for p in root.playlists: Rectangle {
                                height: (p.folder || p.uuid == root.dialog-target) ? 0px : 40px;
                                visible: !p.folder && p.uuid != root.dialog-target;
                                border-radius: 6px;
                                background: cp.has-hover ? Theme.surface-raised : transparent;
                                Text { x: 10px; text: p.title; color: Theme.text; vertical-alignment: center; overflow: elide; width: parent.width - 20px; }
                                cp := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.dialog-accepted("compare", root.dialog-target, p.uuid); root.dialog-open = false; } }
                            }
                        }
                    }
                    if root.dialog-kind == "artists": Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            for c in root.dialog-choices: Rectangle {
                                height: 40px;
                                border-radius: 6px;
                                background: ca.has-hover ? Theme.surface-raised : transparent;
                                Text { x: 10px; text: c.title; color: Theme.text; vertical-alignment: center; }
                                ca := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.dialog-accepted("artist", c.id, ""); root.dialog-open = false; } }
                            }
                        }
                    }
                    if root.dialog-kind == "dedupe": Flickable {
                        vertical-stretch: 1;
                        content-height: dedupe-text.preferred-height;
                        dedupe-text := Text { width: parent.width; text: root.dialog-text; color: Theme.text-muted; wrap: word-wrap; }
                    }
                    if root.dialog-kind == "rename": TextField {
                        text <=> root.dialog-text;
                        placeholder: "New name";
                        field-width: 340px;
                        accepted(t) => { root.dialog-accepted("rename", root.dialog-target, t); root.dialog-open = false; }
                    }
                    if root.dialog-kind == "move": Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                        Rectangle {
                            height: 40px;
                            border-radius: 6px;
                            background: mr.has-hover ? Theme.surface-raised : transparent;
                            Text { x: 10px; text: "Top level (no folder)"; color: Theme.text; vertical-alignment: center; }
                            mr := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.dialog-accepted("move", root.dialog-target, "root"); root.dialog-open = false; } }
                        }
                        for p in root.playlists: Rectangle {
                            height: p.folder ? 40px : 0px;
                            visible: p.folder;
                            border-radius: 6px;
                            background: mf.has-hover ? Theme.surface-raised : transparent;
                            Text { x: 10px; text: "📁  " + p.title; color: Theme.text; vertical-alignment: center; }
                            mf := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.dialog-accepted("move", root.dialog-target, p.uuid); root.dialog-open = false; } }
                        }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button { label: "Cancel"; clicked => { root.dialog-open = false; } }
                        if root.dialog-kind == "rename": Button { label: "Rename"; primary: true; enabled: root.dialog-text != ""; clicked => { root.dialog-accepted("rename", root.dialog-target, root.dialog-text); root.dialog-open = false; } }
                        if root.dialog-kind == "dedupe": Button { label: "Remove"; danger: true; clicked => { root.dialog-accepted("dedupe", root.dialog-target, ""); root.dialog-open = false; } }
                        if root.dialog-kind == "delete": Button { label: "Delete"; danger: true; clicked => { root.dialog-accepted("delete", root.dialog-target, ""); root.dialog-open = false; } }
                    }
                }
            }
        }


        if root.video-open && !root.video-minimized: VideoView {
            frame: root.video-frame;
            title: root.video-title;
            favorite: root.video-favorite;
            toggle-favorite => { root.video-toggle-favorite(root.video-favorite); }
            minimize => { root.video-minimized = true; }
            playing: root.video-playing;
            progress: root.video-progress;
            position-text: root.video-position-text;
            duration-text: root.video-duration-text;
            status: root.video-status;
            toggle => { root.video-toggle(); }
            seek(f) => { root.video-seek(f); }
            close => { root.video-open = false; root.video-minimized = false; root.video-close(); }
        }

        if root.sp-open: Rectangle {
            background: #000000a0;
            TouchArea { clicked => { root.sp-open = false; } }
            Rectangle {
                width: min(520px, parent.width - 32px);
                height: min(560px, parent.height - 48px);
                border-radius: 12px;
                background: Theme.surface;
                border-width: 2px;
                border-color: root.sp-pristine ? #4ade80 : #fbbf24;
                TouchArea { }
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text { text: "Signal path"; font-size: 18px; font-weight: 700; color: Theme.text; horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/close.svg"); side: 28px; clicked => { root.sp-open = false; } }
                    }
                    Text {
                        text: root.sp-pristine ? "PRISTINE" : "MODIFIED";
                        font-size: 32px;
                        font-weight: 800;
                        color: root.sp-pristine ? #4ade80 : #fbbf24;
                    }
                    Text { text: root.sp-headline; color: Theme.text; wrap: word-wrap; }
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for r in root.sp-rows: HorizontalLayout {
                                spacing: 12px;
                                height: 28px;
                                Text { text: r.key; color: Theme.text-muted; width: 120px; vertical-alignment: center; }
                                Text { text: r.value; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    
        if root.shortcuts-open: ShortcutOverlay {
            close => { root.shortcuts-open = false; }
        }
    }
}
