import { Theme } from "theme.slint";
import { Button, TextField } from "widgets.slint";
import { SettingsState } from "settings.slint";

export component LoginScreen inherits Rectangle {
    in property <string> user-code;
    in property <string> verification-url;
    in property <image> qr;
    in property <string> status;
    in property <bool> busy;
    in property <bool> has-code;
    callback start();
    callback open-url();

    background: Theme.background;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "Slate";
            font-size: 40px;
            font-weight: 800;
            color: Theme.accent;
            horizontal-alignment: center;
        }
        Text {
            text: "Sign in to TIDAL";
            font-size: 18px;
            color: Theme.text;
            horizontal-alignment: center;
        }

        if root.has-code: VerticalLayout {
            spacing: 12px;
            Image {
                source: root.qr;
                image-rendering: pixelated;
                width: 200px;
                height: 200px;
            }
            Text {
                text: root.user-code;
                font-size: 32px;
                font-weight: 700;
                letter-spacing: 6px;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: "Scan the code or open " + root.verification-url;
                color: Theme.text-muted;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 40px;
                background: Theme.surface-raised;
                border-radius: 8px;
                Text { text: "Open in browser"; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.open-url(); } }
            }
        }

        if !root.has-code: Rectangle {
            height: 44px;
            background: root.busy ? Theme.surface-raised : Theme.accent;
            border-radius: 8px;
            Text {
                text: root.busy ? "Working…" : "Sign in";
                color: root.busy ? Theme.text-muted : Theme.on-accent;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: !root.busy;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.start(); }
            }
        }

        // Browser sign-in: the only way to get Lossless / Max quality.
        VerticalLayout {
            spacing: 8px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                if !SettingsState.pkce-pending: Button {
                    label: "Sign in with browser (Lossless / Max)";
                    clicked => { SettingsState.action("pkce-start"); }
                }
            }
            if SettingsState.pkce-pending: HorizontalLayout {
                alignment: center;
                spacing: 8px;
                TextField {
                    text <=> SettingsState.pkce-input;
                    placeholder: "Paste the page address";
                    field-width: 260px;
                    accepted(t) => { SettingsState.action("pkce-finish"); }
                }
                Button { label: "Finish"; primary: true; clicked => { SettingsState.action("pkce-finish"); } }
            }
            if SettingsState.pkce-status != "": Text {
                text: SettingsState.pkce-status;
                color: Theme.text-muted;
                wrap: word-wrap;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }

        Text {
            text: root.status;
            color: Theme.text-muted;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}
