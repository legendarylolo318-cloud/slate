import { Theme } from "theme.slint";
import { CardItem, CardRow, QueueRow, LyricLine, PartyState } from "types.slint";
import { IconButton, Button, Segmented } from "widgets.slint";
import { ListView } from "std-widgets.slint";
import { Dnd } from "dnd.slint";

global Dim {
    out property <length> card-w: 168px;
    out property <length> card-h: 230px;
}

component Card inherits Rectangle {
    in property <CardItem> item;
    callback open();
    callback play();
    callback suggest();
    width: Dim.card-w;
    height: Dim.card-h;
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface : transparent;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Rectangle {
            height: Dim.card-w - 16px;
            border-radius: root.item.kind == "artist" ? (Dim.card-w - 16px) / 2 : 6px;
            background: root.item.kind == "page" && root.item.cover.width == 0 ? root.item.tint : Theme.surface-raised;
            clip: true;
            if root.item.kind == "page" && root.item.cover.width == 0: Text {
                width: parent.width - 16px;
                text: root.item.title;
                color: white;
                font-size: 20px;
                font-weight: 800;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Image { source: root.item.cover; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
            if root.item.kind != "artist": Rectangle {
                x: parent.width - 48px;
                y: parent.height - 48px;
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: pt.has-hover ? Theme.accent.brighter(0.2) : Theme.accent;
                visible: ta.has-hover;
                Text { text: "▶"; color: Theme.on-accent; horizontal-alignment: center; vertical-alignment: center; }
                pt := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.play(); } }
            }
            // In a party, a search result can be sent to the host instead of played.
            if root.item.kind == "track" && PartyState.can-suggest: Rectangle {
                x: parent.width - 40px;
                y: 8px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: st.has-hover ? Theme.accent.brighter(0.2) : Theme.accent;
                visible: ta.has-hover || st.has-hover;
                Text { text: "＋"; color: Theme.on-accent; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                st := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.suggest(); } }
            }
        }
        Text { text: root.item.title; color: Theme.text; font-weight: 600; overflow: elide; horizontal-alignment: root.item.kind == "artist" ? TextHorizontalAlignment.center : TextHorizontalAlignment.left; }
        Text { text: root.item.subtitle; color: Theme.text-muted; font-size: 12px; overflow: elide; horizontal-alignment: root.item.kind == "artist" ? TextHorizontalAlignment.center : TextHorizontalAlignment.left; }
    }
    ta := TouchArea { mouse-cursor: MouseCursor.pointer; z: -1; clicked => { root.open(); } }
}

export component CardsPage inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> loading;
    // Header, section titles, strips and grid rows; only the rows on screen exist.
    in property <[CardRow]> rows;
    in property <bool> has-hero;
    in property <image> hero-image;
    in property <string> hero-label;
    in property <bool> hero-favorite: false;
    in property <bool> compact: false;
    in property <string> empty-text: "Nothing here yet.";
    callback open(string, string);
    callback play(string, string);
    callback hero-play();
    callback hero-shuffle();
    callback toggle-hero-favorite();
    in property <bool> sort-visible;
    in property <string> sort-label;
    in property <bool> sort-desc;
    callback cycle-sort();
    callback flip-sort();
    in property <bool> loved-tabs;
    in property <int> loved-tab;
    callback loved-tab-picked(int);
    /// Quality chips for the Tracks of a search.
    in property <bool> chips-visible;
    in property <int> chip-index;
    callback chip-picked(int);
    // Grid columns that fit; the model regroups its rows when this changes.
    callback cols-changed(int);
    property <length> pad: root.compact ? 12px : 24px;
    property <int> cols: max(1, floor((root.width - 2 * root.pad) / Dim.card-w));
    init => { root.cols-changed(root.cols); }
    changed cols => { root.cols-changed(root.cols); }
    background: Theme.background;

    ListView {
        for row in root.rows: VerticalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: row.kind == 0 ? root.pad : 0px;
            padding-bottom: row.last && root.rows.length > 1 ? 16px : (row.kind == 1 ? 8px : 0px);
            if row.kind == 0: VerticalLayout {
            spacing: 16px;
            alignment: start;
            if root.has-hero: HorizontalLayout {
                spacing: 20px;
                Rectangle {
                    width: 160px;
                    height: 160px;
                    border-radius: 80px;
                    clip: true;
                    background: Theme.surface-raised;
                    Image { source: root.hero-image; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                }
                VerticalLayout {
                    alignment: end;
                    spacing: 6px;
                    Text { text: root.hero-label; font-size: 11px; color: Theme.text-muted; }
                    Text { text: root.title; font-size: 36px; font-weight: 800; color: Theme.text; overflow: elide; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button { label: "▶  Play top tracks"; primary: true; clicked => { root.hero-play(); } }
                        Button { label: "🔀  Shuffle"; clicked => { root.hero-shuffle(); } }
                        Button { label: root.hero-favorite ? "♥  Following" : "♡  Follow"; clicked => { root.toggle-hero-favorite(); } }
                    }
                }
            }
            if !root.has-hero: VerticalLayout {
                alignment: start;
                spacing: 2px;
                Text { text: root.title; font-size: 30px; font-weight: 800; color: Theme.text; overflow: elide; }
                if root.subtitle != "": Text { text: root.subtitle; color: Theme.text-muted; }
                if root.loved-tabs: HorizontalLayout {
                    padding-top: 8px;
                    alignment: start;
                    if root.loved-tabs: Segmented { options: ["Tracks", "Videos"]; index: root.loved-tab; picked(i) => { root.loved-tab-picked(i); } }
                }
                if root.chips-visible: HorizontalLayout {
                    padding-top: 8px;
                    alignment: start;
                    Segmented { options: ["All", "Lossless", "Hi-Res", "Atmos"]; index: root.chip-index; picked(i) => { root.chip-picked(i); } }
                }
                if root.sort-visible: HorizontalLayout {
                    padding-top: 8px;
                    spacing: 8px;
                    alignment: start;
                    if root.sort-visible: Button { label: "⇅  " + root.sort-label; clicked => { root.cycle-sort(); } }
                    if root.sort-visible: Button { label: root.sort-desc ? "↓" : "↑"; clicked => { root.flip-sort(); } }
                }
            }
            if root.loading: Text { text: "Loading…"; color: Theme.text-muted; }
            if !root.loading && root.rows.length <= 1: Text { text: root.empty-text; color: Theme.text-muted; }
            }
            if row.kind == 1: Text { text: row.title; font-size: 20px; font-weight: 700; color: Theme.text; }
            if row.kind == 2: Flickable {
                height: Dim.card-h;
                content-width: row.cards.length * Dim.card-w;
                for c[i] in row.cards: Card {
                    x: i * Dim.card-w;
                    item: c;
                    open => { root.open(c.kind, c.id); }
                    play => { root.play(c.kind, c.id); }
                    suggest => { root.play("suggest", c.id); }
                }
            }
            if row.kind == 3: Rectangle {
                height: Dim.card-h;
                for c[i] in row.cards: Card {
                    x: i * Dim.card-w;
                    item: c;
                    open => { root.open(c.kind, c.id); }
                    play => { root.play(c.kind, c.id); }
                    suggest => { root.play("suggest", c.id); }
                }
            }
        }
    }
}

export component QueuePanel inherits Rectangle {
    in property <[QueueRow]> rows;
    in property <string> now-title;
    in property <string> now-artist;
    callback play(int);
    callback remove(int);
    callback go(int, string);
    callback clear();
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback undo();
    callback redo();
    callback close();
    callback menu(string);
    /// Ctrl / Shift click on a row, and a bulk action ("sel-…") on the selection.
    callback select(int, bool, bool);
    callback sel-action(string);
    in property <int> selection-size: 0;
    property <bool> m-ctrl: false;
    property <bool> m-shift: false;
    background: Theme.surface;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text { text: "Queue"; font-size: 20px; font-weight: 700; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
            Button { label: "↶"; min-width: 36px; height: 28px; enabled: root.can-undo; clicked => { root.undo(); } }
            Button { label: "↷"; min-width: 36px; height: 28px; enabled: root.can-redo; clicked => { root.redo(); } }
            Button { label: "Clear"; min-width: 60px; height: 28px; clicked => { root.clear(); } }
            qmore := Button {
                label: "⋯";
                min-width: 36px;
                height: 28px;
                clicked => { qmenu.show({ x: qmore.absolute-position.x, y: qmore.absolute-position.y + qmore.height }); }
                qmenu := ContextMenuArea {
                    Menu {
                        Menu {
                            title: "Fill queue to…";
                            MenuItem { title: "15 minutes"; activated => { root.menu("fill-15"); } }
                            MenuItem { title: "30 minutes"; activated => { root.menu("fill-30"); } }
                            MenuItem { title: "45 minutes"; activated => { root.menu("fill-45"); } }
                            MenuItem { title: "60 minutes"; activated => { root.menu("fill-60"); } }
                            MenuItem { title: "90 minutes"; activated => { root.menu("fill-90"); } }
                            MenuItem { title: "Custom…"; activated => { root.menu("fill-custom"); } }
                        }
                        MenuItem { title: "Save queue as playlist"; activated => { root.menu("save-playlist"); } }
                        MenuItem { title: "Queue snapshots…"; activated => { root.menu("snapshots"); } }
                    }
                }
            }
            IconButton { icon: @image-url("icons/close.svg"); side: 28px; clicked => { root.close(); } }
        }
        Text { text: "NOW PLAYING"; font-size: 11px; color: Theme.text-muted; }
        Text { text: root.now-title == "" ? "Nothing playing" : root.now-title + " — " + root.now-artist; color: Theme.accent; overflow: elide; }
        Text { text: "NEXT UP (" + root.rows.length + ")"; font-size: 11px; color: Theme.text-muted; }
        ListView {
            vertical-stretch: 1;
            for r[i] in root.rows: Rectangle {
                height: 44px;
                border-radius: 6px;
                background: r.selected ? Theme.accent.with-alpha(0.22) : (qa.has-hover ? Theme.surface-raised : transparent);
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 6px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: r.title; color: Theme.text; overflow: elide; }
                        Text { text: (r.manual ? "Added · " : "") + r.artist; color: Theme.text-muted; font-size: 11px; overflow: elide; }
                    }
                    IconButton { icon: @image-url("icons/close.svg"); side: 28px; visible: qa.has-hover; clicked => { root.remove(i); } }
                }
                DragArea {
                    data: Dnd.make("queue:" + i);
                    allow-move: true;
                    changed dragging => { if (self.dragging) { Dnd.cancelled = false; } }
                    qa := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        z: -1;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { root.m-ctrl = e.modifiers.control; root.m-shift = e.modifiers.shift; }
                        }
                        clicked => { if (root.m-ctrl || root.m-shift) { root.select(i, root.m-ctrl, root.m-shift); } }
                        double-clicked => { root.play(i); }
                    }
                }
                DropArea {
                    can-drop(e) => { (Dnd.kind(e.data) == "queue" && !Dnd.cancelled) ? DragAction.move : DragAction.none }
                    dropped(e) => { Dnd.dropped(e.data, "queue:" + i); DragAction.move }
                    Rectangle { y: 0; height: 2px; background: Theme.accent; visible: parent.has-drag; }
                }
                ContextMenuArea {
                    Menu {
                        if r.selected && root.selection-size > 1: MenuItem { title: "Remove " + root.selection-size + " tracks from the queue"; activated => { root.sel-action("sel-remove"); } }
                        if r.selected && root.selection-size > 1: MenuItem { title: "Play " + root.selection-size + " tracks next"; activated => { root.sel-action("sel-next"); } }
                        if r.selected && root.selection-size > 1: MenuItem { title: "Add " + root.selection-size + " tracks to playlist…"; activated => { root.sel-action("sel-playlist"); } }
                        if r.selected && root.selection-size > 1 && PartyState.can-suggest: MenuItem { title: "Suggest to party"; activated => { root.sel-action("sel-suggest"); } }
                        if r.selected && root.selection-size > 1: MenuItem { title: "Tags… (" + root.selection-size + " tracks)"; activated => { root.sel-action("sel-tags"); } }
                        if r.selected && root.selection-size > 1: MenuItem { title: "Clear selection"; activated => { root.sel-action("sel-clear"); } }
                        if !(r.selected && root.selection-size > 1): MenuItem { title: "Play"; activated => { root.play(i); } }
                        if !(r.selected && root.selection-size > 1): MenuItem { title: "Other versions…"; activated => { root.go(i, "versions"); } }
                        if !(r.selected && root.selection-size > 1): MenuItem { title: "Go to album"; activated => { root.go(i, "album"); } }
                        if !(r.selected && root.selection-size > 1): MenuItem { title: "Go to artist"; activated => { root.go(i, "artist"); } }
                        if !(r.selected && root.selection-size > 1): MenuItem { title: "Tags…"; activated => { root.go(i, "tags"); } }
                        if !(r.selected && root.selection-size > 1): MenuItem { title: "Copy link"; activated => { root.go(i, "copy-link"); } }
                        if !(r.selected && root.selection-size > 1): MenuItem { title: "Copy share card"; activated => { root.go(i, "share-card"); } }
                        if !(r.selected && root.selection-size > 1): Menu {
                            title: "Share card theme";
                            MenuItem { title: "Dark"; activated => { root.go(i, "share-card:dark"); } }
                            MenuItem { title: "Light"; activated => { root.go(i, "share-card:light"); } }
                            MenuItem { title: "Album colour"; activated => { root.go(i, "share-card:album"); } }
                            MenuItem { title: "Minimal"; activated => { root.go(i, "share-card:minimal"); } }
                        }
                        if !(r.selected && root.selection-size > 1): MenuItem { title: "Remove from queue"; activated => { root.remove(i); } }
                    }
                }
            }
        }
    }
}

export component LyricsPanel inherits Rectangle {
    // Lyrics size (Settings → General).
    in property <float> scale: 1.0;
    in property <[LyricLine]> lines;
    in property <string> status;
    in property <bool> synced;
    in property <int> current;
    /// Timing offset of this track's lyrics in ms (saved per track).
    in property <int> offset-ms;
    callback seek(int);
    callback nudge(int);
    callback expand();
    callback close();
    background: Theme.surface;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text { text: "Lyrics"; font-size: 20px * root.scale; font-weight: 700; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
            IconButton { tip: "Full-screen lyrics"; icon: @image-url("icons/fullscreen.svg"); side: 28px; clicked => { root.expand(); } }
            IconButton { icon: @image-url("icons/close.svg"); side: 28px; clicked => { root.close(); } }
        }
        if root.synced: HorizontalLayout {
            spacing: 8px;
            Button { label: "−100 ms"; clicked => { root.nudge(-100); } }
            Text {
                horizontal-stretch: 1;
                text: root.offset-ms == 0 ? "In sync" : (root.offset-ms > 0 ? "+" : "") + root.offset-ms + " ms";
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Button { label: "+100 ms"; clicked => { root.nudge(100); } }
        }
        if root.status != "": Text { text: root.status; color: Theme.text-muted; wrap: word-wrap; }
        lv := ListView {
            vertical-stretch: 1;
            for l[i] in root.lines: Rectangle {
                // Rows grow with the text, so large or wrapped lines are never clipped.
                height: max(36px * root.scale, line.preferred-height + 12px * root.scale);
                TouchArea { mouse-cursor: root.synced ? MouseCursor.pointer : MouseCursor.default; clicked => { if (root.synced) { root.seek(i); } } }
                line := Text {
                    width: parent.width;
                    text: l.text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    color: l.active ? Theme.accent : Theme.text-muted;
                    font-size: (l.active ? 18px : 15px) * root.scale;
                    font-weight: l.active ? 700 : 400;
                    animate color { duration: 150ms; }
                }
            }
        }
    }
    // Keep the active line in view.
    changed current => {
        lv.content-y = -max(0px, root.current * 36px - lv.height / 2);
    }
}
