import { Theme } from "theme.slint";
import { IconButton, Bar } from "widgets.slint";

export component PlayerBar inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> quality;
    in property <image> cover;
    in property <bool> playing;
    in property <bool> has-track;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress: 0;
    in property <float> volume: 1;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <bool> compact: false;
    in property <bool> favorite: false;
    in property <bool> queue-open: false;
    in property <bool> lyrics-open: false;
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-play();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-favorite();
    callback add-to-playlist();
    callback open-signal-path();
    callback open-miniplayer();
    callback toggle-fullscreen();
    callback toggle-queue();
    callback toggle-lyrics();

    // Side columns are equal so the transport sits exactly in the middle; stretch
    // factors would add to each column's own content width and push it off-centre.
    // The right group (8 buttons + volume bar) needs ~420px.
    property <length> side-w: max(430px, root.width * 0.28);
    property <length> mid-w: max(0px, root.width - 2 * root.side-w - 52px);
    height: root.compact ? 112px : 88px;
    background: Theme.surface;

    // Wide: info | transport | volume. Compact: info on top, transport below.
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 16px;
            // track info
            HorizontalLayout {
                horizontal-stretch: root.compact ? 1 : 0;
                min-width: root.compact ? 0px : root.side-w;
                max-width: root.compact ? 100000px : root.side-w;
                spacing: 12px;
                Rectangle {
                    width: root.compact ? 40px : 56px;
                    height: self.width;
                    border-radius: 6px;
                    background: Theme.surface-raised;
                    clip: true;
                    Image { source: root.cover; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: root.title; color: Theme.text; font-weight: 600; overflow: elide; }
                    Text { text: root.artist; color: Theme.text-muted; font-size: 12px; overflow: elide; }
                    if root.quality != "": Text { text: root.quality; color: Theme.accent; font-size: 11px; font-weight: 600; overflow: elide; }
                }
            }
            // transport (wide layout keeps it centred here)
            if !root.compact: VerticalLayout {
                min-width: root.mid-w;
                max-width: root.mid-w;
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    IconButton { glyph: "🔀"; active: root.shuffle; opacity: root.shuffle ? 1.0 : 0.6; clicked => { root.toggle-shuffle(); } }
                    IconButton { glyph: "⏮"; enabled: root.has-track; clicked => { root.previous(); } }
                    IconButton { primary: true; enabled: root.has-track; glyph: root.playing ? "⏸" : "▶"; clicked => { root.toggle-play(); } }
                    IconButton { glyph: "⏭"; enabled: root.has-track; clicked => { root.next(); } }
                    IconButton { glyph: root.repeat == 2 ? "🔂" : "🔁"; active: root.repeat != 0; opacity: root.repeat == 0 ? 0.6 : 1.0; clicked => { root.cycle-repeat(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.position-text; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; width: 40px; horizontal-alignment: right; }
                    Bar { horizontal-stretch: 1; fraction: root.progress; picked(f) => { root.seek(f); } }
                    Text { text: root.duration-text; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; width: 40px; }
                }
            }
            // right cluster
            HorizontalLayout {
                horizontal-stretch: root.compact ? 1 : 0;
                min-width: root.compact ? 0px : root.side-w;
                max-width: root.compact ? 100000px : root.side-w;
                alignment: end;
                spacing: 4px;
                if root.compact: IconButton { primary: true; enabled: root.has-track; glyph: root.playing ? "⏸" : "▶"; clicked => { root.toggle-play(); } }
                IconButton { glyph: root.favorite ? "♥" : "♡"; active: root.favorite; enabled: root.has-track; clicked => { root.toggle-favorite(); } }
                IconButton { glyph: "＋"; enabled: root.has-track; clicked => { root.add-to-playlist(); } }
                IconButton { glyph: "♪"; active: root.lyrics-open; enabled: root.has-track; clicked => { root.toggle-lyrics(); } }
                IconButton { glyph: "▣"; clicked => { root.open-miniplayer(); } }
                IconButton { glyph: "◎"; clicked => { root.open-signal-path(); } }
                IconButton { glyph: "⛶"; enabled: root.has-track; clicked => { root.toggle-fullscreen(); } }
                IconButton { glyph: "☰"; active: root.queue-open; clicked => { root.toggle-queue(); } }
                if !root.compact: IconButton { glyph: root.volume == 0 ? "🔇" : "🔊"; clicked => { root.toggle-mute(); } }
                if !root.compact: Rectangle {
                    // Same height as the buttons so the bar lines up with the icons.
                    width: 96px;
                    height: 34px;
                    Bar {
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        live: true;
                        fraction: root.volume;
                        changed(f) => { root.set-volume(f); }
                        picked(f) => { root.set-volume(f); }
                    }
                }
            }
        }
        if root.compact: HorizontalLayout {
            spacing: 4px;
            IconButton { glyph: "🔀"; side: 30px; active: root.shuffle; clicked => { root.toggle-shuffle(); } }
            IconButton { glyph: "⏮"; side: 30px; enabled: root.has-track; clicked => { root.previous(); } }
            IconButton { glyph: "⏭"; side: 30px; enabled: root.has-track; clicked => { root.next(); } }
            IconButton { glyph: root.repeat == 2 ? "🔂" : "🔁"; side: 30px; active: root.repeat != 0; clicked => { root.cycle-repeat(); } }
            Text { text: root.position-text; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
            Bar { horizontal-stretch: 1; fraction: root.progress; picked(f) => { root.seek(f); } }
            Text { text: root.duration-text; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
        }
    }
}
