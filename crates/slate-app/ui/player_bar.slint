import { Theme } from "theme.slint";
import { IconButton, Bar, QualityBadges } from "widgets.slint";

export component PlayerBar inherits Rectangle {
    callback go-album();
    callback go-artist();
    in property <string> title;
    in property <string> artist;
    in property <bool> tint-on;
    in property <color> tint;
    in property <string> quality;
    in property <int> badge;
    in property <bool> atmos;
    in property <image> cover;
    // A minimised music video plays in the artwork slot; click restores it.
    in property <bool> video-mini;
    in property <image> video-frame;
    in property <string> video-title;
    callback restore-video();
    in property <bool> playing;
    in property <bool> has-track;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress: 0;
    in property <float> volume: 1;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <bool> compact: false;
    in property <bool> favorite: false;
    in property <bool> queue-open: false;
    in property <bool> lyrics-open: false;
    // Player bar size (Settings → General): scales everything below.
    in property <float> scale: 1.0;
    property <length> btn: 38px * root.scale;
    property <length> btn-primary: 52px * root.scale;
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-play();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-favorite();
    callback add-to-playlist();
    callback open-signal-path();
    callback open-miniplayer();
    callback toggle-fullscreen();
    callback toggle-queue();
    callback toggle-lyrics();

    // Side columns are equal so the transport sits exactly in the middle; stretch
    // factors would add to each column's own content width and push it off-centre.
    // The right group (8 buttons + volume bar) needs ~420px.
    // Right cluster: 8 buttons + slim volume slider ≈ 410px at Normal.
    property <length> side-w: max(420px * root.scale, root.width * 0.27);
    property <length> mid-w: max(0px, root.width - 2 * root.side-w - 52px * root.scale);
    height: (root.compact ? 158px : 96px) * root.scale;
    // Very narrow windows drop the secondary buttons; transport and seek bar always stay.
    property <bool> narrow: root.width < 560px * root.scale;
    background: root.tint-on ? root.tint : Theme.surface;
    animate background { duration: 300ms; }

    // Wide: info | transport | volume. Compact: info on top, transport below.
    VerticalLayout {
        padding: 10px * root.scale;
        spacing: 4px * root.scale;
        HorizontalLayout {
            spacing: 16px * root.scale;
            // track info
            HorizontalLayout {
                horizontal-stretch: root.compact ? 1 : 0;
                min-width: root.compact ? 0px : root.side-w;
                max-width: root.compact ? 100000px : root.side-w;
                spacing: 12px * root.scale;
                Rectangle {
                    height: (root.compact ? 44px : 62px) * root.scale;
                    // 16:9 while a video plays here.
                    width: root.video-mini ? self.height * 16 / 9 : self.height;
                    border-radius: 6px * root.scale;
                    background: root.video-mini ? #000000 : Theme.surface-raised;
                    clip: true;
                    if !root.video-mini: Image { source: root.cover; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                    if root.video-mini: Image { source: root.video-frame; width: parent.width; height: parent.height; image-fit: ImageFit.contain; }
                    if root.video-mini: TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.restore-video(); } }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: tt.preferred-height;
                        tt := Text { width: parent.width; text: root.video-mini ? root.video-title : root.title; color: Theme.text; font-size: 14.5px * root.scale; font-weight: 600; overflow: elide; }
                        TouchArea { enabled: root.has-track && !root.video-mini; mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default; clicked => { root.go-album(); } }
                    }
                    Rectangle {
                        height: ta.preferred-height;
                        ta := Text { width: parent.width; text: root.artist; color: Theme.text-muted; font-size: 12.5px * root.scale; overflow: elide; }
                        TouchArea { enabled: root.has-track && !root.video-mini; mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default; clicked => { root.go-artist(); } }
                    }
                    if root.quality != "" || root.badge > 0 || root.atmos: HorizontalLayout {
                        spacing: 6px * root.scale;
                        QualityBadges { tier: root.badge; atmos: root.atmos; long-atmos: false; scale: root.scale; }
                        if root.quality != "": Text { text: root.quality; color: root.tint-on ? Theme.text-muted : Theme.accent; font-size: 11px * root.scale; font-weight: 600; overflow: elide; vertical-alignment: center; }
                    }
                }
            }
            // transport (wide layout keeps it centred here)
            if !root.compact: VerticalLayout {
                min-width: root.mid-w;
                max-width: root.mid-w;
                alignment: center;
                spacing: 2px * root.scale;
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px * root.scale;
                    IconButton { side: root.btn; icon: @image-url("icons/shuffle.svg"); active: root.shuffle; opacity: root.shuffle ? 1.0 : 0.6; clicked => { root.toggle-shuffle(); } }
                    IconButton { side: root.btn; icon: @image-url("icons/previous.svg"); enabled: root.has-track; clicked => { root.previous(); } }
                    IconButton { primary: true; side: root.btn-primary; enabled: root.has-track; icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg"); clicked => { root.toggle-play(); } }
                    IconButton { side: root.btn; icon: @image-url("icons/next.svg"); enabled: root.has-track; clicked => { root.next(); } }
                    IconButton { side: root.btn; icon: root.repeat == 2 ? @image-url("icons/repeat-one.svg") : @image-url("icons/repeat.svg"); active: root.repeat != 0; opacity: root.repeat == 0 ? 0.6 : 1.0; clicked => { root.cycle-repeat(); } }
                }
                HorizontalLayout {
                    spacing: 8px * root.scale;
                    Text { text: root.position-text; color: Theme.text-muted; font-size: 11.5px * root.scale; vertical-alignment: center; width: 44px * root.scale; horizontal-alignment: right; }
                    Bar { horizontal-stretch: 1; height: 18px * root.scale; thickness: 4px * root.scale; fraction: root.progress; picked(f) => { root.seek(f); } }
                    Text { text: root.duration-text; color: Theme.text-muted; font-size: 11.5px * root.scale; vertical-alignment: center; width: 44px * root.scale; }
                }
            }
            // right cluster
            HorizontalLayout {
                horizontal-stretch: root.compact ? 1 : 0;
                min-width: root.compact ? 0px : root.side-w;
                max-width: root.compact ? 100000px : root.side-w;
                alignment: end;
                spacing: 2px * root.scale;
                IconButton { side: root.btn; icon: root.favorite ? @image-url("icons/heart-filled.svg") : @image-url("icons/heart.svg"); active: root.favorite; enabled: root.has-track; clicked => { root.toggle-favorite(); } }
                if !root.compact || !root.narrow: IconButton { side: root.btn; icon: @image-url("icons/plus.svg"); enabled: root.has-track; clicked => { root.add-to-playlist(); } }
                IconButton { side: root.btn; icon: @image-url("icons/lyrics.svg"); active: root.lyrics-open; enabled: root.has-track; clicked => { root.toggle-lyrics(); } }
                if !root.compact || !root.narrow: IconButton { side: root.btn; icon: @image-url("icons/miniplayer.svg"); clicked => { root.open-miniplayer(); } }
                if !root.compact || !root.narrow: IconButton { side: root.btn; icon: @image-url("icons/signal.svg"); clicked => { root.open-signal-path(); } }
                if !root.compact || !root.narrow: IconButton { side: root.btn; icon: @image-url("icons/fullscreen.svg"); enabled: root.has-track; clicked => { root.toggle-fullscreen(); } }
                IconButton { side: root.btn; icon: @image-url("icons/queue.svg"); active: root.queue-open; clicked => { root.toggle-queue(); } }
                if !root.compact: IconButton { side: root.btn; icon: root.volume == 0 ? @image-url("icons/volume-mute.svg") : @image-url("icons/volume.svg"); clicked => { root.toggle-mute(); } }
                if !root.compact: Rectangle {
                    // Same height as the buttons so the bar lines up with the icons.
                    width: 84px * root.scale;
                    height: root.btn;
                    Bar {
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        height: 18px * root.scale;
                        thickness: 4px * root.scale;
                        live: true;
                        fraction: root.volume;
                        changed(f) => { root.set-volume(f); }
                        picked(f) => { root.set-volume(f); }
                    }
                }
            }
        }
        if root.compact: HorizontalLayout {
            alignment: center;
            spacing: 6px * root.scale;
            IconButton { icon: @image-url("icons/shuffle.svg"); side: 36px * root.scale; active: root.shuffle; clicked => { root.toggle-shuffle(); } }
            IconButton { icon: @image-url("icons/previous.svg"); side: 40px * root.scale; enabled: root.has-track; clicked => { root.previous(); } }
            IconButton { primary: true; side: root.btn-primary; enabled: root.has-track; icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg"); clicked => { root.toggle-play(); } }
            IconButton { icon: @image-url("icons/next.svg"); side: 40px * root.scale; enabled: root.has-track; clicked => { root.next(); } }
            IconButton { icon: root.repeat == 2 ? @image-url("icons/repeat-one.svg") : @image-url("icons/repeat.svg"); side: 36px * root.scale; active: root.repeat != 0; clicked => { root.cycle-repeat(); } }
        }
        if root.compact: HorizontalLayout {
            spacing: 6px * root.scale;
            Text { text: root.position-text; color: Theme.text-muted; font-size: 11.5px * root.scale; vertical-alignment: center; }
            Bar { horizontal-stretch: 1; height: 18px * root.scale; thickness: 4px * root.scale; fraction: root.progress; picked(f) => { root.seek(f); } }
            Text { text: root.duration-text; color: Theme.text-muted; font-size: 11.5px * root.scale; vertical-alignment: center; }
        }
    }
}
