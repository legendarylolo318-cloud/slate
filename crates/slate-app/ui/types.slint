export struct TrackRow {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
    explicit: bool,
    loaded: bool,
    favorite: bool,
    cover: image,
}

export struct PlaylistEntry {
    uuid: string,
    title: string,
    subtitle: string,
    folder: bool,
    cover: image,
}

export struct CardItem {
    kind: string,
    id: string,
    title: string,
    subtitle: string,
    cover: image,
}

export struct CardSection {
    title: string,
    /// true: wrapping grid; false: single horizontally scrolling row.
    wrap: bool,
    cards: [CardItem],
}

export struct QueueRow {
    title: string,
    artist: string,
    manual: bool,
}

export struct LyricLine {
    text: string,
    active: bool,
}

export struct PresetTile {
    name: string,
    accent: color,
    bg: color,
}
