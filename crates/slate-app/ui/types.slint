export struct TrackRow {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
    explicit: bool,
    loaded: bool,
    favorite: bool,
    /// 0 none, 1 Lossless, 2 Hi-Res.
    quality: int,
    atmos: bool,
    cover: image,
    /// Part of the multi-selection.
    selected: bool,
}

export struct PlaylistEntry {
    uuid: string,
    title: string,
    subtitle: string,
    folder: bool,
    cover: image,
}

export struct CardItem {
    kind: string,
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    /// Background of a page-link tile that has no artwork.
    tint: color,
}

/// One row of a card page's virtualised list (built by `models::CardRows`).
export struct CardRow {
    /// 0 page header, 1 section title, 2 horizontally scrolling strip,
    /// 3 one row of a wrapping grid.
    kind: int,
    title: string,
    cards: [CardItem],
    /// Last row of its section: the gap between sections follows it.
    last: bool,
}

export struct ShortcutRow {
    id: string,
    label: string,
    combo: string,
    custom: bool,
    global: bool,
}

export struct RoleRow {
    id: string,
    label: string,
    color: color,
    hex: string,
    custom: bool,
}

export struct SmartRuleRow {
    field: string,
    op: string,
    value: string,
    hint: string,
}

export struct VersionRow {
    id: string,
    title: string,
    label: string,
    detail: string,
}

export struct Choice {
    title: string,
    id: string,
}

export struct QueueRow {
    title: string,
    artist: string,
    manual: bool,
    /// Part of the multi-selection.
    selected: bool,
}

export struct LyricLine {
    text: string,
    active: bool,
}

export struct PresetTile {
    name: string,
    accent: color,
    bg: color,
}

export struct KeyValue {
    key: string,
    value: string,
}

/// A guest's request waiting for the host (Settings → Party).
export struct PartyRequest {
    id: string,
    guest: string,
    track: string,
    quality: string,
    /// Guests who cannot play it.
    unavailable: int,
}

export struct PartyGuest {
    name: string,
    cohost: bool,
}

/// What the track lists need to know about a party.
export global PartyState {
    /// "", "host" or "guest".
    in-out property <string> role;
    /// A guest may send the host a track.
    in-out property <bool> can-suggest;
    /// "Ann 🔥": the latest reaction, shown for a few seconds.
    in-out property <string> reaction-flash;
    /// The host's counts for the playing track: "🔥 3  👍 1".
    in-out property <string> reaction-tally;
}

/// One line of the credits panel: a group heading, or a person in a role.
export struct CreditLine {
    heading: bool,
    role: string,
    name: string,
    /// TIDAL artist id of the person ("" when TIDAL gives none).
    artist-id: string,
}

/// One equalizer band as text fields (Settings → Playback → Equalizer).
export struct EqBand {
    /// 0 Peak, 1 Low shelf, 2 High shelf.
    kind: int,
    freq: string,
    gain: string,
    q: string,
}
