export struct TrackRow {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
    explicit: bool,
    loaded: bool,
    favorite: bool,
    /// 0 none, 1 Lossless, 2 Hi-Res.
    quality: int,
    atmos: bool,
    cover: image,
}

export struct PlaylistEntry {
    uuid: string,
    title: string,
    subtitle: string,
    folder: bool,
    cover: image,
}

export struct CardItem {
    kind: string,
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    /// Background of a page-link tile that has no artwork.
    tint: color,
}

/// One row of a card page's virtualised list (built by `models::CardRows`).
export struct CardRow {
    /// 0 page header, 1 section title, 2 horizontally scrolling strip,
    /// 3 one row of a wrapping grid.
    kind: int,
    title: string,
    cards: [CardItem],
    /// Last row of its section: the gap between sections follows it.
    last: bool,
}

export struct ShortcutRow {
    id: string,
    label: string,
    combo: string,
    custom: bool,
    global: bool,
}

export struct RoleRow {
    id: string,
    label: string,
    color: color,
    hex: string,
    custom: bool,
}

export struct SmartRuleRow {
    field: string,
    op: string,
    value: string,
    hint: string,
}

export struct Choice {
    title: string,
    id: string,
}

export struct QueueRow {
    title: string,
    artist: string,
    manual: bool,
}

export struct LyricLine {
    text: string,
    active: bool,
}

export struct PresetTile {
    name: string,
    accent: color,
    bg: color,
}

export struct KeyValue {
    key: string,
    value: string,
}
