import { Theme } from "theme.slint";
import { Toggle, Button, Segmented, TextField, ColorPicker } from "widgets.slint";
import { PresetTile, ShortcutRow, RoleRow } from "types.slint";
import { ScrollView } from "std-widgets.slint";

/// Everything the settings page shows. Rust fills it from the core and handles
/// the callbacks; the page itself holds no logic.
export global SettingsState {
    in-out property <int> tab: 0;
    in-out property <string> status;

    // Appearance
    in-out property <[PresetTile]> presets;
    in-out property <string> theme-name;
    in-out property <color> accent-color: #A855F7;
    in-out property <color> bg-color: #130F1A;
    in-out property <string> accent-hex;
    in-out property <string> bg-hex;
    in-out property <int> picking: 0;
    // Browser (PKCE) sign-in: the only login TIDAL serves lossless / Max quality to.
    in-out property <bool> auth-max;
    in-out property <bool> pkce-pending;
    in-out property <string> pkce-input;
    in-out property <string> pkce-status;
    // The authorize address of the sign-in in progress (reopened / copied from the UI).
    in-out property <string> pkce-url;
    // General
    in-out property <bool> minimize-to-tray;
    in-out property <int> ui-scale-index;
    in-out property <int> suggest-index: 2;
    in-out property <int> bar-size-index: 1;
    in-out property <int> lyrics-size-index: 1;
    in-out property <bool> logging;
    // Playback
    in-out property <bool> normalization;
    in-out property <bool> gapless;
    in-out property <bool> gapless-supported: true;
    in-out property <int> crossfade-index: 0;
    in-out property <bool> crossfade-same-album: true;
    in-out property <bool> crossfade-blocked: false;
    in-out property <int> quality-index;
    in-out property <bool> exclusive;
    in-out property <bool> bit-perfect;
    in-out property <bool> show-alsa-options: true;
    in-out property <string> exclusive-hint: "Take over the audio device (ALSA).";
    in-out property <bool> global-shortcuts;
    in-out property <bool> check-updates;
    in-out property <bool> cover-colors;
    in-out property <bool> show-app-menu: false;
    in-out property <bool> in-app-menu: false;
    in-out property <string> global-shortcuts-hint;
    in-out property <[string]> devices;
    in-out property <int> device-index;
    // Scrobbling
    in-out property <bool> report-plays;
    in-out property <bool> lb-connected;
    in-out property <string> lb-user;
    in-out property <string> lb-token;
    in-out property <bool> lastfm-connected;
    in-out property <string> lastfm-user;
    in-out property <bool> librefm-connected;
    in-out property <string> librefm-user;
    in-out property <bool> audioscrobbler-pending;
    in-out property <bool> discord-rpc;
    in-out property <string> discord-text;
    in-out property <string> discord-details;
    in-out property <string> discord-state;
    in-out property <string> discord-preview;
    in-out property <bool> discord-hide-private;
    // Network
    in-out property <bool> proxy-enabled;
    in-out property <int> proxy-type-index;
    in-out property <string> proxy-host;
    in-out property <string> proxy-port;
    in-out property <string> proxy-user;
    in-out property <string> proxy-pass;
    // Integrations
    in-out property <bool> mcp-enabled;
    in-out property <string> mcp-url;
    in-out property <bool> overlay-enabled;
    in-out property <string> overlay-url;
    // Settings search
    in-out property <string> query;
    in-out property <[string]> search-results;
    in-out property <[int]> search-tabs;
    callback search-changed(string);
    // Agents (MCP)
    in-out property <bool> agent-read-only;
    in-out property <bool> agent-ask: true;
    in-out property <bool> agent-dj;
    in-out property <bool> agent-has-bearer;
    in-out property <[string]> agent-activity;
    in-out property <[int]> agent-activity-ids;
    // Custom themes
    in-out property <[string]> custom-themes;
    in-out property <string> custom-active;
    in-out property <bool> editing;
    in-out property <string> edit-name;
    in-out property <[RoleRow]> edit-roles;
    in-out property <string> edit-role: "accent";
    in-out property <color> edit-picker: #A855F7;
    in-out property <string> edit-warnings;
    callback agent-undo(int);
    callback edit-color(string, color);
    callback edit-hex(string, string);
    callback edit-name-changed(string);
    // Listening party
    in-out property <string> party-role;
    in-out property <string> party-link;
    in-out property <image> party-qr;
    in-out property <[string]> party-guests;
    in-out property <[string]> party-suggestions;
    in-out property <string> party-status;
    in-out property <string> party-ticket;
    in-out property <string> party-relay;
    in-out property <bool> party-allow-suggest: true;
    // Shortcuts
    in-out property <[ShortcutRow]> shortcut-rows;
    in-out property <string> capturing;
    in-out property <string> capture-warning;
    // About
    in-out property <string> version;

    callback changed-bool(string, bool);
    callback changed-int(string, int);
    callback changed-str(string, string);
    callback action(string);
    callback theme-preset(int);
    callback theme-color(int, color);
    callback theme-color-final(int, color);
    callback theme-hex(int, string);
}

component Row inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    min-height: 52px;
    HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.label; color: Theme.text; wrap: word-wrap; }
            if root.hint != "": Text { text: root.hint; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.surface-raised; }
}

export component SettingsPage inherits Rectangle {
    in property <bool> compact: false;
    background: Theme.background;
    property <[string]> tabs: ["General", "Appearance", "Playback", "Scrobbling", "Network", "Integrations", "Shortcuts", "Party", "About"];

    VerticalLayout {
        padding: root.compact ? 12px : 24px;
        spacing: 12px;
        Text { text: "Settings"; font-size: 30px; font-weight: 800; color: Theme.text; }
        ScrollView {
            height: 38px;
            content-height: 38px;
            Segmented {
                options: root.tabs;
                index <=> SettingsState.tab;
            }
        }
        TextField {
            text <=> SettingsState.query;
            placeholder: "Search settings";
            field-width: 320px;
            edited(t) => { SettingsState.search-changed(t); }
        }
        if SettingsState.query != "": VerticalLayout {
            spacing: 4px;
            if SettingsState.search-results.length == 0: Text { text: "No setting matches that."; color: Theme.text-muted; }
            for r[i] in SettingsState.search-results: Rectangle {
                height: 36px;
                border-radius: 6px;
                background: sr.has-hover ? Theme.surface-raised : Theme.surface;
                Text { x: 12px; text: r; color: Theme.text; vertical-alignment: center; }
                sr := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { SettingsState.tab = SettingsState.search-tabs[i]; SettingsState.query = ""; SettingsState.search-changed(""); } }
            }
        }
        if SettingsState.status != "": Rectangle {
            height: 30px;
            border-radius: 6px;
            background: Theme.surface-raised;
            Text { text: SettingsState.status; color: Theme.text; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                max-width: 760px;
                alignment: start;

                if SettingsState.tab == 0 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Streaming quality access";
                        hint: SettingsState.auth-max ? "Signed in with the browser login: Lossless and Max are available." : "This sign-in is limited to 320 kbps AAC. Sign in with your browser to unlock Lossless and Max.";
                        HorizontalLayout {
                            spacing: 8px;
                            if SettingsState.pkce-pending: TextField {
                                text <=> SettingsState.pkce-input;
                                placeholder: "Paste the page address";
                                field-width: 200px;
                            }
                            if SettingsState.pkce-pending: Button { label: "Open browser"; clicked => { SettingsState.action("pkce-open"); } }
                            if SettingsState.pkce-pending: Button { label: "Copy link"; clicked => { SettingsState.action("pkce-copy"); } }
                            if SettingsState.pkce-pending: Button { label: "Finish"; primary: true; clicked => { SettingsState.action("pkce-finish"); } }
                            if !SettingsState.auth-max && !SettingsState.pkce-pending: Button { label: "Sign in with browser"; primary: true; clicked => { SettingsState.action("pkce-start"); } }
                        }
                    }
                    if SettingsState.pkce-status != "": Text { text: SettingsState.pkce-status; color: Theme.text-muted; wrap: word-wrap; font-size: 12px; }
                    Row {
                        label: "Interface size";
                        hint: "Applies the next time Slate starts.";
                        Segmented {
                            options: ["Auto", "100%", "125%", "150%", "175%", "200%"];
                            index: SettingsState.ui-scale-index;
                            picked(i) => { SettingsState.ui-scale-index = i; SettingsState.changed-int("ui-scale", i); }
                        }
                    }
                    Row {
                        label: "Suggested tracks under playlists";
                        hint: "On playlists you own, shown when you scroll to the end of the list. Off never asks TIDAL.";
                        Segmented {
                            options: ["Off", "5", "10", "20"];
                            index: SettingsState.suggest-index;
                            picked(i) => { SettingsState.suggest-index = i; SettingsState.changed-int("suggest", i); }
                        }
                    }
                    Row {
                        label: "Player bar size";
                        hint: "Bigger buttons and text in the bar at the bottom.";
                        Segmented {
                            options: ["Small", "Normal", "Large", "Extra large"];
                            index: SettingsState.bar-size-index;
                            picked(i) => { SettingsState.bar-size-index = i; SettingsState.changed-int("bar-size", i); }
                        }
                    }
                    Row {
                        label: "Lyrics size";
                        Segmented {
                            options: ["Small", "Normal", "Large", "Extra large"];
                            index: SettingsState.lyrics-size-index;
                            picked(i) => { SettingsState.lyrics-size-index = i; SettingsState.changed-int("lyrics-size", i); }
                        }
                    }
                    Row {
                        label: "Close to tray";
                        hint: "Keep playing in the system tray when the window is closed.";
                        Toggle { checked: SettingsState.minimize-to-tray; toggled(v) => { SettingsState.minimize-to-tray = v; SettingsState.changed-bool("minimize-to-tray", v); } }
                    }
                    Row {
                        label: "Global shortcuts";
                        hint: "Work while another app has focus: " + SettingsState.global-shortcuts-hint + ". On Linux your desktop may ask you to confirm or change them (needs Slate installed with its desktop file).";
                        Toggle { checked: SettingsState.global-shortcuts; toggled(v) => { SettingsState.global-shortcuts = v; SettingsState.changed-bool("global-shortcuts", v); } }
                    }
                    Row {
                        label: "Colours from album art";
                        hint: "Tint the player bar and full-screen player with the cover's main colour.";
                        Toggle { checked: SettingsState.cover-colors; toggled(v) => { SettingsState.cover-colors = v; SettingsState.changed-bool("cover-colors", v); } }
                    }
                    Row {
                        label: "Check for updates";
                        hint: "Once a day, look for a newer Slate on GitHub and show a notice. Nothing is downloaded or installed.";
                        Toggle { checked: SettingsState.check-updates; toggled(v) => { SettingsState.check-updates = v; SettingsState.changed-bool("check-updates", v); } }
                    }
                    Row {
                        label: "Write log files";
                        hint: "Rotating logs in the Slate config folder.";
                        Toggle { checked: SettingsState.logging; toggled(v) => { SettingsState.logging = v; SettingsState.changed-bool("logging", v); } }
                    }
                    if SettingsState.show-app-menu: Row {
                        label: "App menu and panel icon";
                        hint: SettingsState.in-app-menu ? "Slate is in your app menu." : "Adds Slate to your app menu so panels show its icon and global shortcuts can work.";
                        if !SettingsState.in-app-menu: Button { label: "Add"; clicked => { SettingsState.action("app-menu-add"); } }
                        if SettingsState.in-app-menu: Button { label: "Remove"; clicked => { SettingsState.action("app-menu-remove"); } }
                    }
                    Row {
                        label: "Log folder";
                        Button { label: "Open"; clicked => { SettingsState.action("open-logs"); } }
                    }
                    Row {
                        label: "Image cache";
                        hint: "Cover art and metadata kept on disk.";
                        Button { label: "Clear"; clicked => { SettingsState.action("clear-cache"); } }
                    }
                }


                if SettingsState.tab == 1 && SettingsState.query == "": VerticalLayout {
                    spacing: 12px;
                    padding-top: 8px;
                    Text { text: "Theme: " + SettingsState.theme-name; color: Theme.text; font-weight: 700; }
                    Rectangle {
                        height: ceil(SettingsState.presets.length / 3) * 56px;
                        for p[i] in SettingsState.presets: Rectangle {
                            x: mod(i, 3) * (parent.width / 3);
                            y: floor(i / 3) * 56px;
                            width: parent.width / 3 - 8px;
                            height: 48px;
                            border-radius: 8px;
                            background: p.bg;
                            border-width: p.name == SettingsState.theme-name ? 2px : 1px;
                            border-color: p.name == SettingsState.theme-name ? p.accent : Theme.surface-raised;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                Rectangle { width: 20px; height: 20px; border-radius: 10px; background: p.accent; y: 4px; }
                                Text { text: p.name; color: p.bg.to-hsv().value > 0.5 ? #111111 : #ffffff; vertical-alignment: center; overflow: elide; }
                            }
                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { SettingsState.theme-preset(i); } }
                        }
                    }
                    Text { text: "Your themes"; color: Theme.text; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button { label: "New theme"; primary: true; clicked => { SettingsState.action("theme-new"); } }
                        Button { label: "Import…"; clicked => { SettingsState.action("theme-import"); } }
                    }
                    for n in SettingsState.custom-themes: Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: n == SettingsState.custom-active ? Theme.surface-raised : Theme.surface;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text { text: n; color: n == SettingsState.custom-active ? Theme.accent : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Button { label: "Use"; clicked => { SettingsState.action("theme-apply:" + n); } }
                            Button { label: "Edit"; clicked => { SettingsState.action("theme-edit:" + n); } }
                            Button { label: "Duplicate"; clicked => { SettingsState.action("theme-duplicate:" + n); } }
                            Button { label: "Export"; clicked => { SettingsState.action("theme-export:" + n); } }
                            Button { label: "Delete"; danger: true; clicked => { SettingsState.action("theme-delete:" + n); } }
                        }
                    }
                    if SettingsState.custom-themes.length == 0 && !SettingsState.editing: Text { text: "No saved themes yet. “New theme” starts from the colours you are using now."; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
                    if SettingsState.editing: Rectangle {
                        border-radius: 10px;
                        background: Theme.surface;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: "Edit theme (changes show live in the app)"; color: Theme.text; font-weight: 700; }
                            TextField {
                                text: SettingsState.edit-name;
                                placeholder: "Theme name";
                                field-width: 260px;
                                edited(t) => { SettingsState.edit-name-changed(t); }
                            }
                            for r in SettingsState.edit-roles: Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: r.id == SettingsState.edit-role ? Theme.surface-raised : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 10px;
                                    Rectangle { width: 22px; height: 22px; y: 7px; border-radius: 4px; background: r.color; border-width: 1px; border-color: Theme.text-muted; }
                                    Text { text: r.label; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: r.hex; color: Theme.text-muted; vertical-alignment: center; font-size: 12px; }
                                    if r.custom: Button { label: "Reset"; clicked => { SettingsState.action("theme-role-reset:" + r.id); } }
                                }
                                TouchArea { z: -1; mouse-cursor: MouseCursor.pointer; clicked => { SettingsState.action("theme-role:" + r.id); } }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;
                                ColorPicker {
                                    value: SettingsState.edit-picker;
                                    changed(c) => { SettingsState.edit-color(SettingsState.edit-role, c); }
                                    released(c) => { SettingsState.edit-color(SettingsState.edit-role, c); }
                                }
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    Text { text: "Selected colour"; color: Theme.text-muted; }
                                    TextField {
                                        placeholder: "#RRGGBB";
                                        field-width: 140px;
                                        accepted(t) => { SettingsState.edit-hex(SettingsState.edit-role, t); }
                                    }
                                    Text { text: "Press Enter to apply a hex value."; color: Theme.text-muted; font-size: 11px; }
                                }
                            }
                            if SettingsState.edit-warnings != "": Text { text: "⚠ " + SettingsState.edit-warnings; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Button { label: "Generate from album cover"; clicked => { SettingsState.action("theme-cover"); } }
                                Button { label: "Save"; primary: true; clicked => { SettingsState.action("theme-save"); } }
                                Button { label: "Cancel"; clicked => { SettingsState.action("theme-cancel"); } }
                            }
                        }
                    }
                    Text { text: "Custom colours"; color: Theme.text; font-weight: 700; }
                    Segmented {
                        options: ["Accent", "Background"];
                        index <=> SettingsState.picking;
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        ColorPicker {
                            value: SettingsState.picking == 0 ? SettingsState.accent-color : SettingsState.bg-color;
                            changed(c) => { SettingsState.theme-color(SettingsState.picking, c); }
                            released(c) => { SettingsState.theme-color-final(SettingsState.picking, c); }
                        }
                        VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            Text { text: SettingsState.picking == 0 ? "Accent" : "Background"; color: Theme.text-muted; }
                            TextField {
                                text: SettingsState.picking == 0 ? SettingsState.accent-hex : SettingsState.bg-hex;
                                placeholder: "#RRGGBB";
                                field-width: 140px;
                                accepted(t) => { SettingsState.theme-hex(SettingsState.picking, t); }
                            }
                            Text { text: "Press Enter to apply a hex value."; color: Theme.text-muted; font-size: 11px; }
                        }
                    }
                    Text {
                        text: "Themes are stored in theme.json and reload when the file changes.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                if SettingsState.tab == 2 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Maximum quality";
                        hint: "Slate falls back automatically when a track is not available at this level.";
                        Segmented {
                            options: ["Max", "Lossless", "High"];
                            index: SettingsState.quality-index;
                            picked(i) => { SettingsState.quality-index = i; SettingsState.changed-int("quality", i); }
                        }
                    }
                    Row {
                        label: "Volume normalization";
                        hint: "Level tracks using ReplayGain.";
                        Toggle { checked: SettingsState.normalization; toggled(v) => { SettingsState.normalization = v; SettingsState.changed-bool("normalization", v); } }
                    }
                    Row {
                        label: "Gapless playback";
                        hint: SettingsState.gapless-supported ? "Seamless transitions between tracks." : "Needs GStreamer 1.24 or newer.";
                        Toggle { enabled: SettingsState.gapless-supported; checked: SettingsState.gapless; toggled(v) => { SettingsState.gapless = v; SettingsState.changed-bool("gapless", v); } }
                    }
                    Row {
                        label: "Crossfade";
                        hint: SettingsState.crossfade-blocked ? "Crossfade is off while exclusive or bit-perfect output is on." : "Blend the end of a track into the next one. While two tracks mix, the signal path reads MODIFIED. Off keeps playback exactly as it was.";
                        Segmented {
                            options: ["Off", "2 s", "4 s", "6 s", "8 s", "10 s", "12 s"];
                            index: SettingsState.crossfade-index;
                            picked(i) => { SettingsState.crossfade-index = i; SettingsState.changed-int("crossfade", i); }
                        }
                    }
                    Row {
                        label: "Keep albums gapless";
                        hint: "Don't crossfade consecutive tracks from the same album.";
                        Toggle { checked: SettingsState.crossfade-same-album; toggled(v) => { SettingsState.crossfade-same-album = v; SettingsState.changed-bool("crossfade-same-album", v); } }
                    }
                    if SettingsState.show-alsa-options: Row {
                        label: "Exclusive mode";
                        hint: SettingsState.exclusive-hint;
                        Toggle { checked: SettingsState.exclusive; toggled(v) => { SettingsState.exclusive = v; SettingsState.changed-bool("exclusive", v); } }
                    }
                    if SettingsState.show-alsa-options: Row {
                        label: "Bit-perfect output";
                        hint: "Send the stream to the DAC unmodified. Disables volume control and normalization.";
                        Toggle { checked: SettingsState.bit-perfect; toggled(v) => { SettingsState.bit-perfect = v; SettingsState.changed-bool("bit-perfect", v); } }
                    }
                    if SettingsState.show-alsa-options && SettingsState.devices.length > 0: Row {
                        label: "Exclusive device";
                        Segmented {
                            options: SettingsState.devices;
                            index: SettingsState.device-index;
                            picked(i) => { SettingsState.device-index = i; SettingsState.changed-int("device", i); }
                        }
                    }
                }

                if SettingsState.tab == 3 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Report plays to TIDAL";
                        hint: "Feeds Recently Played and recommendations.";
                        Toggle { checked: SettingsState.report-plays; toggled(v) => { SettingsState.report-plays = v; SettingsState.changed-bool("report-plays", v); } }
                    }
                    Row {
                        label: "ListenBrainz";
                        hint: SettingsState.lb-connected ? "Connected as " + SettingsState.lb-user : "Paste your user token from listenbrainz.org/settings.";
                        HorizontalLayout {
                            spacing: 8px;
                            if !SettingsState.lb-connected: TextField {
                                text <=> SettingsState.lb-token;
                                placeholder: "User token";
                                secret: true;
                                field-width: 200px;
                            }
                            Button {
                                label: SettingsState.lb-connected ? "Disconnect" : "Connect";
                                danger: SettingsState.lb-connected;
                                clicked => { SettingsState.action(SettingsState.lb-connected ? "lb-disconnect" : "lb-connect"); }
                            }
                        }
                    }
                    Row {
                        label: "Last.fm";
                        hint: SettingsState.lastfm-connected ? "Connected as " + SettingsState.lastfm-user : "Approve Slate in your browser, then press Finish.";
                        HorizontalLayout {
                            spacing: 8px;
                            if !SettingsState.lastfm-connected && SettingsState.audioscrobbler-pending: Button { label: "Finish"; primary: true; clicked => { SettingsState.action("lastfm-finish"); } }
                            Button {
                                label: SettingsState.lastfm-connected ? "Disconnect" : "Connect";
                                danger: SettingsState.lastfm-connected;
                                clicked => { SettingsState.action(SettingsState.lastfm-connected ? "lastfm-disconnect" : "lastfm-connect"); }
                            }
                        }
                    }
                    Row {
                        label: "Libre.fm";
                        hint: SettingsState.librefm-connected ? "Connected as " + SettingsState.librefm-user : "Approve Slate in your browser, then press Finish.";
                        HorizontalLayout {
                            spacing: 8px;
                            if !SettingsState.librefm-connected && SettingsState.audioscrobbler-pending: Button { label: "Finish"; primary: true; clicked => { SettingsState.action("librefm-finish"); } }
                            Button {
                                label: SettingsState.librefm-connected ? "Disconnect" : "Connect";
                                danger: SettingsState.librefm-connected;
                                clicked => { SettingsState.action(SettingsState.librefm-connected ? "librefm-disconnect" : "librefm-connect"); }
                            }
                        }
                    }
                    Row {
                        label: "Discord Rich Presence";
                        Toggle { checked: SettingsState.discord-rpc; toggled(v) => { SettingsState.discord-rpc = v; SettingsState.changed-bool("discord-rpc", v); } }
                    }
                    Row {
                        label: "Discord status text";
                        hint: "Shown under the track name. Leave empty for the default.";
                        TextField {
                            text <=> SettingsState.discord-text;
                            placeholder: "Listening on Slate";
                            accepted(t) => { SettingsState.changed-str("discord-text", t); }
                        }
                    }
                    Row {
                        label: "Presence first line";
                        hint: "Placeholders: {title} {artist} {album} {quality} {playlist} {year}. Empty = {title}.";
                        TextField {
                            text <=> SettingsState.discord-details;
                            placeholder: "{title}";
                            field-width: 280px;
                            edited(t) => { SettingsState.changed-str("discord-details", t); }
                        }
                    }
                    Row {
                        label: "Presence second line";
                        hint: "Empty = by {artist} on {album}. Lines are cut at 128 characters.";
                        TextField {
                            text <=> SettingsState.discord-state;
                            placeholder: "by {artist} on {album}";
                            field-width: 280px;
                            edited(t) => { SettingsState.changed-str("discord-state", t); }
                        }
                    }
                    Row {
                        label: "Preview";
                        hint: "With an example track.";
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: SettingsState.discord-preview; color: Theme.text; width: 280px; wrap: word-wrap; }
                            Button { label: "Reset"; clicked => { SettingsState.action("discord-reset"); } }
                        }
                    }
                    Row {
                        label: "Hide presence for playlists that are not public";
                        hint: "Private and unlisted playlists never show on Discord. You can also hide a single playlist from its right-click menu.";
                        Toggle { checked: SettingsState.discord-hide-private; toggled(v) => { SettingsState.discord-hide-private = v; SettingsState.changed-bool("discord-hide-private", v); } }
                    }
                }

                if SettingsState.tab == 4 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Use a proxy";
                        hint: "All Slate traffic goes through it, or nothing is sent.";
                        Toggle { checked: SettingsState.proxy-enabled; toggled(v) => { SettingsState.proxy-enabled = v; } }
                    }
                    Row { label: "Type"; Segmented { options: ["HTTP", "SOCKS5"]; index <=> SettingsState.proxy-type-index; } }
                    Row { label: "Host"; TextField { text <=> SettingsState.proxy-host; placeholder: "proxy.example.com"; } }
                    Row { label: "Port"; TextField { text <=> SettingsState.proxy-port; placeholder: "8080"; field-width: 100px; } }
                    Row { label: "Username"; TextField { text <=> SettingsState.proxy-user; placeholder: "optional"; } }
                    Row { label: "Password"; TextField { text <=> SettingsState.proxy-pass; placeholder: "optional"; secret: true; } }
                    HorizontalLayout {
                        padding-top: 12px;
                        spacing: 8px;
                        Button { label: "Test"; clicked => { SettingsState.action("proxy-test"); } }
                        Button { label: "Save"; primary: true; clicked => { SettingsState.action("proxy-save"); } }
                    }
                }

                if SettingsState.tab == 5 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "MCP server";
                        hint: SettingsState.mcp-enabled ? SettingsState.mcp-url : "Lets AI assistants control playback. Local only (127.0.0.1:5577).";
                        Toggle { checked: SettingsState.mcp-enabled; toggled(v) => { SettingsState.mcp-enabled = v; SettingsState.changed-bool("mcp", v); } }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "Access token";
                        hint: SettingsState.agent-has-bearer ? "Clients must send it as “Authorization: Bearer …”; requests without it get 401." : "Optional. Without one, anything that knows the URL can connect.";
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: SettingsState.agent-has-bearer ? "Regenerate" : "Generate"; clicked => { SettingsState.action("agent-bearer-generate"); } }
                            if SettingsState.agent-has-bearer: Button { label: "Copy"; clicked => { SettingsState.action("agent-bearer-copy"); } }
                            if SettingsState.agent-has-bearer: Button { label: "Remove"; clicked => { SettingsState.action("agent-bearer-clear"); } }
                        }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "Read-only mode";
                        hint: "Hides and rejects every tool that changes anything.";
                        Toggle { checked: SettingsState.agent-read-only; toggled(v) => { SettingsState.agent-read-only = v; SettingsState.changed-bool("agent-read-only", v); } }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "Ask before destructive agent actions";
                        hint: "Deleting a playlist, clearing the queue, removing or reordering tracks: you allow each one. No answer in 60 s denies.";
                        Toggle { checked: SettingsState.agent-ask; toggled(v) => { SettingsState.agent-ask = v; SettingsState.changed-bool("agent-ask", v); } }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "Let an agent DJ";
                        hint: "When the queue runs out and an agent is listening for queue_low, wait up to 10 s for it to add tracks before the autoplay radio.";
                        Toggle { checked: SettingsState.agent-dj; toggled(v) => { SettingsState.agent-dj = v; SettingsState.changed-bool("agent-dj", v); } }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "Agent activity";
                        hint: SettingsState.agent-activity.length == 0 ? "Nothing yet. The last 500 changes an agent made are kept here." : "Newest first. Undo puts back queue, playlist and favourite changes.";
                        Button { label: "Refresh"; clicked => { SettingsState.action("agent-refresh"); } }
                    }
                    if SettingsState.mcp-enabled: VerticalLayout {
                        for line[i] in SettingsState.agent-activity: Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: line; color: Theme.text; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                Button { label: "Undo"; clicked => { SettingsState.agent-undo(SettingsState.agent-activity-ids[i]); } }
                            }
                        }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "MCP URL";
                        hint: "Copy it into your AI client. Regenerate makes a new one; old clients stop working.";
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: "Copy URL"; primary: true; clicked => { SettingsState.action("mcp-copy"); } }
                            Button { label: "Regenerate"; clicked => { SettingsState.action("mcp-regenerate"); } }
                        }
                    }
                    Row {
                        label: "OBS overlay";
                        hint: SettingsState.overlay-enabled ? SettingsState.overlay-url : "Now-playing browser source for streaming. Local only (127.0.0.1:5578).";
                        Toggle { checked: SettingsState.overlay-enabled; toggled(v) => { SettingsState.overlay-enabled = v; SettingsState.changed-bool("overlay", v); } }
                    }
                    if SettingsState.overlay-enabled: Row {
                        label: "Overlay URL";
                        hint: "Paste it into an OBS browser source.";
                        Button { label: "Copy URL"; clicked => { SettingsState.action("overlay-copy"); } }
                    }
                }

                if SettingsState.tab == 6 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Reset all shortcuts";
                        hint: "Click a shortcut to change it. Esc cancels while recording. Global shortcuts work system-wide when turned on in General.";
                        Button { label: "Reset all"; clicked => { SettingsState.action("shortcuts-reset-all"); } }
                    }
                    for s in SettingsState.shortcut-rows: Row {
                        label: s.label;
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: s.combo; min-width: 150px; clicked => { SettingsState.capture-warning = ""; SettingsState.action("shortcut-rebind:" + s.id); } }
                            if s.custom: Button { label: "Reset"; clicked => { SettingsState.action("shortcut-reset:" + s.id); } }
                        }
                    }
                }

                if SettingsState.tab == 7 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Listening party";
                        hint: SettingsState.party-role == "" ? "Listen together while each person plays from their own TIDAL account. Slate only syncs what is playing; no audio is sent. Needs no port forwarding." : (SettingsState.party-role == "host" ? "You are hosting. Guests: " + SettingsState.party-guests.length : "You are in a party.");
                        HorizontalLayout {
                            spacing: 8px;
                            if SettingsState.party-role == "": Button { label: "Start a party"; primary: true; clicked => { SettingsState.action("party-start"); } }
                            if SettingsState.party-role != "": Button { label: SettingsState.party-role == "host" ? "End party" : "Leave"; danger: true; clicked => { SettingsState.action("party-end"); } }
                        }
                    }
                    if SettingsState.party-status != "": Text { text: SettingsState.party-status; color: Theme.text-muted; wrap: word-wrap; font-size: 12px; }
                    if SettingsState.party-role == "": Row {
                        label: "Let guests suggest tracks";
                        hint: "Suggestions wait here for you to approve or deny.";
                        Toggle { checked: SettingsState.party-allow-suggest; toggled(v) => { SettingsState.party-allow-suggest = v; } }
                    }
                    if SettingsState.party-role == "": Row {
                        label: "Join a party";
                        hint: "Paste a slate://party/… link (opening one also fills this in).";
                        HorizontalLayout {
                            spacing: 8px;
                            TextField { text <=> SettingsState.party-ticket; placeholder: "slate://party/…"; field-width: 220px; }
                            Button { label: "Join"; primary: true; clicked => { SettingsState.action("party-join"); } }
                        }
                    }
                    if SettingsState.party-role == "": Row {
                        label: "Custom relay URL";
                        hint: "Optional: your own iroh-relay server. Leave empty for the default relays. Everyone must use the same one.";
                        TextField { text <=> SettingsState.party-relay; placeholder: "https://relay.example.com"; field-width: 260px; edited(t) => { SettingsState.changed-str("party-relay", t); } }
                    }
                    if SettingsState.party-role == "host": Row {
                        label: "Invite link";
                        hint: "Valid until you end the party.";
                        HorizontalLayout {
                            spacing: 12px;
                            Image { source: SettingsState.party-qr; width: 120px; height: 120px; image-rendering: pixelated; }
                            Button { label: "Copy link"; clicked => { SettingsState.action("party-copy"); } }
                        }
                    }
                    if SettingsState.party-role != "": Text { text: "In the party"; color: Theme.text; font-weight: 700; }
                    for g in SettingsState.party-guests: Rectangle {
                        height: 34px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: g; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                            if SettingsState.party-role == "host": Button { label: "Remove"; clicked => { SettingsState.action("party-kick:" + g); } }
                        }
                    }
                    for s[i] in SettingsState.party-suggestions: Rectangle {
                        height: 38px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: s; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Button { label: "Approve"; primary: true; clicked => { SettingsState.action("party-approve:" + i); } }
                            Button { label: "Deny"; clicked => { SettingsState.action("party-deny:" + i); } }
                        }
                    }
                }

                if SettingsState.tab == 8 && SettingsState.query == "": VerticalLayout {
                    spacing: 8px;
                    padding-top: 12px;
                    Text { text: "Slate " + SettingsState.version; font-size: 22px; font-weight: 700; color: Theme.text; }
                    Text { text: "A native, Rust + Slint TIDAL client."; color: Theme.text-muted; }
                    Text {
                        wrap: word-wrap;
                        text: "Slate is a fork and port of SONE by lullabyX (github.com/lullabyX/sone). All credit for the original design and backend goes to lullabyX and SONE's contributors. Licensed GPL-3.0-only.";
                        color: Theme.text-muted;
                    }
                }
            }
        }
    }
}
