import { Theme } from "theme.slint";
import { Toggle, Button, Segmented, TextField, ColorPicker } from "widgets.slint";
import { PresetTile, ShortcutRow, RoleRow, PartyRequest, PartyGuest, PartyState, EqBand } from "types.slint";
import { ScrollView } from "std-widgets.slint";

/// Everything the settings page shows. Rust fills it from the core and handles
/// the callbacks; the page itself holds no logic.
export global SettingsState {
    in-out property <int> tab: 0;
    in-out property <string> status;

    // Appearance
    in-out property <[PresetTile]> presets;
    in-out property <string> theme-name;
    in-out property <color> accent-color: #A855F7;
    in-out property <color> bg-color: #130F1A;
    in-out property <string> accent-hex;
    in-out property <string> bg-hex;
    in-out property <int> picking: 0;
    // Browser (PKCE) sign-in: the only login TIDAL serves lossless / Max quality to.
    in-out property <bool> auth-max;
    in-out property <bool> pkce-pending;
    in-out property <string> pkce-input;
    in-out property <string> pkce-status;
    // The authorize address of the sign-in in progress (reopened / copied from the UI).
    in-out property <string> pkce-url;
    // General
    in-out property <bool> minimize-to-tray;
    in-out property <int> ui-scale-index;
    in-out property <int> suggest-index: 2;
    in-out property <int> bar-size-index: 1;
    in-out property <int> lyrics-size-index: 1;
    in-out property <bool> logging;
    // Playback
    in-out property <bool> normalization;
    in-out property <bool> gapless;
    in-out property <bool> smart-shuffle;
    in-out property <int> shuffle-mode;
    in-out property <bool> hide-explicit;
    in-out property <bool> hide-ai;
    in-out property <bool> start-minimized;
    in-out property <bool> start-half-volume;
    in-out property <bool> device-memory;
    in-out property <int> reduce-motion-index: 0;
    in-out property <bool> alarm-enabled;
    in-out property <string> alarm-time: "07:00";
    in-out property <int> alarm-days: 127;
    in-out property <string> alarm-what: "the queue";
    in-out property <int> alarm-fade-index: 1;
    in-out property <int> alarm-volume-index: 1;
    in-out property <bool> alarm-keep-awake;
    in-out property <string> alarm-status;
    in-out property <bool> remember-window;
    in-out property <bool> gapless-supported: true;
    in-out property <int> crossfade-index: 0;
    in-out property <bool> crossfade-same-album: true;
    in-out property <bool> crossfade-blocked: false;
    in-out property <int> crossfeed-index: 0;
    in-out property <bool> crossfeed-available: false;
    in-out property <bool> crossfeed-blocked: false;
    in-out property <string> crossfeed-why: "";
    in-out property <int> quality-index;
    in-out property <bool> exclusive;
    in-out property <bool> bit-perfect;
    in-out property <bool> show-alsa-options: true;
    in-out property <string> exclusive-hint: "Take over the audio device (ALSA).";
    in-out property <bool> global-shortcuts;
    in-out property <bool> check-updates;
    in-out property <bool> cover-colors;
    in-out property <bool> show-app-menu: false;
    in-out property <bool> in-app-menu: false;
    in-out property <string> global-shortcuts-hint;
    in-out property <[string]> devices;
    in-out property <int> device-index;
    // DJ mixer
    in-out property <bool> dj-enabled;
    in-out property <string> dj-base-url;
    in-out property <string> dj-model;
    in-out property <string> dj-api-key;
    in-out property <int> dj-timeout-index: 2;
    in-out property <string> dj-direction;
    in-out property <string> dj-status;
    // Scrobbling
    in-out property <bool> report-plays;
    in-out property <bool> lb-connected;
    in-out property <string> lb-user;
    in-out property <string> lb-token;
    in-out property <bool> lastfm-connected;
    in-out property <string> lastfm-user;
    in-out property <bool> librefm-connected;
    in-out property <string> librefm-user;
    in-out property <bool> audioscrobbler-pending;
    in-out property <bool> discord-rpc;
    in-out property <string> discord-text;
    in-out property <string> discord-details;
    in-out property <string> discord-state;
    in-out property <string> discord-preview;
    in-out property <bool> discord-hide-private;
    // Network
    in-out property <bool> proxy-enabled;
    in-out property <int> proxy-type-index;
    in-out property <string> proxy-host;
    in-out property <string> proxy-port;
    in-out property <string> proxy-user;
    in-out property <string> proxy-pass;
    // Integrations
    in-out property <bool> mcp-enabled;
    in-out property <string> mcp-url;
    in-out property <bool> overlay-enabled;
    in-out property <string> overlay-url;
    in-out property <bool> mpd-enabled;
    in-out property <bool> mpd-lan;
    in-out property <string> mpd-address;
    in-out property <string> mpd-password;
    // Settings search
    in-out property <string> query;
    in-out property <[string]> search-results;
    in-out property <[int]> search-tabs;
    callback search-changed(string);
    // Agents (MCP)
    in-out property <bool> agent-read-only;
    in-out property <bool> agent-ask: true;
    in-out property <bool> agent-dj;
    in-out property <bool> agent-has-bearer;
    in-out property <[string]> agent-activity;
    in-out property <[int]> agent-activity-ids;
    // Custom themes
    in-out property <[string]> custom-themes;
    in-out property <string> custom-active;
    in-out property <bool> editing;
    in-out property <string> edit-name;
    in-out property <[RoleRow]> edit-roles;
    in-out property <string> edit-role: "accent";
    in-out property <color> edit-picker: #A855F7;
    in-out property <string> edit-warnings;
    callback agent-undo(int);
    callback edit-color(string, color);
    callback edit-hex(string, string);
    callback edit-name-changed(string);
    // Equalizer (Settings → Playback)
    in-out property <bool> eq-enabled;
    // Exclusive or bit-perfect output is on, so the equalizer cannot act.
    in-out property <bool> eq-blocked;
    in-out property <string> eq-preamp;
    in-out property <[EqBand]> eq-bands;
    in-out property <string> eq-status;
    // Listening party
    in-out property <string> party-role;
    // Tracks played while hosting, kept for "Save set as playlist".
    in-out property <int> party-set-count: 0;
    in-out property <string> party-link;
    in-out property <[PartyGuest]> party-guests;
    in-out property <string> party-chat-draft;
    in-out property <[PartyRequest]> party-requests;
    // Guests: the next tracks, with who asked for each.
    in-out property <[string]> party-upcoming;
    in-out property <string> party-status;
    in-out property <string> party-ticket;
    in-out property <string> party-relay;
    in-out property <string> party-name;
    // Host: what happens to a request (Approval / Auto-approve / Off), where an approved one
    // goes (Play next / Add to end / Fair queue), the per-guest cap and the vote-skip share.
    in-out property <int> party-mode: 0;
    in-out property <int> party-placement: 2;
    in-out property <int> party-cap-index: 2;
    in-out property <int> party-limit-index: 0;
    in-out property <bool> party-host-first: false;
    in-out property <bool> party-no-explicit;
    in-out property <int> party-vote-index: 0;
    // Guest: the host allows vote skip / this guest is a co-host.
    in-out property <bool> party-vote-available;
    in-out property <bool> party-cohost;
    // The host went away and this guest may take the party over.
    in-out property <bool> party-offer;
    // Shortcuts
    in-out property <[ShortcutRow]> shortcut-rows;
    in-out property <string> capturing;
    in-out property <string> capture-warning;
    // About
    in-out property <string> version;

    callback changed-bool(string, bool);
    callback changed-int(string, int);
    callback changed-str(string, string);
    callback action(string);
    callback theme-preset(int);
    callback theme-color(int, color);
    callback theme-color-final(int, color);
    callback theme-hex(int, string);
}

component Row inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    // The control sits on the right; when the row is too narrow to keep at least 200px for
    // the text beside it, it moves under the text. Placed by hand (not a layout) so the text
    // knows its width up front and the row grows to fit wrapped descriptions.
    property <length> ctl-w: min(ctl.preferred-width, root.width);
    property <bool> stacked: root.width - root.ctl-w - 16px < 200px;
    property <length> text-w: root.stacked ? root.width : root.width - root.ctl-w - 16px;
    property <length> text-h: texts.preferred-height;
    height: root.stacked
        ? root.text-h + ctl.preferred-height + 24px
        : max(52px, max(root.text-h, ctl.preferred-height) + 16px);
    texts := VerticalLayout {
        x: 0;
        y: root.stacked ? 8px : (root.height - root.text-h) / 2;
        width: root.text-w;
        height: root.text-h;
        Text { text: root.label; color: Theme.text; wrap: word-wrap; }
        if root.hint != "": Text { text: root.hint; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
    }
    ctl := VerticalLayout {
        x: root.stacked ? 0 : root.width - root.ctl-w;
        y: root.stacked ? root.text-h + 16px : (root.height - self.height) / 2;
        width: root.ctl-w;
        height: self.preferred-height;
        alignment: center;
        @children
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.surface-raised; }
}

export component SettingsPage inherits Rectangle {
    in property <bool> compact: false;
    background: Theme.background;
    property <[string]> tabs: ["General", "Appearance", "Playback", "Scrobbling", "Network", "Integrations", "Shortcuts", "Party", "About"];

    VerticalLayout {
        padding: root.compact ? 12px : 24px;
        spacing: 12px;
        Text { text: "Settings"; font-size: 30px; font-weight: 800; color: Theme.text; }
        tabs-sv := ScrollView {
            height: 38px;
            content-height: 38px;
            // Scrolls sideways when the tabs do not fit.
            content-width: max(self.visible-width, tabs-seg.preferred-width);
            tabs-seg := Segmented {
                // Spread over the whole bar, as in 1.1.0; never narrower than the labels.
                width: tabs-sv.content-width;
                options: root.tabs;
                index <=> SettingsState.tab;
            }
        }
        // Wrapped so its fixed width does not cap the width of the whole page.
        HorizontalLayout {
            alignment: start;
            TextField {
                text <=> SettingsState.query;
                placeholder: "Search settings";
                field-width: 320px;
                edited(t) => { SettingsState.search-changed(t); }
            }
        }
        // Scrolls on its own: a long list of matches must not make the page taller than the
        // window (it pushed the player bar off the bottom).
        if SettingsState.query != "": results-sv := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                x: 0;
                width: results-sv.visible-width - 14px;
                alignment: start;
                spacing: 4px;
                if SettingsState.search-results.length == 0: Text { text: "No setting matches that."; color: Theme.text-muted; }
                for r[i] in SettingsState.search-results: Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: sr.has-hover ? Theme.surface-raised : Theme.surface;
                    Text { x: 12px; text: r; color: Theme.text; vertical-alignment: center; }
                    sr := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { SettingsState.tab = SettingsState.search-tabs[i]; SettingsState.query = ""; SettingsState.search-changed(""); } }
                }
            }
        }
        if SettingsState.status != "": Rectangle {
            height: 30px;
            border-radius: 6px;
            background: Theme.surface-raised;
            Text { text: SettingsState.status; color: Theme.text; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
        }
        page := ScrollView {
            vertical-stretch: SettingsState.query == "" ? 1 : 0;
            VerticalLayout {
                // The full page width, as in 1.1.0, less room on the right for the scroll bar,
                // which floats over the content.
                x: 0;
                width: page.visible-width - 14px;
                alignment: start;

                if SettingsState.tab == 0 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Streaming quality access";
                        hint: SettingsState.auth-max ? "Signed in with the browser login: Lossless and Max are available." : "This sign-in is limited to 320 kbps AAC. Sign in with your browser to unlock Lossless and Max.";
                        HorizontalLayout {
                            spacing: 8px;
                            if SettingsState.pkce-pending: TextField {
                                text <=> SettingsState.pkce-input;
                                placeholder: "Paste the page address";
                                field-width: 200px;
                            }
                            if SettingsState.pkce-pending: Button { label: "Open browser"; clicked => { SettingsState.action("pkce-open"); } }
                            if SettingsState.pkce-pending: Button { label: "Copy link"; clicked => { SettingsState.action("pkce-copy"); } }
                            if SettingsState.pkce-pending: Button { label: "Finish"; primary: true; clicked => { SettingsState.action("pkce-finish"); } }
                            if !SettingsState.auth-max && !SettingsState.pkce-pending: Button { label: "Sign in with browser"; primary: true; clicked => { SettingsState.action("pkce-start"); } }
                        }
                    }
                    if SettingsState.pkce-status != "": Text { text: SettingsState.pkce-status; color: Theme.text-muted; wrap: word-wrap; font-size: 12px; }
                    Row {
                        label: "Interface size";
                        hint: "Applies the next time Slate starts.";
                        Segmented {
                            options: ["Auto", "100%", "125%", "150%", "175%", "200%"];
                            index: SettingsState.ui-scale-index;
                            picked(i) => { SettingsState.ui-scale-index = i; SettingsState.changed-int("ui-scale", i); }
                        }
                    }
                    Row {
                        label: "Suggested tracks under playlists";
                        hint: "On playlists you own, shown when you scroll to the end of the list. Off never asks TIDAL.";
                        Segmented {
                            options: ["Off", "5", "10", "20"];
                            index: SettingsState.suggest-index;
                            picked(i) => { SettingsState.suggest-index = i; SettingsState.changed-int("suggest", i); }
                        }
                    }
                    Row {
                        label: "Player bar size";
                        hint: "Bigger buttons and text in the bar at the bottom.";
                        Segmented {
                            options: ["Small", "Normal", "Large", "Extra large"];
                            index: SettingsState.bar-size-index;
                            picked(i) => { SettingsState.bar-size-index = i; SettingsState.changed-int("bar-size", i); }
                        }
                    }
                    Row {
                        label: "Lyrics size";
                        Segmented {
                            options: ["Small", "Normal", "Large", "Extra large"];
                            index: SettingsState.lyrics-size-index;
                            picked(i) => { SettingsState.lyrics-size-index = i; SettingsState.changed-int("lyrics-size", i); }
                        }
                    }
                    Row {
                        label: "Close to tray";
                        hint: "Keep playing in the system tray when the window is closed.";
                        Toggle { checked: SettingsState.minimize-to-tray; toggled(v) => { SettingsState.minimize-to-tray = v; SettingsState.changed-bool("minimize-to-tray", v); } }
                    }
                    Row {
                        label: "Start minimized to tray";
                        hint: "Open hidden in the system tray. The window opens normally if there is no tray.";
                        Toggle { checked: SettingsState.start-minimized; toggled(v) => { SettingsState.start-minimized = v; SettingsState.changed-bool("start-minimized", v); } }
                    }
                    Row {
                        label: "Start at half volume";
                        hint: "Every launch starts at 50 % instead of where you left it. Changing the volume afterwards works as usual.";
                        Toggle { checked: SettingsState.start-half-volume; toggled(v) => { SettingsState.start-half-volume = v; SettingsState.changed-bool("start-half-volume", v); } }
                    }
                    Row {
                        label: "Remember volume and equalizer per output device";
                        hint: "Each output device (headphones, speakers, a DAC) gets back the volume and equalizer it last had. Off by default and then nothing is read or written. The device is looked at when a track starts and when you pick an exclusive device, not continuously, so a device you plug in mid-track is noticed at the next track. Start at half volume still wins at launch. At most 50 devices, deleted at sign-out.";
                        Toggle { checked: SettingsState.device-memory; toggled(v) => { SettingsState.device-memory = v; SettingsState.changed-bool("device-memory", v); } }
                    }
                    Row {
                        label: "Remember window size and position";
                        hint: "Open the window and the mini player where you left them. On Wayland only the size and maximized state can be restored. Turning this off deletes the saved geometry.";
                        Toggle { checked: SettingsState.remember-window; toggled(v) => { SettingsState.remember-window = v; SettingsState.changed-bool("remember-window", v); } }
                    }
                    Row {
                        label: "Global shortcuts";
                        hint: "Work while another app has focus: " + SettingsState.global-shortcuts-hint + ". On Linux your desktop may ask you to confirm or change them (needs Slate installed with its desktop file).";
                        Toggle { checked: SettingsState.global-shortcuts; toggled(v) => { SettingsState.global-shortcuts = v; SettingsState.changed-bool("global-shortcuts", v); } }
                    }
                    Row {
                        label: "Colours from album art";
                        hint: "Tint the player bar and full-screen player with the cover's main colour.";
                        Toggle { checked: SettingsState.cover-colors; toggled(v) => { SettingsState.cover-colors = v; SettingsState.changed-bool("cover-colors", v); } }
                    }
                    Row {
                        label: "Check for updates";
                        hint: "Once a day, look for a newer Slate on GitHub and show a notice. Nothing is downloaded or installed.";
                        Toggle { checked: SettingsState.check-updates; toggled(v) => { SettingsState.check-updates = v; SettingsState.changed-bool("check-updates", v); } }
                    }
                    Row {
                        label: "Write log files";
                        hint: "Rotating logs in the Slate config folder.";
                        Toggle { checked: SettingsState.logging; toggled(v) => { SettingsState.logging = v; SettingsState.changed-bool("logging", v); } }
                    }
                    if SettingsState.show-app-menu: Row {
                        label: "App menu and panel icon";
                        hint: SettingsState.in-app-menu ? "Slate is in your app menu." : "Adds Slate to your app menu so panels show its icon and global shortcuts can work.";
                        if !SettingsState.in-app-menu: Button { label: "Add"; clicked => { SettingsState.action("app-menu-add"); } }
                        if SettingsState.in-app-menu: Button { label: "Remove"; clicked => { SettingsState.action("app-menu-remove"); } }
                    }
                    Row {
                        label: "Log folder";
                        Button { label: "Open"; clicked => { SettingsState.action("open-logs"); } }
                    }
                    Row {
                        label: "Personal data";
                        hint: "Lyrics timing offsets and tags in one file, to copy to another computer. Importing adds to what you have and removes nothing.";
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: "Export…"; clicked => { SettingsState.action("personal-export"); } }
                            Button { label: "Import…"; clicked => { SettingsState.action("personal-import"); } }
                        }
                    }
                    Row {
                        label: "Wake-up alarm";
                        hint: SettingsState.alarm-status + ". Off by default and then nothing runs. One timer, set to the next ring. An alarm that Slate or the computer slept through by more than 5 minutes is skipped with a notice. Snooze 10 minutes from the bar, or by pausing while it rings.";
                        Toggle { checked: SettingsState.alarm-enabled; toggled(v) => { SettingsState.alarm-enabled = v; SettingsState.changed-bool("alarm-enabled", v); } }
                    }
                    Row {
                        label: "Alarm time";
                        hint: "24-hour, like 07:30.";
                        TextField { text <=> SettingsState.alarm-time; placeholder: "07:30"; field-width: 90px; accepted(t) => { SettingsState.changed-str("alarm-time", t); } }
                    }
                    Row {
                        label: "Alarm days";
                        hint: "Click a day to switch it on or off; at least one stays on.";
                        HorizontalLayout {
                            spacing: 4px;
                            for d[i] in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Button {
                                label: d;
                                min-width: 44px;
                                primary: mod(floor(SettingsState.alarm-days / pow(2, i)), 2) == 1;
                                clicked => { SettingsState.changed-int("alarm-day", i); }
                            }
                        }
                    }
                    Row {
                        label: "Alarm plays";
                        hint: "Now: " + SettingsState.alarm-what + ". Paste a TIDAL playlist, album or mix link, or use what is playing now.";
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: "The queue"; clicked => { SettingsState.action("alarm-what-queue"); } }
                            Button { label: "What's playing"; clicked => { SettingsState.action("alarm-what-playing"); } }
                            TextField { placeholder: "Paste a link"; field-width: 180px; accepted(t) => { SettingsState.changed-str("alarm-what-link", t); } }
                        }
                    }
                    Row {
                        label: "Alarm fade-in";
                        hint: "From silence up to the alarm volume. Touching the volume ends the fade.";
                        Segmented {
                            options: ["30 s", "60 s", "90 s", "2 min"];
                            index: SettingsState.alarm-fade-index;
                            picked(i) => { SettingsState.alarm-fade-index = i; SettingsState.changed-int("alarm-fade", i); }
                        }
                    }
                    Row {
                        label: "Alarm volume";
                        hint: "The volume the fade-in reaches, and the volume you are left with.";
                        Segmented {
                            options: ["25 %", "50 %", "75 %", "100 %"];
                            index: SettingsState.alarm-volume-index;
                            picked(i) => { SettingsState.alarm-volume-index = i; SettingsState.changed-int("alarm-volume", i); }
                        }
                    }
                    Row {
                        label: "Keep the computer awake while the alarm is armed";
                        hint: "Off by default. Stops the computer sleeping, and the screen turning off, while an alarm is set; it also uses power. Without it, a sleeping computer misses the alarm.";
                        Toggle { checked: SettingsState.alarm-keep-awake; toggled(v) => { SettingsState.alarm-keep-awake = v; SettingsState.changed-bool("alarm-keep-awake", v); } }
                    }
                    Row {
                        label: "Import from Spotify or Apple Music";
                        hint: "Pick your Spotify export (YourLibrary.json, Playlist*.json), an Exportify CSV, an Apple Music Library.xml or Apple's privacy-export CSV; several files at once are fine. Tracks are matched by ISRC first, then title, artist and length (3 s). You see what matched, what is uncertain and what was not found before anything is created; playlists are then made unlisted. Up to 50 MB, 200 playlists, 20,000 tracks. Matching goes about three tracks a second and can be cancelled.";
                        Button { label: "Choose files…"; clicked => { SettingsState.action("service-import"); } }
                    }
                    Row {
                        label: "Image cache";
                        hint: "Cover art and metadata kept on disk.";
                        Button { label: "Clear"; clicked => { SettingsState.action("clear-cache"); } }
                    }
                }


                if SettingsState.tab == 1 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Reduce motion";
                        hint: "No slides, fades or animated lyrics: everything changes at once. Off keeps the animations; Follow system uses the desktop's own setting (GNOME's animations switch; asked only when you pick it and at start-up while it is chosen). Windows does not follow the system setting yet.";
                        Segmented {
                            options: ["Off", "On", "Follow system"];
                            index: SettingsState.reduce-motion-index;
                            picked(i) => { SettingsState.reduce-motion-index = i; SettingsState.changed-int("reduce-motion", i); }
                        }
                    }
                    spacing: 12px;
                    padding-top: 8px;
                    Text { text: "Theme: " + SettingsState.theme-name; color: Theme.text; font-weight: 700; }
                    Rectangle {
                        height: ceil(SettingsState.presets.length / 3) * 56px;
                        for p[i] in SettingsState.presets: Rectangle {
                            x: mod(i, 3) * (parent.width / 3);
                            y: floor(i / 3) * 56px;
                            width: parent.width / 3 - 8px;
                            height: 48px;
                            border-radius: 8px;
                            background: p.bg;
                            border-width: p.name == SettingsState.theme-name ? 2px : 1px;
                            border-color: p.name == SettingsState.theme-name ? p.accent : Theme.surface-raised;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                Rectangle { width: 20px; height: 20px; border-radius: 10px; background: p.accent; y: 4px; }
                                Text { text: p.name; color: p.bg.to-hsv().value > 0.5 ? #111111 : #ffffff; vertical-alignment: center; overflow: elide; }
                            }
                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { SettingsState.theme-preset(i); } }
                        }
                    }
                    Text { text: "Your themes"; color: Theme.text; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button { label: "New theme"; primary: true; clicked => { SettingsState.action("theme-new"); } }
                        Button { label: "Import…"; clicked => { SettingsState.action("theme-import"); } }
                    }
                    for n in SettingsState.custom-themes: Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: n == SettingsState.custom-active ? Theme.surface-raised : Theme.surface;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text { text: n; color: n == SettingsState.custom-active ? Theme.accent : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Button { label: "Use"; clicked => { SettingsState.action("theme-apply:" + n); } }
                            Button { label: "Edit"; clicked => { SettingsState.action("theme-edit:" + n); } }
                            Button { label: "Duplicate"; clicked => { SettingsState.action("theme-duplicate:" + n); } }
                            Button { label: "Export"; clicked => { SettingsState.action("theme-export:" + n); } }
                            Button { label: "Delete"; danger: true; clicked => { SettingsState.action("theme-delete:" + n); } }
                        }
                    }
                    if SettingsState.custom-themes.length == 0 && !SettingsState.editing: Text { text: "No saved themes yet. “New theme” starts from the colours you are using now."; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
                    if SettingsState.editing: Rectangle {
                        border-radius: 10px;
                        background: Theme.surface;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: "Edit theme (changes show live in the app)"; color: Theme.text; font-weight: 700; }
                            TextField {
                                text: SettingsState.edit-name;
                                placeholder: "Theme name";
                                field-width: 260px;
                                edited(t) => { SettingsState.edit-name-changed(t); }
                            }
                            for r in SettingsState.edit-roles: Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: r.id == SettingsState.edit-role ? Theme.surface-raised : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 10px;
                                    Rectangle { width: 22px; height: 22px; y: 7px; border-radius: 4px; background: r.color; border-width: 1px; border-color: Theme.text-muted; }
                                    Text { text: r.label; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: r.hex; color: Theme.text-muted; vertical-alignment: center; font-size: 12px; }
                                    if r.custom: Button { label: "Reset"; clicked => { SettingsState.action("theme-role-reset:" + r.id); } }
                                }
                                TouchArea { z: -1; mouse-cursor: MouseCursor.pointer; clicked => { SettingsState.action("theme-role:" + r.id); } }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;
                                ColorPicker {
                                    value: SettingsState.edit-picker;
                                    changed(c) => { SettingsState.edit-color(SettingsState.edit-role, c); }
                                    released(c) => { SettingsState.edit-color(SettingsState.edit-role, c); }
                                }
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    Text { text: "Selected colour"; color: Theme.text-muted; }
                                    TextField {
                                        placeholder: "#RRGGBB";
                                        field-width: 140px;
                                        accepted(t) => { SettingsState.edit-hex(SettingsState.edit-role, t); }
                                    }
                                    Text { text: "Press Enter to apply a hex value."; color: Theme.text-muted; font-size: 11px; }
                                }
                            }
                            if SettingsState.edit-warnings != "": Text { text: "⚠ " + SettingsState.edit-warnings; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Button { label: "Generate from album cover"; clicked => { SettingsState.action("theme-cover"); } }
                                Button { label: "Save"; primary: true; clicked => { SettingsState.action("theme-save"); } }
                                Button { label: "Cancel"; clicked => { SettingsState.action("theme-cancel"); } }
                            }
                        }
                    }
                    Text { text: "Custom colours"; color: Theme.text; font-weight: 700; }
                    Segmented {
                        options: ["Accent", "Background"];
                        index <=> SettingsState.picking;
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        ColorPicker {
                            value: SettingsState.picking == 0 ? SettingsState.accent-color : SettingsState.bg-color;
                            changed(c) => { SettingsState.theme-color(SettingsState.picking, c); }
                            released(c) => { SettingsState.theme-color-final(SettingsState.picking, c); }
                        }
                        VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            Text { text: SettingsState.picking == 0 ? "Accent" : "Background"; color: Theme.text-muted; }
                            TextField {
                                text: SettingsState.picking == 0 ? SettingsState.accent-hex : SettingsState.bg-hex;
                                placeholder: "#RRGGBB";
                                field-width: 140px;
                                accepted(t) => { SettingsState.theme-hex(SettingsState.picking, t); }
                            }
                            Text { text: "Press Enter to apply a hex value."; color: Theme.text-muted; font-size: 11px; }
                        }
                    }
                    Text {
                        text: "Themes are stored in theme.json and reload when the file changes.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                if SettingsState.tab == 2 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Maximum quality";
                        hint: "Slate falls back automatically when a track is not available at this level.";
                        Segmented {
                            options: ["Max", "Lossless", "High"];
                            index: SettingsState.quality-index;
                            picked(i) => { SettingsState.quality-index = i; SettingsState.changed-int("quality", i); }
                        }
                    }
                    Row {
                        label: "Volume normalization";
                        hint: "Level tracks using ReplayGain.";
                        Toggle { checked: SettingsState.normalization; toggled(v) => { SettingsState.normalization = v; SettingsState.changed-bool("normalization", v); } }
                    }
                    Row {
                        label: "Gapless playback";
                        hint: SettingsState.gapless-supported ? "Seamless transitions between tracks." : "Needs GStreamer 1.24 or newer.";
                        Toggle { enabled: SettingsState.gapless-supported; checked: SettingsState.gapless; toggled(v) => { SettingsState.gapless = v; SettingsState.changed-bool("gapless", v); } }
                    }
                    Row {
                        label: "Smarter shuffle";
                        hint: "Shuffle avoids the same artist, then the same album, twice in a row when it can. Off keeps the plain random shuffle.";
                        Toggle { checked: SettingsState.smart-shuffle; toggled(v) => { SettingsState.smart-shuffle = v; SettingsState.changed-bool("smart-shuffle", v); } }
                    }
                    Row {
                        label: "Shuffle mode";
                        hint: "Tracks shuffles single tracks. Albums shuffles whole albums and keeps each one in track order, so gapless playback and album ReplayGain stay intact. Also on the shuffle button's right-click menu.";
                        Segmented {
                            options: ["Tracks", "Albums"];
                            index: SettingsState.shuffle-mode;
                            picked(i) => { SettingsState.shuffle-mode = i; SettingsState.changed-int("shuffle-mode", i); }
                        }
                    }
                    Row {
                        label: "Hide explicit tracks";
                        hint: "Skip explicit tracks in the queue, autoplay, radio and the DJ. They stay in lists, dimmed. Off by default.";
                        Toggle { checked: SettingsState.hide-explicit; toggled(v) => { SettingsState.hide-explicit = v; SettingsState.changed-bool("hide-explicit", v); } }
                    }
                    Row {
                        label: "Hide AI-generated tracks";
                        hint: "The same for tracks TIDAL marks as AI-generated. Off by default.";
                        Toggle { checked: SettingsState.hide-ai; toggled(v) => { SettingsState.hide-ai = v; SettingsState.changed-bool("hide-ai", v); } }
                    }
                    Row {
                        label: "Crossfade";
                        hint: SettingsState.crossfade-blocked ? "Crossfade is off while exclusive or bit-perfect output is on." : "Blend the end of a track into the next one. While two tracks mix, the signal path reads MODIFIED. Off keeps playback exactly as it was.";
                        Segmented {
                            options: ["Off", "2 s", "4 s", "6 s", "8 s", "10 s", "12 s"];
                            index: SettingsState.crossfade-index;
                            picked(i) => { SettingsState.crossfade-index = i; SettingsState.changed-int("crossfade", i); }
                        }
                    }
                    Row {
                        label: "Headphone crossfeed";
                        hint: !SettingsState.crossfeed-available ? SettingsState.crossfeed-why : SettingsState.crossfeed-blocked ? "Crossfeed is off while exclusive or bit-perfect output is on, which must not alter the sound." : "Blends a little of each channel into the other, as speakers would, so headphone listening is less tiring. Off by default and then not in the audio path at all. While it is on the signal path reads MODIFIED. A level change applies at once; switching it on from Off applies from the next track.";
                        if SettingsState.crossfeed-available : Segmented {
                            enabled: !SettingsState.crossfeed-blocked;
                            options: ["Off", "Light", "Medium", "Strong"];
                            index: SettingsState.crossfeed-index;
                            picked(i) => { SettingsState.crossfeed-index = i; SettingsState.changed-int("crossfeed", i); }
                        }
                    }
                    Row {
                        label: "Keep albums gapless";
                        hint: "Don't crossfade consecutive tracks from the same album.";
                        Toggle { checked: SettingsState.crossfade-same-album; toggled(v) => { SettingsState.crossfade-same-album = v; SettingsState.changed-bool("crossfade-same-album", v); } }
                    }
                    Row {
                        label: "Equalizer";
                        hint: SettingsState.eq-blocked ? "The equalizer is off while exclusive or bit-perfect output is on, which must not alter the sound." : "Up to 10 bands plus a preamp. Off by default; with it off, playback is exactly as it was. While it is on the signal path reads MODIFIED. Switching it on or off applies from the next track; band changes apply at once.";
                        Toggle { checked: SettingsState.eq-enabled; toggled(v) => { SettingsState.eq-enabled = v; SettingsState.changed-bool("eq", v); } }
                    }
                    if SettingsState.eq-enabled: Row {
                        label: "Equalizer preset";
                        hint: "Import an AutoEq ParametricEQ.txt file for your headphones (autoeq.app). Slate ships no presets.";
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: "Import AutoEq file…"; primary: true; clicked => { SettingsState.action("eq-import"); } }
                            Button { label: "Add band"; enabled: SettingsState.eq-bands.length < 10; clicked => { SettingsState.action("eq-add"); } }
                            Button { label: "Reset"; clicked => { SettingsState.action("eq-reset"); } }
                        }
                    }
                    if SettingsState.eq-enabled: Row {
                        label: "Preamp (dB)";
                        hint: "Lower this if boosted bands make the sound distort. Press Enter to apply.";
                        TextField { text <=> SettingsState.eq-preamp; placeholder: "0.0"; field-width: 100px; accepted(t) => { SettingsState.changed-str("eq-preamp", t); } }
                    }
                    if SettingsState.eq-enabled && SettingsState.eq-status != "": Text { text: SettingsState.eq-status; color: Theme.text-muted; wrap: word-wrap; font-size: 12px; }
                    if SettingsState.eq-enabled: VerticalLayout {
                        spacing: 6px;
                        for b[i] in SettingsState.eq-bands: HorizontalLayout {
                            spacing: 8px;
                            Segmented {
                                options: ["Peak", "Low shelf", "High shelf"];
                                index: b.kind;
                                picked(k) => { SettingsState.action("eq-kind:" + i + ":" + k); }
                            }
                            TextField { text: b.freq; placeholder: "Hz"; field-width: 84px; accepted(t) => { SettingsState.changed-str("eq-freq:" + i, t); } }
                            TextField { text: b.gain; placeholder: "dB"; field-width: 72px; accepted(t) => { SettingsState.changed-str("eq-gain:" + i, t); } }
                            TextField { text: b.q; placeholder: "Q"; field-width: 64px; accepted(t) => { SettingsState.changed-str("eq-q:" + i, t); } }
                            Rectangle {
                                width: 44px;
                                Button { label: "✕"; width: 44px; danger: true; clicked => { SettingsState.action("eq-remove:" + i); } }
                            }
                        }
                        if SettingsState.eq-bands.length > 0: Text { text: "Frequency (Hz) · gain (dB) · Q. Press Enter in a field to apply."; color: Theme.text-muted; font-size: 11px; }
                    }
                    if SettingsState.show-alsa-options: Row {
                        label: "Exclusive mode";
                        hint: SettingsState.exclusive-hint;
                        Toggle { checked: SettingsState.exclusive; toggled(v) => { SettingsState.exclusive = v; SettingsState.changed-bool("exclusive", v); } }
                    }
                    if SettingsState.show-alsa-options: Row {
                        label: "Bit-perfect output";
                        hint: "Send the stream to the DAC unmodified. Disables volume control and normalization.";
                        Toggle { checked: SettingsState.bit-perfect; toggled(v) => { SettingsState.bit-perfect = v; SettingsState.changed-bool("bit-perfect", v); } }
                    }
                    if SettingsState.show-alsa-options && SettingsState.devices.length > 0: Row {
                        label: "Exclusive device";
                        Segmented {
                            options: SettingsState.devices;
                            index: SettingsState.device-index;
                            picked(i) => { SettingsState.device-index = i; SettingsState.changed-int("device", i); }
                        }
                    }
                    Row {
                        label: "DJ mixer";
                        hint: "When the queue runs dry, a model picks the next genre, finds tracks on TIDAL and keeps the music going. Point it at any OpenAI-compatible chat endpoint.";
                        Toggle { checked: SettingsState.dj-enabled; toggled(v) => { SettingsState.dj-enabled = v; SettingsState.changed-bool("dj-enabled", v); } }
                    }
                    if SettingsState.dj-enabled: Row {
                        label: "DJ endpoint";
                        hint: "OpenAI-compatible base URL.";
                        TextField { text: SettingsState.dj-base-url; placeholder: "https://api.openai.com/v1"; field-width: 260px; accepted(t) => { SettingsState.dj-base-url = t; SettingsState.changed-str("dj-base-url", t); } }
                    }
                    if SettingsState.dj-enabled: Row {
                        label: "DJ model";
                        hint: "Name of the chat model to ask.";
                        TextField { text: SettingsState.dj-model; placeholder: "gpt-4o-mini"; field-width: 220px; accepted(t) => { SettingsState.dj-model = t; SettingsState.changed-str("dj-model", t); } }
                    }
                    if SettingsState.dj-enabled: Row {
                        label: "DJ API key";
                        hint: "Leave blank if your endpoint needs no auth — but some endpoints reject requests without any Authorization header, in which case type any filler key.";
                        TextField { text: SettingsState.dj-api-key; placeholder: "sk-… (or a filler key)"; field-width: 280px; accepted(t) => { SettingsState.dj-api-key = t; SettingsState.changed-str("dj-api-key", t); } }
                    }
                    if SettingsState.dj-enabled: Row {
                        label: "DJ timeout";
                        hint: "How long to wait for the model's answer. A local model can be slow, especially while it loads — pick something comfortable and the test button will wait that long.";
                        Segmented {
                            options: ["1 min", "2 min", "5 min", "10 min", "15 min"];
                            index: SettingsState.dj-timeout-index;
                            picked(i) => { SettingsState.dj-timeout-index = i; SettingsState.changed-int("dj-timeout", i); }
                        }
                    }
                    Row {
                        label: "DJ direction";
                        hint: "Tell the DJ where to take it — “deeper into house” or “back to what I was hearing”. Applies to its next block.";
                        TextField { text <=> SettingsState.dj-direction; placeholder: "deeper into house"; field-width: 260px; }
                        Button { label: "Send"; clicked => { SettingsState.action("dj-go"); } }
                    }
                    if SettingsState.dj-enabled: Row {
                        label: "Now";
                        hint: "Force a new genre block immediately, without waiting for the queue to run dry.";
                        Button { label: "DJ up a block"; primary: true; clicked => { SettingsState.action("dj-now"); } }
                    }
                    if SettingsState.dj-enabled: Row {
                        label: "Connection";
                        hint: "Tests the endpoint the same way the DJ talks to it, with one tiny request.";
                        Text { text: SettingsState.dj-status == "" ? "Not tested yet" : SettingsState.dj-status; }
                        Button { label: "Test endpoint"; clicked => { SettingsState.action("dj-test"); } }
                    }
                }

                if SettingsState.tab == 3 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Report plays to TIDAL";
                        hint: "Feeds Recently Played and recommendations.";
                        Toggle { checked: SettingsState.report-plays; toggled(v) => { SettingsState.report-plays = v; SettingsState.changed-bool("report-plays", v); } }
                    }
                    Row {
                        label: "ListenBrainz";
                        hint: SettingsState.lb-connected ? "Connected as " + SettingsState.lb-user : "Paste your user token from listenbrainz.org/settings.";
                        HorizontalLayout {
                            spacing: 8px;
                            if !SettingsState.lb-connected: TextField {
                                text <=> SettingsState.lb-token;
                                placeholder: "User token";
                                secret: true;
                                field-width: 200px;
                            }
                            Button {
                                label: SettingsState.lb-connected ? "Disconnect" : "Connect";
                                danger: SettingsState.lb-connected;
                                clicked => { SettingsState.action(SettingsState.lb-connected ? "lb-disconnect" : "lb-connect"); }
                            }
                        }
                    }
                    Row {
                        label: "Last.fm";
                        hint: SettingsState.lastfm-connected ? "Connected as " + SettingsState.lastfm-user : "Approve Slate in your browser, then press Finish.";
                        HorizontalLayout {
                            spacing: 8px;
                            if !SettingsState.lastfm-connected && SettingsState.audioscrobbler-pending: Button { label: "Finish"; primary: true; clicked => { SettingsState.action("lastfm-finish"); } }
                            Button {
                                label: SettingsState.lastfm-connected ? "Disconnect" : "Connect";
                                danger: SettingsState.lastfm-connected;
                                clicked => { SettingsState.action(SettingsState.lastfm-connected ? "lastfm-disconnect" : "lastfm-connect"); }
                            }
                        }
                    }
                    Row {
                        label: "Libre.fm";
                        hint: SettingsState.librefm-connected ? "Connected as " + SettingsState.librefm-user : "Approve Slate in your browser, then press Finish.";
                        HorizontalLayout {
                            spacing: 8px;
                            if !SettingsState.librefm-connected && SettingsState.audioscrobbler-pending: Button { label: "Finish"; primary: true; clicked => { SettingsState.action("librefm-finish"); } }
                            Button {
                                label: SettingsState.librefm-connected ? "Disconnect" : "Connect";
                                danger: SettingsState.librefm-connected;
                                clicked => { SettingsState.action(SettingsState.librefm-connected ? "librefm-disconnect" : "librefm-connect"); }
                            }
                        }
                    }
                    Row {
                        label: "Discord Rich Presence";
                        Toggle { checked: SettingsState.discord-rpc; toggled(v) => { SettingsState.discord-rpc = v; SettingsState.changed-bool("discord-rpc", v); } }
                    }
                    Row {
                        label: "Discord status text";
                        hint: "Shown under the track name. Leave empty for the default.";
                        TextField {
                            text <=> SettingsState.discord-text;
                            placeholder: "Listening on Slate";
                            accepted(t) => { SettingsState.changed-str("discord-text", t); }
                        }
                    }
                    Row {
                        label: "Presence first line";
                        hint: "Placeholders: {title} {artist} {album} {quality} {playlist} {year}. Empty = {title}.";
                        TextField {
                            text <=> SettingsState.discord-details;
                            placeholder: "{title}";
                            field-width: 280px;
                            edited(t) => { SettingsState.changed-str("discord-details", t); }
                        }
                    }
                    Row {
                        label: "Presence second line";
                        hint: "Empty = by {artist} on {album}. Lines are cut at 128 characters.";
                        TextField {
                            text <=> SettingsState.discord-state;
                            placeholder: "by {artist} on {album}";
                            field-width: 280px;
                            edited(t) => { SettingsState.changed-str("discord-state", t); }
                        }
                    }
                    Row {
                        label: "Preview";
                        hint: "With an example track.";
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: SettingsState.discord-preview; color: Theme.text; width: 280px; wrap: word-wrap; }
                            Button { label: "Reset"; clicked => { SettingsState.action("discord-reset"); } }
                        }
                    }
                    Row {
                        label: "Hide presence for playlists that are not public";
                        hint: "Private and unlisted playlists never show on Discord. You can also hide a single playlist from its right-click menu.";
                        Toggle { checked: SettingsState.discord-hide-private; toggled(v) => { SettingsState.discord-hide-private = v; SettingsState.changed-bool("discord-hide-private", v); } }
                    }
                }

                if SettingsState.tab == 4 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Use a proxy";
                        hint: "All Slate traffic goes through it, or nothing is sent.";
                        Toggle { checked: SettingsState.proxy-enabled; toggled(v) => { SettingsState.proxy-enabled = v; } }
                    }
                    Row { label: "Type"; Segmented { options: ["HTTP", "SOCKS5"]; index <=> SettingsState.proxy-type-index; } }
                    Row { label: "Host"; TextField { text <=> SettingsState.proxy-host; placeholder: "proxy.example.com"; } }
                    Row { label: "Port"; TextField { text <=> SettingsState.proxy-port; placeholder: "8080"; field-width: 100px; } }
                    Row { label: "Username"; TextField { text <=> SettingsState.proxy-user; placeholder: "optional"; } }
                    Row { label: "Password"; TextField { text <=> SettingsState.proxy-pass; placeholder: "optional"; secret: true; } }
                    HorizontalLayout {
                        padding-top: 12px;
                        spacing: 8px;
                        Button { label: "Test"; clicked => { SettingsState.action("proxy-test"); } }
                        Button { label: "Save"; primary: true; clicked => { SettingsState.action("proxy-save"); } }
                    }
                }

                if SettingsState.tab == 5 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "MCP server";
                        hint: SettingsState.mcp-enabled ? SettingsState.mcp-url : "Lets AI assistants control playback. Local only (127.0.0.1:5577).";
                        Toggle { checked: SettingsState.mcp-enabled; toggled(v) => { SettingsState.mcp-enabled = v; SettingsState.changed-bool("mcp", v); } }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "Access token";
                        hint: SettingsState.agent-has-bearer ? "Clients must send it as “Authorization: Bearer …”; requests without it get 401." : "Optional. Without one, anything that knows the URL can connect.";
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: SettingsState.agent-has-bearer ? "Regenerate" : "Generate"; clicked => { SettingsState.action("agent-bearer-generate"); } }
                            if SettingsState.agent-has-bearer: Button { label: "Copy"; clicked => { SettingsState.action("agent-bearer-copy"); } }
                            if SettingsState.agent-has-bearer: Button { label: "Remove"; clicked => { SettingsState.action("agent-bearer-clear"); } }
                        }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "Read-only mode";
                        hint: "Hides and rejects every tool that changes anything.";
                        Toggle { checked: SettingsState.agent-read-only; toggled(v) => { SettingsState.agent-read-only = v; SettingsState.changed-bool("agent-read-only", v); } }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "Ask before destructive agent actions";
                        hint: "Deleting a playlist, clearing the queue, removing or reordering tracks: you allow each one. No answer in 60 s denies.";
                        Toggle { checked: SettingsState.agent-ask; toggled(v) => { SettingsState.agent-ask = v; SettingsState.changed-bool("agent-ask", v); } }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "Let an agent DJ";
                        hint: "When the queue runs out and an agent is listening for queue_low, wait up to 10 s for it to add tracks before the autoplay radio.";
                        Toggle { checked: SettingsState.agent-dj; toggled(v) => { SettingsState.agent-dj = v; SettingsState.changed-bool("agent-dj", v); } }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "Agent activity";
                        hint: SettingsState.agent-activity.length == 0 ? "Nothing yet. The last 500 changes an agent made are kept here." : "Newest first. Undo puts back queue, playlist and favourite changes.";
                        Button { label: "Refresh"; clicked => { SettingsState.action("agent-refresh"); } }
                    }
                    if SettingsState.mcp-enabled: VerticalLayout {
                        for line[i] in SettingsState.agent-activity: Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: line; color: Theme.text; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                Button { label: "Undo"; clicked => { SettingsState.agent-undo(SettingsState.agent-activity-ids[i]); } }
                            }
                        }
                    }
                    if SettingsState.mcp-enabled: Row {
                        label: "MCP URL";
                        hint: "Copy it into your AI client. Regenerate makes a new one; old clients stop working.";
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: "Copy URL"; primary: true; clicked => { SettingsState.action("mcp-copy"); } }
                            Button { label: "Regenerate"; clicked => { SettingsState.action("mcp-regenerate"); } }
                        }
                    }
                    Row {
                        label: "OBS overlay";
                        hint: SettingsState.overlay-enabled ? SettingsState.overlay-url : "Now-playing browser source for streaming. Local only (127.0.0.1:5578).";
                        Toggle { checked: SettingsState.overlay-enabled; toggled(v) => { SettingsState.overlay-enabled = v; SettingsState.changed-bool("overlay", v); } }
                    }
                    if SettingsState.overlay-enabled: Row {
                        label: "Overlay URL";
                        hint: "Paste it into an OBS browser source.";
                        Button { label: "Copy URL"; clicked => { SettingsState.action("overlay-copy"); } }
                    }
                    Row {
                        label: "MPD server";
                        hint: SettingsState.mpd-enabled ? ("Listening on " + SettingsState.mpd-address + ". Phone and desktop MPD clients can control Slate; see \"Phone remote (MPD)\" in the README.") : "Lets MPD clients (M.A.L.P., MaximumMPD, Rigelian, mpc) control Slate. Local only (127.0.0.1:6600) unless you allow the LAN. Off by default.";
                        Toggle { checked: SettingsState.mpd-enabled; toggled(v) => { SettingsState.mpd-enabled = v; SettingsState.changed-bool("mpd", v); } }
                    }
                    if SettingsState.mpd-enabled: Row {
                        label: "Allow LAN";
                        hint: "Listen on every network interface so a phone on your Wi-Fi can connect. A password is required, and anyone on the network who has it can control playback: use it on trusted networks only.";
                        Toggle { checked: SettingsState.mpd-lan; toggled(v) => { SettingsState.mpd-lan = v; SettingsState.changed-bool("mpd-lan", v); } }
                    }
                    if SettingsState.mpd-enabled && SettingsState.mpd-lan: Row {
                        label: "MPD password";
                        hint: SettingsState.mpd-password;
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: "Copy"; clicked => { SettingsState.action("mpd-copy-password"); } }
                            Button { label: "New password"; clicked => { SettingsState.action("mpd-new-password"); } }
                        }
                    }
                }

                if SettingsState.tab == 6 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Reset all shortcuts";
                        hint: "Click a shortcut to change it. Esc cancels while recording. Global shortcuts work system-wide when turned on in General.";
                        Button { label: "Reset all"; clicked => { SettingsState.action("shortcuts-reset-all"); } }
                    }
                    for s in SettingsState.shortcut-rows: Row {
                        label: s.label;
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: s.combo; min-width: 150px; clicked => { SettingsState.capture-warning = ""; SettingsState.action("shortcut-rebind:" + s.id); } }
                            if s.custom: Button { label: "Reset"; clicked => { SettingsState.action("shortcut-reset:" + s.id); } }
                        }
                    }
                }

                if SettingsState.tab == 7 && SettingsState.query == "": VerticalLayout {
                    Row {
                        label: "Listening party";
                        hint: SettingsState.party-role == "" ? "Listen together while each person plays from their own TIDAL account. Slate only syncs what is playing; no audio is sent. Needs no port forwarding." : (SettingsState.party-role == "host" ? "You are hosting. Guests: " + SettingsState.party-guests.length : "You are in a party.");
                        HorizontalLayout {
                            spacing: 8px;
                            if SettingsState.party-role == "": Button { label: "Start a party"; primary: true; clicked => { SettingsState.action("party-start"); } }
                            if SettingsState.party-role != "": Button { label: SettingsState.party-role == "host" ? "End party" : "Leave"; danger: true; clicked => { SettingsState.action("party-end"); } }
                        }
                    }
                    if SettingsState.party-role == "" && SettingsState.party-set-count > 0: Row {
                        label: "Last party's set";
                        hint: SettingsState.party-set-count + (SettingsState.party-set-count == 1 ? " track" : " tracks") + " played. Kept until the next party starts.";
                        Button { label: "Save set as playlist"; clicked => { SettingsState.action("party-save-set"); } }
                    }
                    if SettingsState.party-status != "": Text { text: SettingsState.party-status; color: Theme.text-muted; wrap: word-wrap; font-size: 12px; }
                    if SettingsState.party-offer: Row {
                        label: "The host left";
                        hint: "You are next in line. Take over to keep the party going; you get a new invite link to share.";
                        HorizontalLayout {
                            spacing: 8px;
                            Button { label: "Take over"; primary: true; clicked => { SettingsState.action("party-takeover"); } }
                            Button { label: "Not now"; clicked => { SettingsState.action("party-decline"); } }
                        }
                    }
                    if SettingsState.party-role != "guest": Row {
                        label: "Guest requests";
                        hint: "What happens when a guest sends you a track: wait for your approval, add it straight away, or don't take requests.";
                        Segmented {
                            options: ["Approval required", "Auto-approve", "Requests off"];
                            index: SettingsState.party-mode;
                            picked(i) => { SettingsState.party-mode = i; SettingsState.changed-int("party-mode", i); }
                        }
                    }
                    if SettingsState.party-role != "guest": Row {
                        label: "Approved requests go";
                        hint: "Fair queue takes turns between guests so nobody floods the queue. Remembered for next time.";
                        Segmented {
                            options: ["Play next", "Add to end", "Fair queue"];
                            index: SettingsState.party-placement;
                            picked(i) => { SettingsState.party-placement = i; SettingsState.changed-int("party-placement", i); }
                        }
                    }
                    if SettingsState.party-role != "guest": Row {
                        label: "Requests waiting per guest";
                        hint: "The most requests one guest can have waiting at once.";
                        Segmented {
                            options: ["1", "2", "3", "5", "10"];
                            index: SettingsState.party-cap-index;
                            picked(i) => { SettingsState.party-cap-index = i; SettingsState.changed-int("party-cap", i); }
                        }
                    }
                    if SettingsState.party-role != "guest": Row {
                        label: "Requests per guest";
                        hint: "The most requests one guest can make in the whole party. A request you turn down does not count. Off means no limit.";
                        Segmented {
                            options: ["Off", "1", "2", "3", "5", "10"];
                            index: SettingsState.party-limit-index;
                            picked(i) => { SettingsState.party-limit-index = i; SettingsState.changed-int("party-limit", i); }
                        }
                    }
                    if SettingsState.party-role != "guest": Row {
                        label: "My picks play first";
                        hint: "Tracks you queue yourself play before guests' requests, wherever the requests are placed.";
                        Toggle { checked: SettingsState.party-host-first; toggled(v) => { SettingsState.party-host-first = v; SettingsState.changed-bool("party-host-first", v); } }
                    }
                    if SettingsState.party-role != "guest": Row {
                        label: "No explicit tracks";
                        hint: "Turn down requests for tracks marked explicit.";
                        Toggle { checked: SettingsState.party-no-explicit; toggled(v) => { SettingsState.party-no-explicit = v; SettingsState.changed-bool("party-no-explicit", v); } }
                    }
                    if SettingsState.party-role != "guest": Row {
                        label: "Vote to skip";
                        hint: "Guests can vote to skip the current track. It passes when this share of the guests agree.";
                        Segmented {
                            options: ["Off", "25%", "50%", "75%"];
                            index: SettingsState.party-vote-index;
                            picked(i) => { SettingsState.party-vote-index = i; SettingsState.changed-int("party-vote", i); }
                        }
                    }
                    if SettingsState.party-role == "": Row {
                        label: "Join a party";
                        hint: "Paste a slate://party/… link (opening one also fills this in).";
                        HorizontalLayout {
                            spacing: 8px;
                            TextField { text <=> SettingsState.party-name; placeholder: "Your name"; field-width: 120px; edited(t) => { SettingsState.changed-str("party-name", t); } }
                            TextField { text <=> SettingsState.party-ticket; placeholder: "slate://party/…"; field-width: 220px; }
                            Button { label: "Join"; primary: true; clicked => { SettingsState.action("party-join"); } }
                        }
                    }
                    if SettingsState.party-role == "": Row {
                        label: "Custom relay URL";
                        hint: "Optional: your own iroh-relay server. Leave empty for the default relays. Everyone must use the same one.";
                        TextField { text <=> SettingsState.party-relay; placeholder: "https://relay.example.com"; field-width: 260px; edited(t) => { SettingsState.changed-str("party-relay", t); } }
                    }
                    if SettingsState.party-role == "host": Row {
                        label: "Invite link";
                        hint: "Valid until you end the party.";
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: SettingsState.party-link; color: Theme.text-muted; width: 220px; overflow: elide; vertical-alignment: center; }
                            Button { label: "Copy link"; clicked => { SettingsState.action("party-copy"); } }
                        }
                    }
                    if SettingsState.party-role == "guest" && SettingsState.party-vote-available: Row {
                        label: "Skip this track";
                        hint: "Counts as your vote; the host's setting decides how many are needed.";
                        Button { label: "Vote to skip"; clicked => { SettingsState.action("party-vote"); } }
                    }
                    if SettingsState.party-role != "": Text { text: "In the party"; color: Theme.text; font-weight: 700; }
                    for g in SettingsState.party-guests: Rectangle {
                        height: 34px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: g.cohost ? g.name + "  ·  co-host" : g.name; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                            if SettingsState.party-role == "host": Button { label: g.cohost ? "Remove co-host" : "Make co-host"; clicked => { SettingsState.action((g.cohost ? "party-uncohost:" : "party-cohost:") + g.name); } }
                            if SettingsState.party-role == "host": Button { label: g.muted ? "Unmute chat" : "Mute chat"; clicked => { SettingsState.action((g.muted ? "party-unmute:" : "party-mute:") + g.name); } }
                            if SettingsState.party-role == "host": Button { label: "Remove"; clicked => { SettingsState.action("party-kick:" + g.name); } }
                        }
                    }
                    if SettingsState.party-role != "": HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Chat (" + PartyState.chat-count + ")"; color: Theme.text; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        Button { label: PartyState.chat-open ? "Hide" : "Show"; clicked => { PartyState.chat-open = !PartyState.chat-open; } }
                    }
                    if SettingsState.party-role != "" && PartyState.chat-open: VerticalLayout {
                        spacing: 4px;
                        if PartyState.chat-count == 0: Text { text: "No messages yet. Messages live in memory only and are gone when the party ends."; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
                        for l in PartyState.chat-recent: Text { height: 22px; text: l; color: Theme.text; overflow: elide; vertical-alignment: center; }
                        HorizontalLayout {
                            spacing: 8px;
                            TextField { text <=> SettingsState.party-chat-draft; placeholder: "Say something (200 characters)"; field-width: 360px; accepted(t) => { SettingsState.action("party-chat-send"); } }
                            Button { label: "Send"; primary: true; clicked => { SettingsState.action("party-chat-send"); } }
                        }
                    }
                    if SettingsState.party-role == "host" || SettingsState.party-cohost: HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Requests (" + SettingsState.party-requests.length + ")"; color: Theme.text; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        if SettingsState.party-requests.length > 1: Button { label: "Approve all"; primary: true; clicked => { SettingsState.action("party-approve-all"); } }
                        if SettingsState.party-requests.length > 1: Button { label: "Deny all"; clicked => { SettingsState.action("party-deny-all"); } }
                    }
                    if (SettingsState.party-role == "host" || SettingsState.party-cohost) && SettingsState.party-requests.length == 0: Text { text: "No requests waiting."; color: Theme.text-muted; font-size: 12px; }
                    if SettingsState.party-role == "host" || SettingsState.party-cohost: VerticalLayout {
                        for r in SettingsState.party-requests: Rectangle {
                            height: 52px;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text { text: r.track; color: Theme.text; overflow: elide; }
                                    Text { text: r.guest + (r.quality != "" ? "  ·  " + r.quality : "") + (r.unavailable > 0 ? "  ·  unavailable for " + r.unavailable + (r.unavailable == 1 ? " guest" : " guests") : ""); color: r.unavailable > 0 ? Theme.danger : Theme.text-muted; font-size: 12px; overflow: elide; }
                                }
                                Button { label: "Approve"; primary: true; clicked => { SettingsState.action("party-approve:" + r.id); } }
                                Button { label: "Deny"; clicked => { SettingsState.action("party-deny:" + r.id); } }
                            }
                        }
                    }
                    if SettingsState.party-role == "guest": Text { text: "Up next"; color: Theme.text; font-weight: 700; }
                    if SettingsState.party-role == "guest" && SettingsState.party-upcoming.length == 0: Text { text: "Nothing queued yet."; color: Theme.text-muted; font-size: 12px; }
                    if SettingsState.party-role == "guest": VerticalLayout {
                        for u in SettingsState.party-upcoming: Text { text: u; color: Theme.text-muted; overflow: elide; height: 24px; vertical-alignment: center; }
                    }
                }

                if SettingsState.tab == 8 && SettingsState.query == "": VerticalLayout {
                    spacing: 8px;
                    padding-top: 12px;
                    Text { text: "Slate " + SettingsState.version; font-size: 22px; font-weight: 700; color: Theme.text; }
                    Text { text: "A native, Rust + Slint TIDAL client."; color: Theme.text-muted; }
                    Text {
                        wrap: word-wrap;
                        text: "Slate is a fork and port of SONE by lullabyX (github.com/lullabyX/sone). All credit for the original design and backend goes to lullabyX and SONE's contributors. Licensed GPL-3.0-only.";
                        color: Theme.text-muted;
                    }
                }
            }
        }
    }
}
